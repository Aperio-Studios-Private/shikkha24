# ─────────────────────────────────────────────────────────────────────────────
# Shikkha24 frontend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Astro only exposes variables prefixed `PUBLIC_` to the browser. Anything else
# stays build-time only (agent rule 11 — never put secrets in client-side code).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (canonical URL, sitemap, OG tags)
PUBLIC_SITE_URL=https://shikkha24.com

# Payload CMS origin — read at BUILD time to fetch content for static pages
CMS_URL=http://localhost:3000

# Media base URL.
#
# ⚠️ **Not R2.** The owner moved media to the DianaHost disk on 2026-09-12
# (`.sps/plan.md` §"Scope amendment (2026-09-12)" — the R2 fallback became the
# active architecture), so this points at the **CMS host**, not an R2 bucket.
#
# Serve it through the Cloudflare proxy with a long-lived `Cache-Control`: the
# free tier has unlimited bandwidth for proxied traffic, so cached image views
# cost the origin nothing and only cache misses hit the 200 GB host allowance.
PUBLIC_MEDIA_BASE_URL=https://cms.shikkha24.com

# Public origin of the CMS, as a BROWSER must reach it.
#
# Used by the opt-in islands that talk to the CMS directly — the live-blog
# "নতুন আপডেট" refresh, the poll vote, the comment form, the newsletter signup,
# the bookmark sync and the push subscription. Leave it EMPTY and those controls
# are simply not rendered, so an unconfigured deploy degrades to static content
# rather than showing a button that cannot work.
#
# In production this is the CMS's public hostname (the same one serving /admin),
# NOT an internal address. It must also appear in the Content-Security-Policy
# `connect-src` list in `public/_headers`, or the browser will block the request
# before it is sent.
PUBLIC_CMS_ORIGIN=

# ── Web Push (S9) ────────────────────────────────────────────────────────────
# The VAPID **public** key only. The matching private key lives in the CMS env
# and is never exposed here. Generate a pair once with:
#   npx web-push generate-vapid-keys
# Keys are self-generated and cost nothing — no account, no card.
#
# Leave empty and the "সময়সীমা মনে করান" reminder control is not rendered at all.
PUBLIC_VAPID_PUBLIC_KEY=

# ── Social login (S9) ────────────────────────────────────────────────────────
# Nothing to configure here. The frontend asks the CMS at build time which
# providers it can complete a login for (`GET /api/oauth/providers`), so the
# credentials live in exactly one place — `cms/.env`. Duplicating the client ids
# here would create a second source of truth that could drift into showing a
# button the CMS cannot honour.
#
# With no provider configured, the login control is not rendered at all and the
# browser-local bookmark/reminder fallback is what readers get.

# ── Feature flags (see docs/reliability.md §5) ───────────────────────────────
# Flags are public by design: they gate rendering, not access. Defaults live in
# `src/lib/feature-flags.ts`; these override them at build time.
PUBLIC_FLAG_WEATHER_WIDGET=true
PUBLIC_FLAG_PRAYER_WIDGET=true
# Defaults are ON — the approved scope is "ALL features Day 1", so a flag exists
# to switch a feature OFF in an emergency, not to opt into one. Setting any of
# these to exactly "false" removes that feature from the next build.
PUBLIC_FLAG_COMMENTS=true
PUBLIC_FLAG_LIVE_BLOG=true
PUBLIC_FLAG_QUIZ=true
PUBLIC_FLAG_POLL=true
PUBLIC_FLAG_NEWSLETTER=true
PUBLIC_FLAG_GALLERY=true
PUBLIC_FLAG_BOOKMARKS=true
PUBLIC_FLAG_PUSH=true
PUBLIC_FLAG_CITIZEN=true
PUBLIC_FLAG_SOCIAL_LOGIN=true
# Ad slots. ON — AdSense is activated, so ads ship. Flip to "false" to drop
# every slot from the next build if AdSense degrades (markup stays intact).
PUBLIC_FLAG_ADS=true
# Article audio reader (Web Speech API). Native, zero bytes — flagged so it can
# be switched off for a device class that misbehaves.
PUBLIC_FLAG_AUDIO_READER=true
# GPA / grade calculator (SSC/HSC). Client-side, no backend — flagged so it can
# be dropped from a build without touching the page routes.
PUBLIC_FLAG_GPA_CALCULATOR=true

# ── Widgets ──────────────────────────────────────────────────────────────────
# Hijri date correction in DAYS, applied to the Aladhan API's output.
#
# Default -2. Aladhan and the Bangladesh Islamic Foundation calendar disagree by
# two days; the owner chose to match the local printed calendar (a standing
# decision — see .sps/profile.md). Do not "fix" this to 0 without re-checking
# against the printed calendar.
PUBLIC_HIJRI_OFFSET_DAYS=-2
