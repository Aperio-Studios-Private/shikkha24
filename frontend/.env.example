# ─────────────────────────────────────────────────────────────────────────────
# Shikkha24 frontend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Astro only exposes variables prefixed `PUBLIC_` to the browser. Anything else
# stays build-time only (agent rule 11 — never put secrets in client-side code).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (canonical URL, sitemap, OG tags)
PUBLIC_SITE_URL=https://shikkha24.com

# Payload CMS origin — read at BUILD time to fetch content for static pages
CMS_URL=http://localhost:3000

# Cloudflare R2 public base URL for media (no credentials — public reads only)
PUBLIC_MEDIA_BASE_URL=

# ── Feature flags (see docs/reliability.md §5) ───────────────────────────────
# Flags are public by design: they gate rendering, not access. Defaults live in
# `src/lib/feature-flags.ts`; these override them at build time.
PUBLIC_FLAG_WEATHER_WIDGET=true
PUBLIC_FLAG_PRAYER_WIDGET=true
PUBLIC_FLAG_COMMENTS=false
PUBLIC_FLAG_LIVE_BLOG=false
PUBLIC_FLAG_QUIZ=false
PUBLIC_FLAG_NEWSLETTER=false
