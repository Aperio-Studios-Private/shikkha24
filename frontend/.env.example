# ─────────────────────────────────────────────────────────────────────────────
# Shikkha24 frontend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Astro only exposes variables prefixed `PUBLIC_` to the browser. Anything else
# stays build-time only (agent rule 11 — never put secrets in client-side code).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (canonical URL, sitemap, OG tags)
PUBLIC_SITE_URL=https://shikkha24.com

# Payload CMS origin — read at BUILD time to fetch content for static pages
CMS_URL=http://localhost:3000

# Cloudflare R2 public base URL for media (no credentials — public reads only)
PUBLIC_MEDIA_BASE_URL=

# Public origin of the CMS, as a BROWSER must reach it.
#
# Used by the two opt-in islands that talk to the CMS directly — the live-blog
# "নতুন আপডেট" refresh and the poll vote. Leave it EMPTY and those controls are
# simply not rendered, so an unconfigured deploy degrades to static content
# rather than showing a button that cannot work.
#
# In production this is the CMS's public hostname (the same one serving /admin),
# NOT an internal address. It must also appear in the Content-Security-Policy
# `connect-src` list in `public/_headers`, or the browser will block the request
# before it is sent.
PUBLIC_CMS_ORIGIN=

# ── Feature flags (see docs/reliability.md §5) ───────────────────────────────
# Flags are public by design: they gate rendering, not access. Defaults live in
# `src/lib/feature-flags.ts`; these override them at build time.
PUBLIC_FLAG_WEATHER_WIDGET=true
PUBLIC_FLAG_PRAYER_WIDGET=true
PUBLIC_FLAG_COMMENTS=false
# Defaults are ON — the approved scope is "ALL features Day 1", so a flag exists
# to switch a feature OFF in an emergency, not to opt into one. Setting any of
# these to exactly "false" removes that feature from the next build.
PUBLIC_FLAG_LIVE_BLOG=true
PUBLIC_FLAG_QUIZ=true
PUBLIC_FLAG_POLL=true
PUBLIC_FLAG_NEWSLETTER=false
