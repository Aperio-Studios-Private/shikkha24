---
/**
 * Dark / light mode toggle.
 *
 * **Light is the default; dark is strictly opt-in.** We no longer follow
 * `prefers-color-scheme` — a reader on a dark-mode phone was getting a dark
 * site they never asked for. Only a past explicit click turns dark on.
 *
 * Sets `.dark` on `<html>` so the `@custom-variant dark` in global.css picks it up.
 *
 * Why not `class="dark"` on `<body>`? Tailwind 4's `@custom-variant dark` uses
 * `:where(.dark, .dark *)` — it must be on the element itself or an ancestor.
 * `<html>` is the only ancestor that exists before JS runs, so the flash-of-wrong-theme
 * is minimised by an inline script in Layout.astro that runs before paint.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-12 w-12 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink dark:text-dark-ink-muted dark:hover:bg-dark-raised dark:hover:text-dark-ink"
  aria-label="থিম পরিবর্তন করুন"
  title="থিম পরিবর্তন করুন"
>
  {/* Sun icon — shown in dark mode (clicking switches to light) */}
  <svg
    id="theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  {/* Moon icon — shown in light mode (clicking switches to dark) */}
  <svg
    id="theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  (function () {
    const STORAGE_KEY = 'shikkha24-theme'
    const toggle = document.getElementById('theme-toggle')
    const sun = document.getElementById('theme-icon-sun')
    const moon = document.getElementById('theme-icon-moon')

    function getTheme(): 'dark' | 'light' {
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved === 'dark' || saved === 'light') return saved
      // Default light — deliberately not OS-derived.
      return 'light'
    }

    function applyTheme(theme: 'dark' | 'light') {
      const root = document.documentElement
      if (theme === 'dark') {
        root.classList.add('dark')
      } else {
        root.classList.remove('dark')
      }
      if (sun) sun.classList.toggle('hidden', theme !== 'dark')
      if (moon) moon.classList.toggle('hidden', theme !== 'light')
    }

    function toggleTheme() {
      const next = getTheme() === 'dark' ? 'light' : 'dark'
      localStorage.setItem(STORAGE_KEY, next)
      applyTheme(next)
    }

    // Sync on load (the inline script in Layout already set the class; this
    // just makes sure the icon matches in case of race conditions).
    applyTheme(getTheme())

    toggle?.addEventListener('click', toggleTheme)

    // No OS listener: the site no longer reacts to prefers-color-scheme.
    // Dark mode happens only when the reader asks for it.
  })()
</script>
