---

{
  links.length > 0 && variant === 'header' && (
    <div class="hidden items-center gap-1.5 border-l border-rule pl-2 lg:flex dark:border-dark-rule">
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 w-12 items-center justify-center rounded text-ink-subtle transition-colors hover:text-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
          aria-label={`${link.label}: অফিসিয়াল পাতা`}
          title={link.label}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICONS[link.platform]} />
          </svg>
        </a>
      ))}
    </div>
  )
}

{
  links.length > 0 && variant === 'drawer' && (
    <div class="border-t border-rule px-4 py-4 dark:border-dark-rule">
      <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
        সোশ্যাল মিডিয়া
      </h3>
      <div class="flex flex-wrap gap-2">
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center gap-2 rounded-md bg-surface-raised px-3 text-sm text-ink-muted dark:bg-dark-raised dark:text-dark-ink-muted"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={ICONS[link.platform]} />
            </svg>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  )
}

{
  links.length > 0 && variant === 'footer' && (
    <div class="mt-5">
      <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
        সোশ্যাল মিডিয়ায় আমরা
      </h3>
      <ul class="flex flex-wrap gap-2.5">
        {links.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-12 items-center gap-2 rounded-lg border border-rule bg-surface px-3 text-xs text-ink-muted transition-colors hover:border-brand-red hover:text-brand-red dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted dark:hover:border-brand-red dark:hover:text-brand-red"
              aria-label={`${link.label}: অফিসিয়াল পাতা`}
              title={link.label}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICONS[link.platform]} />
              </svg>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
