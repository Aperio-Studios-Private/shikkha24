---
/**
 * Official social accounts — the one place they are rendered.
 *
 * ## Self-hiding, by contract
 *
 * Renders **nothing** when the CMS has no usable URL (see `lib/social.ts` for
 * the validation). An icon row linking nowhere is worse than no icon row, and
 * this is the same rule the interactive islands follow: no control that cannot
 * work.
 *
 * ## Three variants, one data source
 *
 *   `header` — icon-only, in the utility ribbon. Desktop only (`lg:`); on mobile
 *              the same links appear in the drawer, so nothing is lost.
 *   `drawer` — labelled pills in the mobile menu, where there is room for words.
 *   `footer` — the "আমাদের অনুসরণ করুন" block: brand marks **with** Bengali
 *              labels, because a footer is where a reader looks to confirm which
 *              official accounts are the real ones.
 *
 * ## Why the icons are inline SVG and not an icon font
 *
 * Three brand marks is not worth a webfont, and a font is a third-party request
 * on a page with a 1.2 MB budget. `docs/performance-budget.md` also forbids a
 * render-blocking font fetch, and the strict CSP allows no external stylesheet.
 *
 * ⚠️ The marks are **decorative** (`aria-hidden`), with the accessible name
 * carried by the link itself. An `aria-label` of "facebook" — the raw field name
 * — is what the header used to emit; it is now the Bengali label.
 */
import { socialLinks } from '../lib/social'

interface Props {
  social: unknown
  variant?: 'header' | 'drawer' | 'footer'
}

const { social, variant = 'header' } = Astro.props
const links = socialLinks(social)

/** Brand marks, 24×24. Simple Icons paths (CC0). */
const ICONS: Record<string, string> = {
