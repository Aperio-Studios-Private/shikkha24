---
/**
 * Article card — the workhorse of every listing surface.
 *
 * Three variants:
 *   `lead`    — the homepage's primary story. Large stacked image, larger headline.
 *   `default` — the standard news card. Single row: image left, text right.
 *   `compact` — the dense list row. Same single-row shape, tighter type.
 *
 * ## ⚠️ The flex row belongs on the anchor, never on the outer <article>
 *
 * The image and the text block are *both* children of the `<a>` that wraps the
 * whole card, so the `<a>` is the element that lays them out. Declaring
 * `flex flex-row` on the outer `<article>` looks correct but does nothing: that
 * element has a single child (the anchor), and the anchor is `display: inline`,
 * so its block children simply stack. That is exactly why every card rendered
 * image-above-text regardless of which variant classes were applied. Keep the
 * row/column choice on the anchor.
 *
 * ## Zero CLS
 *
 * Every image reserves its box with `aspect-ratio` before load, and the text
 * block has a fixed line-clamp, so a card's height never changes after paint.
 * `docs/performance-budget.md` treats CLS as a hard gate, and cards are the
 * most repeated element on the page — a 1px shift here multiplies by 40.
 *
 * ## Why `line-clamp` and not `overflow: hidden`
 *
 * Bengali headlines run longer than Latin ones for the same information, so
 * truncation is a real design case, not an edge case. `line-clamp` truncates
 * with an ellipsis rather than slicing mid-glyph, which would break conjuncts.
 *
 * ## Why the row variants carry no standfirst
 *
 * A standfirst beside an 80px thumbnail competes with the headline for a very
 * narrow column and pushes the card's height around. The approved card
 * reference shows category, headline, rule, then date — so the excerpt is
 * reserved for the `lead`, where there is width to spend.
 */
import type { CmsArticle } from '../lib/cms'
import { getCategoryImage } from '../lib/images'
import { resolveCmsImage } from '../lib/media'
import { articleUrl } from '../lib/url'
import CategoryImage from './CategoryImage.astro'
import SponsoredLabel from './SponsoredLabel.astro'

interface Props {
  article: CmsArticle
  variant?: 'lead' | 'default' | 'compact'
  /** Only `lead` renders a standfirst by default; see the note above. */
  showExcerpt?: boolean
  showCategory?: boolean
  /** Render the headline as <h3> instead of <h2> when nested under a section. */
  headingLevel?: 2 | 3
}

const {
  article,
  variant = 'default',
  showExcerpt = variant === 'lead',
  showCategory = true,
  headingLevel = 2,
} = Astro.props

/**
 * The article's own photo, resolved from the CMS.
 *
 * `resolveCmsImage` supplies a real `srcset` from the WebP variants Payload
 * generated, plus the **true** width/height — which is what keeps the reserved
 * box honest. Hard-coding 1376×768 for every remote image reserves the wrong
 * box for any other aspect ratio, and a wrong box either letterboxes or shifts
 * layout.
 */
const photo = resolveCmsImage(article.featuredImage, article.title)

const category =
  article.category && typeof article.category === 'object' ? article.category : null

/**
 * Fallback to the category archetype when this article has no photo.
 *
 * An article with no image should not render an empty grey box — it should show
 * the image that represents its category. That is the whole point of the
 * archetype model in `docs/assets-prompt.md`.
 */
const categoryImage = getCategoryImage(category?.slug)

const href = articleUrl(article)

/** Bengali date. Resolved at build time, so no client-side locale work. */
const published = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString('bn-BD', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null

const Heading = headingLevel === 2 ? 'h2' : 'h3'

/** The hero is the only stacked variant; every other card is a single row. */
const isLead = variant === 'lead'

/**
 * The rule between headline and metadata.
 *
 * Only the standalone `default` card carries it. `compact` rows live inside
 * lists that already separate themselves with `divide-y`, so a second line
 * inside each row would read as a mistake rather than as structure.
 */
const showRule = variant === 'default'
---

<article
  class:list={[
    'group h-full rounded-lg border border-rule bg-surface transition-all duration-200 hover:border-ink/20 hover:shadow-sm dark:border-dark-rule dark:bg-dark-surface dark:hover:border-dark-ink/20',
    // The lead is a hero block — it earns more presence than the row cards.
    isLead && 'overflow-hidden',
  ]}
>
  <a
    href={href}
    class:list={[
      'no-underline flex h-full',
      isLead ? 'flex-col' : 'flex-row gap-3 p-3 sm:p-4',
    ]}
  >
    {
      /* Prefer the article's own photo; fall back to the category archetype.
         A card with neither renders as a text-only row, which is honest. */
      (photo || categoryImage) && (
        <div
          class:list={[
            'shrink-0 overflow-hidden bg-surface-raised dark:bg-dark-raised',
            // Lead: 16:9 (matches the source) and full-width, the hero image.
            // Row variants: a fixed square so the headline column keeps a
            // predictable width regardless of the source aspect ratio. 88px
            // (h-22) reads as a thumbnail, not a speck, and stays ≥48px touch.
            isLead
              ? 'aspect-16/9 w-full'
              : 'aspect-square h-20 w-20 sm:h-24 sm:w-24 rounded-md',
          ]}
        >
          {photo ? (
            <img
              src={photo.src}
              srcset={photo.srcset}
              sizes={isLead ? '(min-width: 1024px) 800px, 100vw' : '96px'}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading={isLead ? 'eager' : 'lazy'}
              fetchpriority={isLead ? 'high' : 'auto'}
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            categoryImage && (
              <CategoryImage
                image={categoryImage}
                alt={article.title}
                sizes={isLead ? '(min-width: 1024px) 800px, 100vw' : '96px'}
                widths={isLead ? [400, 800, 1200] : [96, 192]}
                priority={isLead}
                class="h-full w-full object-cover"
              />
            )
          )}
        </div>
      )
    }

    <div class:list={['flex min-w-0 flex-1 flex-col', isLead ? 'p-4 sm:p-5' : 'justify-center gap-2']}>
      {/* The category tag and the sponsored chip sit together above the
          headline: a reader scanning must see what section a story belongs to
          and whether it is paid for before they read a word of it. */}
      <div class="flex flex-wrap items-center gap-1.5">
        {
          showCategory && category?.nameBn && (
            <span class="rounded-sm bg-brand-red/10 px-1.5 py-0.5 text-xs font-semibold leading-none text-brand-red dark:bg-brand-red/15">
              {category.nameBn}
            </span>
          )
        }
        {article.isSponsored && <SponsoredLabel sponsorName={article.sponsorName} />}
      </div>

      <Heading
        class:list={[
          'font-headline font-bold text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red',
          isLead && 'text-2xl leading-tight sm:text-3xl lg:text-4xl',
          variant === 'default' && 'line-clamp-2 text-base leading-snug sm:text-lg',
          variant === 'compact' && 'line-clamp-2 text-base leading-snug',
        ]}
      >
        {article.title}
      </Heading>

      {
        showExcerpt && article.excerpt && (
          <p
            class:list={[
              'text-ink-muted dark:text-dark-ink-muted',
              isLead ? 'line-clamp-3 text-base sm:text-lg' : 'line-clamp-2 text-sm',
            ]}
          >
            {article.excerpt}
          </p>
        )
      }

      {/* Decorative: it separates headline from metadata, it is not a
          thematic break a screen reader should announce. Only the
          standalone `default` card carries it; `compact` rows live inside
          lists that separate themselves with `divide-y`. */}
      {showRule && <div class="my-1 border-t border-rule dark:border-dark-rule" aria-hidden="true" />}

      <div class:list={[
        'flex flex-wrap items-center text-ink-subtle dark:text-dark-ink-muted',
        isLead ? 'gap-x-3 gap-y-1 text-sm' : 'gap-x-2 text-xs',
      ]}>
        {published && <time datetime={article.publishedAt ?? undefined}>{published}</time>}
        {
          article.readingTimeMinutes ? (
            <>
              {published && <span aria-hidden="true">·</span>}
              <span>{article.readingTimeMinutes} মিনিট</span>
            </>
          ) : null
        }
        {article.isBreaking && (
          <span class="rounded bg-brand-red px-1.5 py-0.5 font-semibold leading-none text-white">ব্রেকিং</span>
        )}
      </div>
    </div>
  </a>
</article>
