---
/**
 * Article card — the workhorse of every listing surface.
 *
 * Four variants:
 *   `lead`    — the homepage masthead. Full-width hero: stacked 16:9 image,
 *               largest headline, standfirst.
 *   `feature` — a *section* lead. Also stacked, but sized for a half-column:
 *               the masthead's `lg:text-4xl` in a ~400px column fits about ten
 *               Bengali characters per line, so it needs its own scale rather
 *               than a borrowed one.
 *   `default` — the standard news card. Single row: image left, text right.
 *   `compact` — the dense list row. Same single-row shape, tighter type.
 *
 * ## ⚠️ The flex row belongs on the anchor, never on the outer <article>
 *
 * The image and the text block are *both* children of the `<a>` that wraps the
 * whole card, so the `<a>` is the element that lays them out. Declaring
 * `flex flex-row` on the outer `<article>` looks correct but does nothing: that
 * element has a single child (the anchor), and the anchor is `display: inline`,
 * so its block children simply stack. That is exactly why every card rendered
 * image-above-text regardless of which variant classes were applied. Keep the
 * row/column choice on the anchor.
 *
 * ## Zero CLS
 *
 * Every image reserves its box with `aspect-ratio` before load, and the text
 * block has a fixed line-clamp, so a card's height never changes after paint.
 * `docs/performance-budget.md` treats CLS as a hard gate, and cards are the
 * most repeated element on the page — a 1px shift here multiplies by 40.
 *
 * ## Why `line-clamp` and not `overflow: hidden`
 *
 * Bengali headlines run longer than Latin ones for the same information, so
 * truncation is a real design case, not an edge case. `line-clamp` truncates
 * with an ellipsis rather than slicing mid-glyph, which would break conjuncts.
 *
 * ## Why the row variants carry no standfirst
 *
 * A standfirst beside an 80px thumbnail competes with the headline for a very
 * narrow column and pushes the card's height around. The approved card
 * reference shows category, headline, rule, then date — so the excerpt is
 * reserved for the stacked variants, where there is width to spend.
 */
import type { CmsArticle } from '../lib/cms'
import { resolveCmsImage } from '../lib/media'
import { articleUrl } from '../lib/url'
import { formatBnBd, toBnDigits } from '../lib/bangla-date'
import CmsImage from './CmsImage.astro'
import ArticlePlaceholder from './ArticlePlaceholder.astro'
import SponsoredLabel from './SponsoredLabel.astro'

interface Props {
  article: CmsArticle
  variant?: 'lead' | 'feature' | 'default' | 'compact'
  /** Only the stacked variants render a standfirst by default; see above. */
  showExcerpt?: boolean
  showCategory?: boolean
  /** Render the headline as <h3> instead of <h2> when nested under a section. */
  headingLevel?: 2 | 3
  /**
   * `sizes` for the image, when the card's rendered width differs from what the
   * variant assumes.
   *
   * This is not cosmetic. `sizes` is what makes the browser choose a candidate
   * from the `srcset`, and an over-declared value silently downloads a larger
   * file than the slot can use — the `lead` default declares 800px, which is
   * correct in the masthead and 2× too big in a half-column section.
   */
  sizes?: string
}

const {
  article,
  variant = 'default',
  showExcerpt = variant === 'lead' || variant === 'feature',
  showCategory = true,
  headingLevel = 2,
  sizes,
} = Astro.props

/**
 * The article's own photo, resolved from the CMS.
 *
 * `resolveCmsImage` supplies the **true** width/height — which is what keeps the
 * reserved box honest. Hard-coding 1376×768 for every remote image reserves the
 * wrong box for any other aspect ratio, and a wrong box either letterboxes or
 * shifts layout.
 *
 * ⚠️ **Its `srcset` is always `undefined` in practice.** It is built from
 * `media.sizes`, and that is empty on every document this CMS has produced — the
 * host cannot fork a thread, so sharp cannot load there and no variants are
 * generated (T-07). `CmsImage` therefore re-encodes the remote source through
 * Astro instead of relying on a variant list that will never arrive.
 */
const photo = resolveCmsImage(article.featuredImage, article.title)

const category =
  article.category && typeof article.category === 'object' ? article.category : null

const href = articleUrl(article)

/** Bengali date. Resolved at build time, so no client-side locale work. */
const published = article.publishedAt
  ? formatBnBd(article.publishedAt, { day: 'numeric', month: 'long', year: 'numeric' })
  : null

const Heading = headingLevel === 2 ? 'h2' : 'h3'

/** Stacked variants put the image above the text; the rest are single rows. */
const isStacked = variant === 'lead' || variant === 'feature'
const isLead = variant === 'lead'

/**
 * The rule between headline and metadata.
 *
 * Only the standalone `default` card carries it. `compact` rows live inside
 * lists that already separate themselves with `divide-y`, so a second line
 * inside each row would read as a mistake rather than as structure.
 */
const showRule = variant === 'default'

/**
 * `sizes` for the image, unless the caller knows better.
 *
 * The stacked variants fill their column, so the value depends on the column,
 * not on the variant — which is why callers may override it. The `lead` default
 * (800px) is measured for the masthead; the same value in a half-column section
 * would have the browser fetch a candidate twice the size of the slot.
 */
const imageSizes = sizes ?? (isStacked ? '(min-width: 1024px) 800px, 100vw' : '96px')
---

<article
  class:list={[
    'group h-full rounded-lg border border-rule bg-surface transition-all duration-200 hover:border-ink/20 hover:shadow-sm dark:border-dark-rule dark:bg-dark-surface dark:hover:border-dark-ink/20',
    // A stacked card's image sits flush against the rounded border, so the
    // card has to clip it. Row cards inset their thumbnail and do not.
    isStacked && 'overflow-hidden',
  ]}
>
  <a
    href={href}
    class:list={[
      'no-underline flex h-full',
      isStacked ? 'flex-col' : 'flex-row gap-3 p-3 sm:p-4',
    ]}
  >
    {
      /* Owner rule changed 2026-10-18: an article without its own cover now
         renders the brand placeholder (white panel, centred logo) instead of a
         text-only card. The box is identical either way, so a reporter adding a
         photo later does not reflow the grid. */
      <div
        class:list={[
          'shrink-0 overflow-hidden bg-surface-raised dark:bg-dark-raised',
          // Stacked variants: 16:9 (matches the source) and full-width, so the
          // image carries the card. Row variants: a fixed square so the
          // headline column keeps a predictable width regardless of the source
          // aspect ratio. 88px (h-22) reads as a thumbnail, not a speck, and
          // stays ≥48px touch.
          isStacked
            ? 'aspect-16/9 w-full'
            : 'aspect-square h-20 w-20 sm:h-24 sm:w-24 rounded-md',
        ]}
      >
        {photo ? (
          <CmsImage
            src={photo.src}
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            sizes={imageSizes}
            // Only the masthead hero is reliably above the fold. A section
            // lead is lazy: there are eight of them down one page, and making
            // them all eager would fight the LCP the hero is trying to win.
            loading={isLead ? 'eager' : 'lazy'}
            fetchpriority={isLead ? 'high' : 'auto'}
            class="h-full w-full object-cover"
          />
        ) : (
          <ArticlePlaceholder class="h-full w-full" markHeight={isStacked ? 56 : 32} />
        )}
      </div>
    }

    <div class:list={['flex min-w-0 flex-1 flex-col', isStacked ? 'p-4 sm:p-5' : 'justify-center gap-2']}>
      {/* The category tag and the sponsored chip sit together above the
          headline: a reader scanning must see what section a story belongs to
          and whether it is paid for before they read a word of it. */}
      <div class="flex flex-wrap items-center gap-1.5">
        {
          showCategory && category?.nameBn && (
            <span class="rounded-sm bg-brand-red/10 px-1.5 py-0.5 text-xs font-semibold leading-none text-brand-red-on-tint dark:text-brand-red-on-tint-dark dark:bg-brand-red/15">
              {category.nameBn}
            </span>
          )
        }
        {article.isSponsored && <SponsoredLabel sponsorName={article.sponsorName} />}
      </div>

      <Heading
        class:list={[
          'font-headline font-bold text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red',
          isLead && 'text-2xl leading-tight sm:text-3xl lg:text-4xl',
          // A section lead gets its own scale rather than the masthead's. In a
          // ~400px half-column, `lg:text-4xl` fits roughly ten Bengali
          // characters per line — a headline that breaks every second word.
          variant === 'feature' && 'line-clamp-3 text-xl leading-tight sm:text-2xl',
          variant === 'default' && 'line-clamp-2 text-base leading-snug sm:text-lg',
          variant === 'compact' && 'line-clamp-2 text-base leading-snug',
        ]}
      >
        {article.title}
      </Heading>

      {
        showExcerpt && article.excerpt && (
          <p
            class:list={[
              'text-ink-muted dark:text-dark-ink-muted',
              isLead ? 'line-clamp-3 text-base sm:text-lg' : 'line-clamp-2 text-sm',
            ]}
          >
            {article.excerpt}
          </p>
        )
      }

      {/* Decorative: it separates headline from metadata, it is not a
          thematic break a screen reader should announce. Only the
          standalone `default` card carries it; `compact` rows live inside
          lists that separate themselves with `divide-y`. */}
      {showRule && <div class="my-1 border-t border-rule dark:border-dark-rule" aria-hidden="true" />}

      <div class:list={[
        'flex flex-wrap items-center text-ink-subtle dark:text-dark-ink-muted',
        isLead ? 'gap-x-3 gap-y-1 text-sm' : 'gap-x-2 text-xs',
        // A stacked card stretches to its column's height so a section's two
        // columns end level. Pinning the metadata to the bottom keeps the card
        // looking deliberate at any height rather than trailing off mid-air.
        isStacked && 'mt-auto pt-3',
      ]}>
        {published && <time datetime={article.publishedAt ?? undefined}>{published}</time>}
        {
          article.readingTimeMinutes ? (
            <>
              {published && <span aria-hidden="true">·</span>}
              <span>{toBnDigits(article.readingTimeMinutes)} মিনিট</span>
            </>
          ) : null
        }
        {article.isBreaking && (
          <span class="rounded bg-brand-red px-1.5 py-0.5 font-semibold leading-none text-white">ব্রেকিং</span>
        )}
      </div>
    </div>
  </a>
</article>
