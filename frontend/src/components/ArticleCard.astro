---
/**
 * Article card — the workhorse of every listing surface.
 *
 * Three variants:
 *   `lead`    — the homepage's primary story. Large image, larger headline.
 *   `default` — grid card used in category sections.
 *   `compact` — dense list row used for "latest" and sidebars.
 *
 * ## Zero CLS
 *
 * Every image reserves its box with `aspect-ratio` before load, and the text
 * block has a fixed line-clamp, so a card's height never changes after paint.
 * `docs/performance-budget.md` treats CLS as a hard gate, and cards are the
 * most repeated element on the page — a 1px shift here multiplies by 40.
 *
 * ## Why `line-clamp` and not `overflow: hidden`
 *
 * Bengali headlines run longer than Latin ones for the same information, so
 * truncation is a real design case, not an edge case. `line-clamp` truncates
 * with an ellipsis rather than slicing mid-glyph, which would break conjuncts.
 */
import type { CmsArticle } from '../lib/cms'
import { getCategoryImage } from '../lib/images'
import CategoryImage from './CategoryImage.astro'

interface Props {
  article: CmsArticle
  variant?: 'lead' | 'default' | 'compact'
  showExcerpt?: boolean
  showCategory?: boolean
  /** Render the headline as <h3> instead of <h2> when nested under a section. */
  headingLevel?: 2 | 3
}

const {
  article,
  variant = 'default',
  showExcerpt = variant !== 'compact',
  showCategory = true,
  headingLevel = 2,
} = Astro.props

const mediaBase = import.meta.env.PUBLIC_MEDIA_BASE_URL || ''

/** `featuredImage` is a relation — an object when populated, an id when not. */
const image =
  article.featuredImage && typeof article.featuredImage === 'object'
    ? article.featuredImage
    : null
const imageUrl = image?.url
  ? image.url.startsWith('http')
    ? image.url
    : `${mediaBase}${image.url}`
  : null

const category =
  article.category && typeof article.category === 'object' ? article.category : null

/**
 * Fallback to the category archetype when this article has no photo.
 *
 * An article with no image should not render an empty grey box — it should show
 * the image that represents its category. That is the whole point of the
 * archetype model in `docs/assets-prompt.md`.
 */
const categoryImage = getCategoryImage(category?.slug)

const href = `/article/${article.slug}`

/** Bengali date. Resolved at build time, so no client-side locale work. */
const published = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString('bn-BD', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null

const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<article class:list={['group', variant === 'compact' ? 'flex gap-3' : 'flex flex-col']}>
  <a href={href} class="no-underline">
    {
      /* Prefer the article's own photo; fall back to the category archetype. */
      (imageUrl || categoryImage) &&
        variant !== 'compact' && (
          <div
            class:list={[
              'relative mb-3 overflow-hidden rounded-md bg-surface-raised dark:bg-dark-raised',
              variant === 'lead' ? 'aspect-16/10' : 'aspect-3/2',
            ]}
          >
            {imageUrl ? (
              <img
                src={imageUrl}
                alt={image?.alt || article.title}
                width="1376"
                height="768"
                loading={variant === 'lead' ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
            ) : (
              categoryImage && (
                <CategoryImage
                  image={categoryImage}
                  alt={article.title}
                  sizes={
                    variant === 'lead'
                      ? '(min-width: 1024px) 800px, 100vw'
                      : '(min-width: 1024px) 600px, 100vw'
                  }
                  widths={[400, 800, 1200]}
                  priority={variant === 'lead'}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              )
            )}
          </div>
        )
    }

    {
      (imageUrl || categoryImage) &&
        variant === 'compact' && (
          <div class="aspect-1 h-20 w-20 shrink-0 overflow-hidden rounded bg-surface-raised dark:bg-dark-raised">
            {imageUrl ? (
              <img
                src={imageUrl}
                alt={image?.alt || article.title}
                width="80"
                height="80"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              categoryImage && (
                <CategoryImage
                  image={categoryImage}
                  alt={article.title}
                  sizes="80px"
                  widths={[80, 160]}
                  class="h-full w-full object-cover"
                />
              )
            )}
          </div>
        )
    }

    <div class="flex min-w-0 flex-col gap-1.5">
      {
        showCategory && category?.nameBn && (
          <span class="text-xs font-semibold text-brand-red">{category.nameBn}</span>
        )
      }

      <Heading
        class:list={[
          'font-headline font-bold text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red',
          variant === 'lead' && 'text-2xl sm:text-3xl lg:text-4xl',
          variant === 'default' && 'line-clamp-3 text-lg sm:text-xl',
          variant === 'compact' && 'line-clamp-2 text-base',
        ]}
      >
        {article.title}
      </Heading>

      {
        showExcerpt && article.excerpt && (
          <p
            class:list={[
              'text-ink-muted dark:text-dark-ink-muted',
              variant === 'lead' ? 'line-clamp-3 text-base sm:text-lg' : 'line-clamp-2 text-sm',
            ]}
          >
            {article.excerpt}
          </p>
        )
      }

      <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-subtle dark:text-dark-ink-muted">
        {published && <time datetime={article.publishedAt ?? undefined}>{published}</time>}
        {
          article.readingTimeMinutes ? (
            <>
              {published && <span aria-hidden="true">·</span>}
              <span>{article.readingTimeMinutes} মিনিট</span>
            </>
          ) : null
        }
        {article.isBreaking && (
          <span class="rounded bg-brand-red px-1.5 py-0.5 font-semibold text-white">ব্রেকিং</span>
        )}
      </div>
    </div>
  </a>
</article>
