---
/**
 * Latest feed — strictly chronological, newest first.
 *
 * The counterweight to TrendingList: trending answers "what is everyone
 * reading", this answers "what just happened". On result and circular days the
 * latest feed is the faster-moving of the two, which is why it sits in the main
 * column rather than the sidebar.
 *
 * Shows the clock time, not just the date — on a 40-article burst day the date
 * alone cannot distinguish "just published" from "this morning".
 */
import type { CmsArticle } from '../lib/cms'

interface Props {
  articles: CmsArticle[]
  title?: string
}

const { articles, title = 'সর্বশেষ' } = Astro.props

const items = articles.slice(0, 12)

function timeOf(iso: string | null | undefined): string {
  if (!iso) return ''
  return new Date(iso).toLocaleTimeString('bn-BD', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  })
}
---

{
  items.length > 0 && (
    <section aria-label={title}>
      <div class="mb-3 flex items-baseline justify-between gap-4 border-b-2 border-brand-red pb-2">
        <h2 class="font-headline text-xl font-bold text-ink dark:text-dark-ink">{title}</h2>
        <a href="/latest" class="shrink-0 text-sm font-medium text-brand-red hover:underline">
          আরও →
        </a>
      </div>

      <ul class="flex flex-col divide-y divide-rule dark:divide-dark-rule">
        {items.map((article) => (
          <li class="py-3 first:pt-0">
            <a href={`/article/${article.slug}`} class="group flex flex-col gap-1 no-underline">
              <h3 class="font-headline line-clamp-2 text-base font-bold text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red">
                {article.title}
              </h3>
              <div class="flex items-center gap-2 text-xs text-ink-subtle dark:text-dark-ink-muted">
                <time datetime={article.publishedAt ?? undefined}>
                  {timeOf(article.publishedAt)}
                </time>
                {article.category && typeof article.category === 'object' && article.category.nameBn && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{article.category.nameBn}</span>
                  </>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
