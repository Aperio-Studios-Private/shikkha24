---
/**
 * A grid of article cards — the shared body of every listing page.
 *
 * Category, tag, author, archive and latest all render the same thing; only the
 * heading and the data source change. Sharing one component means a fix to card
 * layout lands everywhere at once instead of in five places.
 */
import type { CmsArticle } from '../lib/cms'
import ArticleCard from './ArticleCard.astro'

interface Props {
  articles: CmsArticle[]
  /** Shown when there is nothing to list. */
  emptyMessage?: string
  /**
   * Heading level for each card's headline.
   *
   * Defaults to `3` because most listing pages put an `<h2>` section heading
   * between the page `<h1>` and the grid. A page with **no** intervening `<h2>`
   * must pass `2`, or its card headlines jump from `<h1>` to `<h3>` — a real
   * heading-order failure that screen-reader users navigate by (F3-1/F3-3,
   * 2026-10-19). Three pages previously patched this by inserting a
   * screen-reader-only `<h2>`; passing the level states the structure directly.
   */
  headingLevel?: 2 | 3
}

const { articles, emptyMessage = 'এই বিভাগে এখনো কোনো খবর নেই।', headingLevel = 3 } = Astro.props
---

{
  articles.length === 0 ? (
    <p class="rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">
      {emptyMessage}
    </p>
  ) : (
    <ul class="grid-12">
      {articles.map((article) => (
        <li class="col-span-4 sm:col-span-4 lg:col-span-4">
          <ArticleCard article={article} variant="default" headingLevel={headingLevel} />
        </li>
      ))}
    </ul>
  )
}
