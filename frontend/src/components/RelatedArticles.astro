---
/**
 * Related articles.
 *
 * Keeps a reader inside the portal and, more usefully, gives them the next
 * thing they actually need — after an HSC result story, the admission guide is
 * genuinely the right follow-up, not filler.
 *
 * Uses the compact card variant so four items stay scannable in a sidebar-width
 * column. Renders nothing when there is nothing to show.
 *
 * ## Why this is a stacked list and not a grid
 *
 * This component lives in the article page's `lg:col-span-4` aside — roughly
 * 384px at desktop. It previously rendered a `grid-12` with each item
 * `lg:col-span-3`, which laid **four** compact cards side by side inside that
 * 384px column: each card got about 78px for an 80×80 thumbnail *and* its
 * headline. The compact variant is a horizontal row and needs the full column
 * width to be readable, so a grid can only ever crush it here. If this ever
 * needs to render in a wide column, give it a separate layout rather than
 * re-adding the grid.
 */
import type { CmsArticle } from '../lib/cms'
import ArticleCard from './ArticleCard.astro'

interface Props {
  articles: CmsArticle[]
  title?: string
}

const { articles, title = 'সম্পর্কিত খবর' } = Astro.props
---

{
  articles.length > 0 && (
    <section class="mt-10" aria-label={title}>
      <div class="mb-4 flex items-baseline justify-between gap-4 border-b-2 border-brand-red pb-2">
        <h2 class="font-headline text-xl font-bold text-ink dark:text-dark-ink">{title}</h2>
      </div>

      {/* One full-width row per story — the same stacked-list treatment as
          `LatestFeed`. See the note above on why a grid does not work here. */}
      <ul class="flex flex-col divide-y divide-rule dark:divide-dark-rule">
        {articles.map((article) => (
          <li class="py-3 first:pt-0">
            <ArticleCard article={article} variant="compact" showExcerpt={false} headingLevel={3} />
          </li>
        ))}
      </ul>
    </section>
  )
}
