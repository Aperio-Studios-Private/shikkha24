---
/**
 * Reader reactions — S16.
 *
 * ## Self-hiding, per the S8 rule
 *
 * With no `getPublicCmsOrigin()` there is nowhere to send a reaction, so the
 * control is not rendered at all rather than rendered broken. The `<noscript>`
 * rule hides it for a reader with no JavaScript, for the same reason: a button
 * that cannot work is worse than no button.
 *
 * ## ⚠️ No counts in the static HTML — this is a gate, not a preference
 *
 * The numbers are read **at runtime**, on the reader's first tap. Baking them in
 * at build time would freeze them until the next rebuild, so a reaction would
 * appear to do nothing — the silent-staleness failure this static frontend has
 * already been bitten by. `verify:build-output` asserts no count markup reaches
 * the built page.
 *
 * It also means the page makes **zero** requests for a reader who does not react,
 * which is what the data-saver budget asks for.
 *
 * ## Accessible: a radiogroup, not a row of buttons
 *
 * One reaction per article, so the control is a `radiogroup` of `radio`s with
 * roving `tabindex` and arrow-key navigation — the pattern a screen reader
 * announces correctly. Tapping the current choice removes it, which a native
 * `<input type=radio>` cannot express, so these are buttons carrying the roles
 * and the keyboard contract by hand.
 *
 * The server is the authority on the reader's own choice: `localStorage` is used
 * only to paint the control before the first request, and the response's `mine`
 * overwrites it.
 */
import { REACTION_EMOJI, REACTION_LABELS_BN, REACTION_TYPES } from '../lib/reactions'

interface Props {
  /** The Payload article id — the shortlink `/a/:id` uses the same value. */
  articleId: number | string
  /** `getPublicCmsOrigin()`; the control self-hides when this is null. */
  cmsOrigin: string | null
}

const { articleId, cmsOrigin } = Astro.props

const renderable = Boolean(cmsOrigin)
---

{
  renderable && (
    <section
      class="reaction-bar mt-6 rounded-lg border-2 border-rule bg-surface-raised p-5 dark:border-dark-rule dark:bg-dark-raised"
      data-reaction-bar
      data-article={String(articleId)}
      data-origin={cmsOrigin ?? ''}
      aria-labelledby="reaction-heading"
    >
      <noscript>
        <style>{'[data-reaction-bar]{display:none}'}</style>
      </noscript>

      <h2
        id="reaction-heading"
        class="flex items-center gap-2 text-base font-bold text-ink dark:text-dark-ink"
      >
        <span aria-hidden="true">💬</span>
        এই সংবাদটি আপনার কেমন লাগল?
      </h2>

      <div
        class="mt-3 flex flex-wrap gap-2"
        role="radiogroup"
        aria-labelledby="reaction-heading"
        data-reaction-group
      >
        {REACTION_TYPES.map((type, index) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            tabindex={index === 0 ? 0 : -1}
            class="reaction-option inline-flex min-h-12 items-center gap-2 rounded-md border-2 border-rule bg-surface px-3 text-sm font-semibold text-ink transition-colors hover:border-brand-red hover:bg-surface-raised dark:border-dark-rule dark:bg-dark-surface dark:text-dark-ink dark:hover:bg-dark-raised"
            data-reaction-option
            data-type={type}
          >
            <span aria-hidden="true" class="text-lg leading-none">{REACTION_EMOJI[type]}</span>
            <span>{REACTION_LABELS_BN[type]}</span>
            {/*
              Reserved and empty. The count is written here at runtime, and the
              box exists from the first paint so revealing it cannot shift the
              layout — the same discipline as `AdSlot`.
            */}
            <span
              class="reaction-count min-w-6 text-xs text-ink-muted dark:text-dark-ink-muted"
              data-reaction-count
              aria-hidden="true"
            />
          </button>
        ))}
      </div>

      {/* Honeypot — off-screen, never focusable, never filled by a human. */}
      <input
        type="text"
        name="company"
        data-reaction-honeypot
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="pointer-events-none absolute h-0 w-0 opacity-0"
      />

      <p
        data-reaction-status
        role="status"
        aria-live="polite"
        class="mt-3 text-sm text-ink-muted dark:text-dark-ink-muted"
      />

      <p class="mt-3 text-xs leading-relaxed text-ink-subtle dark:text-dark-ink-muted">
        ডুপ্লিকেট প্রতিক্রিয়া ঠেকাতে আপনার আইপি ও ব্রাউজার তথ্যের একটি ওয়ান-ওয়ে হ্যাশ সংরক্ষণ করা
        হয়, মূল তথ্য নয়।
      </p>
    </section>
  )
}

<script>
  /**
   * Reaction toggling.
   *
   * One request per tap, and none at all until the reader reacts. The response
   * carries the fresh counts and the caller's own choice, so the UI is reconciled
   * from the server rather than from an optimistic guess that could be wrong.
   */
  const STORAGE_KEY = 'shikkha24-reactions'
  const BN_DIGITS = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯']
  const toBn = (value: number | string): string =>
    String(value).replace(/\d/g, (digit) => BN_DIGITS[Number(digit)])

  /** The reader's remembered choice per article — a paint hint, not authority. */
  function readMine(): Record<string, string> {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY)
      return raw ? (JSON.parse(raw) as Record<string, string>) : {}
    } catch {
      // Private mode, or storage disabled. Reacting still works; it is simply
      // not remembered between visits, and the server still dedupes.
      return {}
    }
  }

  function rememberMine(articleId: string, type: string | null): void {
    try {
      const mine = readMine()
      if (type) mine[articleId] = type
      else delete mine[articleId]
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(mine))
    } catch {
      /* storage unavailable — not fatal */
    }
  }

  for (const bar of document.querySelectorAll<HTMLElement>('[data-reaction-bar]')) {
    const articleId = bar.dataset.article ?? ''
    const origin = bar.dataset.origin ?? ''
    const group = bar.querySelector<HTMLElement>('[data-reaction-group]')
    const status = bar.querySelector<HTMLElement>('[data-reaction-status]')
    const honeypot = bar.querySelector<HTMLInputElement>('[data-reaction-honeypot]')
    const options = [...bar.querySelectorAll<HTMLButtonElement>('[data-reaction-option]')]

    if (!articleId || !origin || !group || options.length === 0) continue

    const setStatus = (message: string): void => {
      if (status) status.textContent = message
    }

    /** Paint the selection. Roving `tabindex` keeps one stop in the group. */
    const select = (type: string | null): void => {
      for (const option of options) {
        const chosen = option.dataset.type === type
        option.setAttribute('aria-checked', String(chosen))
        option.classList.toggle('is-selected', chosen)
        option.tabIndex = chosen || (!type && option === options[0]) ? 0 : -1
      }
    }

    const paintCounts = (counts: Record<string, number>): void => {
      for (const option of options) {
        const label = option.querySelector<HTMLElement>('[data-reaction-count]')
        if (!label) continue
        const count = counts[option.dataset.type ?? ''] ?? 0
        // Empty at zero rather than a bare "০" — a row of zeroes reads as noise.
        label.textContent = count > 0 ? toBn(count) : ''
      }
    }

    // A remembered choice is a paint hint only — see the header.
    select(readMine()[articleId] ?? null)

    group.addEventListener('keydown', (event) => {
      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp']
      if (!keys.includes(event.key)) return
      event.preventDefault()

      const current = options.indexOf(document.activeElement as HTMLButtonElement)
      const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1
      const next = options[(Math.max(current, 0) + step + options.length) % options.length]
      next?.focus()
    })

    for (const option of options) {
      option.addEventListener('click', async () => {
        const type = option.dataset.type ?? ''
        if (!type) return

        for (const other of options) other.disabled = true
        setStatus('পাঠানো হচ্ছে')

        try {
          const response = await fetch(`${origin}/api/reactions/toggle`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ article: articleId, type, company: honeypot?.value ?? '' }),
          })

          const payload = (await response.json().catch(() => ({}))) as {
            counts?: Record<string, number>
            mine?: string | null
            error?: string
          }

          if (response.ok && payload.counts) {
            paintCounts(payload.counts)
            // The server's answer wins over the local hint, always.
            const mine = payload.mine ?? null
            select(mine)
            rememberMine(articleId, mine)
            setStatus(mine ? 'ধন্যবাদ, আপনার প্রতিক্রিয়া গণনা করা হয়েছে।' : 'আপনার প্রতিক্রিয়া সরানো হয়েছে।')
          } else {
            setStatus(payload.error ?? 'প্রতিক্রিয়া পাঠানো যায়নি।')
          }
        } catch {
          setStatus('প্রতিক্রিয়া পাঠানো যায়নি। একটু পরে আবার চেষ্টা করুন।')
        } finally {
          for (const other of options) other.disabled = false
        }
      })
    }
  }
</script>

<style>
  [data-reaction-option].is-selected {
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
    background-color: color-mix(in srgb, var(--color-brand-red) 10%, transparent);
  }
</style>
