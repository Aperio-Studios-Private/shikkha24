---
/**
 * Demo ad creative — rotates through every ad format the site will sell.
 *
 * ## Why this exists
 *
 * The ad system (S7) is not built, but the slots are already in the layout. An
 * empty dashed box tells the owner nothing about what those slots become; a
 * rotating demo shows every format in place, at real size, so the inventory can
 * be approved before any AdSense code is written.
 *
 * ## Not a real ad
 *
 * These are placeholder creatives rendered with CSS — no image files, no
 * network, no third party. That keeps them weightless and makes it obvious they
 * are placeholders. Real AdSense units replace them at S7 without touching the
 * layout, because the slot already reserves the exact dimensions.
 *
 * ⚠️ **"Obvious they are placeholders" was not true on screen until 2026-10-16.**
 * The creatives carried real-sounding offers (one promised a guaranteed IELTS
 * band) inside a bordered box with a `বিজ্ঞাপন` label, so to a reader they were
 * indistinguishable from sold advertising. The creatives are now generic and a
 * visible `নমুনা বিজ্ঞাপন` badge states it outright. Keep both: the badge is the
 * guarantee, the copy is just realistic for size approval.
 *
 * ## Motion
 *
 * Rotation stops entirely under `prefers-reduced-motion`, and otherwise the
 * reader can stop it themselves with a visible `থামান` / `চালু করুন` button.
 *
 * ⚠️ **Corrected 2026-10-19:** this block used to claim hover-pause satisfied
 * WCAG 2.2.2. It did not. Hover does not exist on a touch device, so the phone
 * reader — the majority of this site's traffic — had no way to stop an
 * auto-rotating ad. The button is the mechanism of record; hover-pause is kept
 * as an extra for pointer users. The button ships `hidden` and is revealed by
 * the script, so it is never a dead control when JavaScript does not run.
 */
interface Props {
  /** Which inventory format this slot represents. */
  format: 'leaderboard' | 'rectangle' | 'skyscraper' | 'mobile' | 'infeed'
  slot: string
}

const { format, slot } = Astro.props

/** Format dimensions, matching the reserved box in AdSlot. */
const FORMAT_LABELS: Record<Props['format'], string> = {
  leaderboard: '৭২৮×৯০ লিডারবোর্ড',
  rectangle: '৩০০×২৫০ মিডিয়াম রেকট্যাঙ্গেল',
  skyscraper: '১৬০×৬০০ স্কাইস্ক্র্যাপার',
  mobile: '৩২০×১০০ মোবাইল ব্যানার',
  infeed: 'ইন-ফিড নেটিভ',
}

/**
 * Sample creatives. Plain CSS, so they cost nothing to render.
 *
 * ## Why the copy is generic
 *
 * These deliberately advertise nothing. The earlier creatives read as real
 * commercial offers — one carried "ব্যান্ড ৭+ গ্যারান্টি" (a guaranteed IELTS
 * band), which is a specific performance promise. Rendered on a live page at real
 * size inside a dashed "বিজ্ঞাপন" box, a reader cannot tell that from a paid ad
 * for a service shikkha24 does not sell, and a guarantee is not something this
 * site can make on a third party's behalf.
 *
 * That also contradicted the site's own purpose: `/fact-check` exists to publish
 * verdicts on misleading claims — explicitly including fabricated scholarship and
 * result notices — so carrying an unowned guarantee in an ad slot would have the
 * site doing the thing it publishes against.
 *
 * The subject matter is kept to the site's own topical areas so the format and
 * text length are still realistic for approval. The visible `নমুনা বিজ্ঞাপন`
 * badge below is what identifies them as samples; these strings are not load
 * bearing for that.
 */
const CREATIVES = [
  { title: 'বিজ্ঞাপন স্থান', body: 'লিডারবোর্ড ফরম্যাট', tone: 'red' },
  { title: 'বিজ্ঞাপন স্থান', body: 'ইন-ফিড নেটিভ ফরম্যাট', tone: 'teal' },
  { title: 'বিজ্ঞাপন স্থান', body: 'মিডিয়াম রেকট্যাঙ্গেল', tone: 'indigo' },
  { title: 'বিজ্ঞাপন স্থান', body: 'স্কাইস্ক্র্যাপার ফরম্যাট', tone: 'amber' },
]
---

<div
  class:list={[
    'demo-ad relative flex h-full w-full items-center justify-center overflow-hidden rounded',
    'border border-dashed border-rule bg-surface-raised dark:border-dark-rule dark:bg-dark-raised',
  ]}
  data-demo-ad={slot}
  data-format={format}
  aria-label={`বিজ্ঞাপন স্লট: ${FORMAT_LABELS[format]}`}
>
  {CREATIVES.map((creative, index) => (
    <div
      class:list={[
        'demo-creative absolute inset-0 flex flex-col items-center justify-center gap-0.5 px-3 text-center',
        /*
         * `invisible` (CSS `visibility: hidden`) on the inactive creatives, not
         * just `opacity-0`.
         *
         * ⚠️ **Corrected 2026-10-19.** With opacity alone, the hidden creatives
         * stayed *rendered* — so Lighthouse measured their faded text against the
         * card surface and reported a **1.22:1** contrast failure (foreground
         * #e1e1e1 on #f7f7f7, against the 4.5:1 minimum) on the article template.
         * The text was never visible to a reader, so the audit was a false
         * positive in substance — but it was scoring against a real accessibility
         * gate, and `visibility: hidden` is the honest fix: it removes the element
         * from rendering and from the contrast calculation while keeping the
         * opacity transition on the active creative.
         */
        index === 0 ? 'visible opacity-100' : 'invisible opacity-0',
      ]}
      data-index={index}
      aria-hidden={index === 0 ? 'false' : 'true'}
    >
      <span
        class:list={[
          'font-headline font-bold',
          format === 'skyscraper' ? 'text-sm' : 'text-base',
          creative.tone === 'red' && 'text-brand-red',
          // teal-700, not teal-600: teal-600 (#009689) measures 3.42:1 on the
          // raised surface (#f7f7f7) and fails WCAG AA. teal-700 is 5.11:1 there and
          // 5.47:1 on white (T-24).
          creative.tone === 'teal' && 'text-teal-700 dark:text-teal-400',
          creative.tone === 'indigo' && 'text-indigo-600 dark:text-indigo-400',
          creative.tone === 'amber' && 'text-amber-600 dark:text-amber-400',
        ]}
      >
        {creative.title}
      </span>
      {/*
        ⚠️ `text-sm` (15px), not `text-xs`. `--text-xs` is documented as
        "labels only, never body copy" (`global.css:146`), and `creative.body` is a
        full sentence of Bengali — at 13px its conjuncts collide. The card's own
        format label below stays at `text-[10px]` because that genuinely is a
        label. This also removes the last 13px body text the contrast audit could
        catch mid-rotation.
      */}
      <span class="text-sm text-ink dark:text-dark-ink">{creative.body}</span>
    </div>
  ))}

  <span
    class="absolute bottom-1 right-1.5 text-[10px] uppercase tracking-wide text-ink-muted dark:text-dark-ink-muted"
  >
    {FORMAT_LABELS[format]}
  </span>

  {/*
    A reader-visible marker that this is a sample, not a sold placement.

    `বিজ্ঞাপন` alone was not enough: a bordered box containing copy at real size
    reads as a paid ad. `demo-ad` in the class list and the aria-label are both
    invisible on screen, so a sighted reader had no way to tell. This badge is the
    honest signal, and it is deliberately in the top-left so it does not collide
    with the format label in the bottom-right.
  */}
  <span
    class="absolute left-1.5 top-1 rounded bg-surface-sunken px-1.5 py-0.5 text-[10px] font-medium text-ink dark:bg-dark-sunken dark:text-dark-ink"
  >
    নমুনা বিজ্ঞাপন
  </span>

  {/*
    WCAG 2.2.2 (Pause, Stop, Hide): moving content that auto-starts and runs for
    more than five seconds must be stoppable by the reader.

    Hover alone did not satisfy it — a touch device has no hover, so a phone
    reader had no way to stop the rotation at all, which is the case this
    component's own docblock already called a failure. This is a real control:
    keyboard-reachable, labelled, and it reflects its state through
    `aria-pressed` so the change is announced. The label and icon are updated by
    the script below.
  */}
  <button
    type="button"
    data-ad-toggle
    hidden
    aria-pressed="false"
    aria-label="বিজ্ঞাপন ঘোরানো থামান"
    class="absolute bottom-1 left-1.5 rounded bg-surface-sunken px-1.5 py-0.5 text-[10px] font-medium text-ink hover:bg-surface dark:bg-dark-sunken dark:text-dark-ink dark:hover:bg-dark-raised"
  >
    <span data-ad-toggle-label>থামান</span>
  </button>
</div>

<script>
  (function () {
    const ads = Array.from(document.querySelectorAll<HTMLElement>('[data-demo-ad]'))
    if (ads.length === 0) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    for (const ad of ads) {
      const creatives = Array.from(ad.querySelectorAll<HTMLElement>('.demo-creative'))
      if (creatives.length < 2) continue

      // Static first frame under reduced motion — no rotation at all.
      if (reduceMotion) continue

      let index = 0
      let paused = false

      // Hover-pause is a convenience for pointer users, not the mechanism of
      // record — touch has no hover. The button below is what satisfies
      // WCAG 2.2.2, and `paused` is shared so either one stops the rotation.
      ad.addEventListener('mouseenter', () => (paused = true))
      ad.addEventListener('mouseleave', () => (paused = false))

      const toggle = ad.querySelector<HTMLButtonElement>('[data-ad-toggle]')
      const toggleLabel = ad.querySelector<HTMLElement>('[data-ad-toggle-label]')

      if (toggle && toggleLabel) {
        toggle.hidden = false
        toggle.addEventListener('click', () => {
          paused = !paused
          toggle.setAttribute('aria-pressed', String(paused))
          // The label names the action the reader gets, not the current state:
          // while rotating the button offers "stop", while stopped it offers
          // "start". `aria-label` carries the same meaning for screen readers,
          // and the visible text stays short enough for the 10px badge row.
          toggleLabel.textContent = paused ? 'চালু করুন' : 'থামান'
          toggle.setAttribute('aria-label', paused ? 'বিজ্ঞাপন ঘোরানো চালু করুন' : 'বিজ্ঞাপন ঘোরানো থামান')
        })
      }

      setInterval(() => {
        if (paused || document.hidden) return

        // `invisible`/`visible` travel with the opacity swap — the outgoing
        // creative must leave the contrast calculation, and the incoming one must
        // enter it, at the same moment. `classList` is a DOMTokenList, so these
        // four calls are the whole state machine.
        creatives[index]?.classList.replace('opacity-100', 'opacity-0')
        creatives[index]?.classList.replace('visible', 'invisible')
        creatives[index]?.setAttribute('aria-hidden', 'true')

        index = (index + 1) % creatives.length

        creatives[index]?.classList.replace('opacity-0', 'opacity-100')
        creatives[index]?.classList.replace('invisible', 'visible')
        creatives[index]?.setAttribute('aria-hidden', 'false')
      }, 4000)
    }
  })()
</script>

<style>
  /*
   * ⚠️ **The outgoing creative leaves the render tree immediately — do not
   * re-add a `visibility` transition delay here.**
   *
   * An earlier version delayed `visibility` by 600 ms so the outgoing creative
   * stayed rendered for the length of its opacity fade. That looked right and
   * caused a **flaky accessibility gate**: for those 600 ms the element is
   * rendered at a partial opacity, so its text composites to a blended colour
   * (measured `#a0a0a0` and `#c5c5c5` on `#f7f7f7`, against the 4.5:1 minimum)
   * and Lighthouse's `color-contrast` audit sampled it whenever its snapshot
   * landed mid-fade. It reported a failure on roughly one run in three, on an
   * element that is `aria-hidden` and whose text a reader never sees — a false
   * positive that made `pnpm verify:lighthouse` intermittently red.
   *
   * So `visibility` is stepped with **no** delay in either direction: the
   * outgoing creative is gone from rendering the moment the swap happens, and
   * the incoming one is visible before its opacity starts rising. The cross-fade
   * is therefore driven by the incoming creative only, which is still a fade —
   * just not a double-exposure of two half-transparent layers.
   */
  .demo-creative {
    transition:
      opacity 600ms ease-in-out,
      visibility 0s linear;
  }
</style>
