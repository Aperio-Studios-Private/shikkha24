---
/**
 * Optimised category archetype image.
 *
 * Wraps Astro's `<Picture>` so every call site gets the same correct treatment
 * instead of re-deriving it. What this buys:
 *
 * - **AVIF first, WebP fallback.** AVIF reached Baseline-widely-available in
 *   July 2026 and is meaningfully smaller than WebP; the fallback costs one
 *   `<source>` line, so there is no reason not to ship both.
 * - **Responsive `srcset`.** Several widths, so a 375px phone never downloads
 *   the 1200px desktop asset.
 * - **Zero CLS.** `<Picture>` writes intrinsic `width`/`height`, so the browser
 *   reserves the exact box before the bytes arrive.
 * - **Lazy by default.** Only an explicitly `eager` image opts out, because
 *   lazy-loading the LCP element is one of the most common self-inflicted
 *   performance wounds.
 *
 * ## The `sizes` attribute is not optional decoration
 *
 * `srcset` tells the browser what widths exist; `sizes` tells it how wide the
 * image will actually *render*. Get `sizes` wrong and the browser happily picks
 * a 1200px file for a 300px slot. It is the single most commonly omitted
 * attribute and the one that decides whether responsive images save anything.
 */
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  /** Local image metadata from `lib/images.ts`. */
  image: ImageMetadata
  alt: string
  /**
   * How wide the image renders at each breakpoint. Must mirror the real CSS.
   * Defaults to a full-width mobile / half-width desktop card.
   */
  sizes?: string
  /** Source widths to generate. Kept small — every width is a real file. */
  widths?: number[]
  /** Set eager + high priority ONLY for the LCP hero. */
  priority?: boolean
  class?: string
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 600px, 100vw',
  widths = [400, 800, 1200],
  priority = false,
  class: className = '',
} = Astro.props
---

<Picture
  src={image}
  formats={['avif', 'webp']}
  {widths}
  {sizes}
  {alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
/>
