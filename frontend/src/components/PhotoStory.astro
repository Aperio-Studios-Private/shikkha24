---
/**
 * Photo-story frames — S17.
 *
 * ## ⚠️ Zero CLS is the hard gate here
 *
 * This is the most image-dense page on the site, and `docs/performance-budget.md`
 * treats CLS as a gate rather than a target. Every frame therefore reserves its
 * box **from the media record's true dimensions** — `resolveCmsImage` supplies
 * real `width`/`height`, and they are written onto the `<img>` *and* into an
 * `aspect-ratio`, so the space is held before a single byte of image arrives.
 *
 * An image whose dimensions are unknown is **skipped, not guessed** — the page
 * filters those out before handing the frames down. A guessed ratio is a layout
 * shift with extra steps.
 *
 * ## Scroll-linked, with no JavaScript
 *
 * The motion is CSS scroll-driven animation behind `@supports
 * (animation-timeline: view())` and `prefers-reduced-motion`, exactly as the S8
 * scrollytelling block does. A browser without support, or a reader who asked for
 * less motion, gets the plain stacked frames — never a half-faded one. That also
 * means the frames are fully readable with JavaScript disabled, which matters
 * because this is the whole content of the page.
 *
 * ## Full bleed is a presentation choice, not a width
 *
 * `fullBleed` lets a frame escape the prose column. It is done with a CSS class
 * and negative margins rather than a different DOM shape, so the markup — and the
 * reserved box — is identical either way.
 */
import type { PhotoFrame } from '../lib/photo-story'

interface Props {
  frames: PhotoFrame[]
}

const { frames: resolved } = Astro.props
---

{
  resolved.length > 0 && (
    <div class="photo-story mt-6" data-photo-story>
      {resolved.map((frame) => (
        <figure
          class:list={['photo-frame', frame.fullBleed && 'is-full-bleed']}
          style={`--frame-ratio: ${frame.image.width} / ${frame.image.height}`}
        >
          <img
            src={frame.image.src}
            srcset={frame.image.srcset}
            width={frame.image.width}
            height={frame.image.height}
            alt={frame.image.alt}
            loading="lazy"
            decoding="async"
          />
          {(frame.caption || frame.credit) && (
            <figcaption>
              {frame.caption}
              {frame.credit && <span class="photo-credit">{frame.credit}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}

<style>
  .photo-story {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .photo-frame {
    margin: 0;
  }

  /*
   * The reserved box. `aspect-ratio` from the record's real pixels plus the
   * `width`/`height` attributes on the `<img>` means the space is held twice
   * over — belt and braces, because this is the CLS-critical page.
   */
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--frame-ratio);
    border-radius: 0.5rem;
    background-color: var(--color-rule, #e5e5e5);
  }

  .photo-frame figcaption {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-subtle, #4a4a4a);
  }

  .photo-credit {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted, #6b6b6b);
  }

  /*
   * Full bleed escapes the prose column on wide screens only. On a phone the
   * column already fills the viewport, so the class is a no-op there — which is
   * why the negative margin is inside a media query rather than unconditional.
   */
  @media (min-width: 1024px) {
    .photo-frame.is-full-bleed {
      margin-inline: calc(-1 * var(--full-bleed-inset, 4rem));
    }
  }

  /* Scroll-linked, and only where it is supported and wanted. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .photo-frame {
        animation: photo-frame-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }

      @keyframes photo-frame-in {
        from {
          opacity: 0.35;
          transform: translateY(1rem);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
