---
/**
 * Header utilities — weather, prayer times, location.
 *
 * ## Why nothing is rendered server-side
 *
 * Both widgets answer a question about **the reader's** city, and a static build
 * knows exactly one place: Dhaka, baked whenever the site was last deployed.
 * Rendering that value is what produced the owner's report — a Sylhet reader
 * saw their own city label beside Dhaka's temperature, because the label was
 * written from a resolved location while the number beside it was never
 * refetched. Even with a matching label the number could be days old.
 *
 * So the server renders a **neutral placeholder** and the browser fills it in.
 * Owner decision, 2026-10-05: a second of blankness is preferable to showing
 * another city's number with confidence.
 *
 * ## What the reader gets
 *
 * - The **next** prayer with a live countdown, not a fixed one — after ইশা it
 *   rolls over to *tomorrow's* ফজর at tomorrow's own time, not today's.
 * - A **dropdown** with all five times and the Hijri date, both fetched on
 *   demand so the common case costs one request, not two.
 * - A **location selector**, because a Chattogram reader should see Chattogram.
 */
import { CITIES } from '../lib/geo'
import { PRAYER_NAMES, PRAYER_LABELS_BN } from '../lib/prayer'

interface Props {
  /** `weatherWidget` feature flag — when off, the weather pill is not rendered. */
  showWeather?: boolean
  /** `prayerWidget` feature flag — when off, the prayer pill is not rendered. */
  showPrayer?: boolean
}

const { showWeather = true, showPrayer = true } = Astro.props
---

<div class="flex min-w-0 items-center gap-2" id="header-widgets">
  {
    showWeather && (
      /* Minimal by default (owner request): city + temperature only. The
         condition text lives in the hover tooltip via title — one line always. */
      <span class="hidden min-w-0 items-center whitespace-nowrap sm:inline-flex">
        <span class="text-ink-subtle dark:text-dark-ink-muted" aria-hidden="true">
          ·
        </span>
        <button
          type="button"
          id="hw-weather"
          class="inline-flex min-h-12 items-center gap-1 truncate py-2 hover:text-brand-red"
          aria-busy="true"
          title="আবহাওয়া"
        >
          {/* Weather icon — visual recognition (owner request 2026-10-28) */}
          <svg class="shrink-0 text-amber-500 dark:text-amber-400" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 2v2" /><path d="M4.93 4.93l1.41 1.41" /><path d="M20 12h2" /><path d="M19.07 4.93l-1.41 1.41" /><path d="M15.947 12.65a4 4 0 0 0-5.925-4.128" /><path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z" />
          </svg>
          <span id="hw-city">—</span>{' '}
          <span class="font-medium text-ink dark:text-dark-ink" id="hw-temp">—</span>
          {/* Condition text is set by the script but kept invisible — it feeds
              the hover tooltip (title) instead of occupying ribbon space. */}
          <span class="sr-only" id="hw-cond" />
        </button>
      </span>
    )
  }

  {
    showPrayer && (
      <span class="relative hidden min-w-0 items-center whitespace-nowrap lg:inline-flex">
        <span class="text-ink-subtle dark:text-dark-ink-muted" aria-hidden="true">
          ·
        </span>
    {/* Minimal by default (owner request): the NEXT prayer's start time only —
        no countdown text. The full schedule + Hijri date appear on hover via
        the panel below (opens on hover AND click for touch readers). */}
    <button
      type="button"
      id="hw-prayer-btn"
      aria-expanded="false"
      aria-controls="hw-prayer-panel"
      class="inline-flex items-center gap-1 truncate hover:text-brand-red"
      aria-busy="true"
      title="নামাজের সময়সূচি"
    >
      {/* Prayer icon — crescent moon, visual recognition (owner request) */}
      <svg class="shrink-0 text-brand-red" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
      </svg>
      <span id="hw-next-label">নামাজ</span>{' '}
      <span class="font-medium text-ink dark:text-dark-ink" id="hw-next-time">—</span>
    </button>

    <div
      id="hw-prayer-panel"
      hidden
      class="absolute right-0 top-full z-50 mt-1 w-56 rounded-md border border-rule bg-surface p-3 text-sm shadow-lg dark:border-dark-rule dark:bg-dark-surface"
    >
      <p class="mb-2 text-xs font-semibold text-ink-subtle dark:text-dark-ink-muted">
        নামাজের সময়সূচি
      </p>
      <ul class="flex flex-col gap-1">
        {
          PRAYER_NAMES.map((name) => (
            <li class="flex items-center justify-between">
              <span>{PRAYER_LABELS_BN[name]}</span>
              <span class="font-medium text-ink dark:text-dark-ink" data-prayer={name}>
                —
              </span>
            </li>
          ))
        }
      </ul>
      <p
        id="hw-hijri"
        hidden
        class="mt-2 border-t border-rule pt-2 text-xs text-ink-subtle dark:border-dark-rule dark:text-dark-ink-muted"
      >
      </p>
    </div>
      </span>
    )
  }

  <span class="hidden shrink-0 items-center gap-1 md:inline-flex">
    <span class="text-ink-subtle dark:text-dark-ink-muted" aria-hidden="true">·</span>
    <label for="hw-location" class="sr-only">এলাকা বেছে নিন</label>
    <select
      id="hw-location"
      class="max-w-28 rounded border border-rule bg-surface px-1.5 py-0.5 text-xs text-ink dark:border-dark-rule dark:bg-dark-surface dark:text-dark-ink"
    >
      {CITIES.map((city) => <option value={`${city.lat},${city.lon}`}>{city.labelBn}</option>)}
      <option value="">বর্তমান অবস্থান</option>
    </select>
  </span>
</div>

<script>
  import { getNextPrayer, PRAYER_NAMES } from '../lib/prayer'
  import { weatherLabel } from '../lib/weather-codes'
  import { formatHijri, HIJRI_OFFSET } from '../lib/hijri'
  import {
    CITIES,
    readStoredLocation,
    storeLocation,
    detectLocationByIp,
    getDefaultLocation,
    nearestCity,
  } from '../lib/geo'

  /**
   * Aladhan calculation method: **15 = Moonsighting Committee Worldwide**,
   * owner-selected for Bangladesh on 2026-10-05.
   *
   * ⚠️ **Three upstream traps, all verified against the live API.** Read these
   * before changing this number — each one silently produces wrong times rather
   * than an error:
   *
   * 1. **`13` is Turkey, not Moonsighting.** Moonsighting is `15`. Enumerating
   *    indices `0…20` is the only reliable way to check.
   * 2. **`/v1/methods` is ordered differently from the numeric `method=`
   *    parameter.** In that object, position 14 is `MOONSIGHTING`; through the
   *    parameter, 14 is *Russia* and 15 is *Moonsighting*. Never pick the index
   *    by reading that list — it is the single easiest way to get this wrong.
   * 3. **The `method=` name parameter is broken.** Every name tried
   *    (`MOONSIGHTING`, `MWL`, `KARACHI`, `ISNA`, `EGYPT`, `MAKKAH`, `GULF`,
   *    `TURKEY`, `QATAR`, `SINGAPORE`) returned ISNA. Only the number varies.
   *    `timingsByCity` and `timingsByCoordinates` are both dead.
   *
   * `scripts/verify-prayer-times.mjs` asserts the API reports this method back
   * **by name**, so a silent upstream remap fails the build instead of quietly
   * changing every prayer time on the site.
   */
  const ALADHAN_METHOD = 15

  /**
   * Asr school: **1 = Hanafi**, the school Bangladesh follows.
   *
   * ⚠️ **Aladhan silently defaults to Shafi'i Asr when this is omitted — and it
   * accepts the parameter while ignoring it in `meta`, so the mistake is
   * invisible from the response.** Omitting it made every Asr time on the site
   * **5–6 minutes early** (measured across all five header cities in October:
   * ঢাকা 5.8, সিলেট 5.9, চট্টগ্রাম 5.3, রংপুর 6.2, বরিশাল 5.0). Shafi'i Asr uses a
   * 1:1 shadow ratio against Hanafi's 2:1, so the gap widens further in summer.
   *
   * Asr is the **only** time this affects — Fajr/Isha follow `method` alone.
   * `scripts/verify-prayer-times.mjs` computes Hanafi Asr independently from NOAA
   * solar position and asserts the API agrees within 2 minutes, which is what
   * caught this; without `school` it fails on all five cities.
   */
  const ALADHAN_SCHOOL = 1

  const toBn = (v: string | number) =>
    String(v).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]!)

  const el = (id: string) => document.getElementById(id)
  const cityEl = el('hw-city')
  const tempEl = el('hw-temp')
  const condEl = el('hw-cond')
  const nextLabelEl = el('hw-next-label')
  const nextTimeEl = el('hw-next-time')
  const hijriEl = el('hw-hijri')
  const prayerBtn = el('hw-prayer-btn')
  const prayerPanel = el('hw-prayer-panel')
  const locationSelect = el('hw-location') as HTMLSelectElement | null

  /** Clear the "loading" affordance once real data is on screen. */
  function markReady(...nodes: (HTMLElement | null)[]) {
    for (const node of nodes) node?.setAttribute('aria-busy', 'false')
  }

  /** "DD-MM-YYYY" — the shape Aladhan puts in its path. */
  const ddmmyyyy = (d: Date) =>
    `${String(d.getDate()).padStart(2, '0')}-${String(d.getMonth() + 1).padStart(2, '0')}-${d.getFullYear()}`

  /** Today's timings from Aladhan. */
  interface AladhanDay {
    times: Record<string, string>
    hijri: { hijri?: { day?: string; month?: { en?: string }; year?: string } }
  }

  /**
   * Fetch one date's timings from Aladhan.
   *
   * @returns `null` on any failure — a lookup must never break the header.
   */
  async function fetchDay(date: Date, lat: number, lon: number): Promise<AladhanDay | null> {
    try {
      const url =
        `https://api.aladhan.com/v1/timings/${ddmmyyyy(date)}` +
        `?latitude=${lat}&longitude=${lon}&method=${ALADHAN_METHOD}` +
        `&school=${ALADHAN_SCHOOL}`
      const response = await fetch(url, { signal: AbortSignal.timeout(5000) })
      if (!response.ok) return null
      const body = await response.json()
      const timings = body?.data?.timings
      if (body?.code !== 200 || !timings?.Fajr) return null

      // Aladhan appends a timezone suffix ("05:12 (+06)") — strip it.
      const clean = (v: string | undefined) => (v ?? '').split(' ')[0]
      return {
        times: {
          fajr: clean(timings.Fajr),
          dhuhr: clean(timings.Dhuhr),
          asr: clean(timings.Asr),
          maghrib: clean(timings.Maghrib),
          isha: clean(timings.Isha),
        },
        hijri: body.data.date ?? {},
      }
    } catch {
      return null
    }
  }

  /** Render the next prayer's START TIME (minimal ribbon, owner request).
   *  The countdown text is gone from the ribbon; the full schedule lives in
   *  the hover/click panel. No ticking timer needed any more — the start time
   *  is static until the next prayer arrives, so one paint per fetch. */
  function renderNextPrayer(times: Record<string, string>, tomorrowFajr?: string) {
    const paint = (next: ReturnType<typeof getNextPrayer>) => {
      if (!next || !nextTimeEl || !nextLabelEl) return
      nextTimeEl.textContent = toBn(next.time)
      nextLabelEl.textContent = next.isTomorrow ? `${next.label} (আগামীকাল)` : next.label
    }

    paint(getNextPrayer(times as never, new Date(), tomorrowFajr))
  }

  /** Fetch prayer times for a point and update both the pill and the panel. */
  async function loadPrayer(lat: number, lon: number) {
    const today = await fetchDay(new Date(), lat, lon)
    if (!today) return

    for (const name of PRAYER_NAMES) {
      const node = document.querySelector(`[data-prayer="${name}"]`)
      if (node) node.textContent = toBn(today.times[name] ?? '')
    }

    // After ইশা the next prayer is tomorrow's ফজর, and tomorrow's ফজর is not
    // today's. Fetching it costs one extra request, but only in that window —
    // which is exactly when a reader is checking sehri.
    let tomorrowFajr: string | undefined
    let next = getNextPrayer(today.times as never)
    if (next?.isTomorrow) {
      const tomorrow = new Date()
      tomorrow.setDate(tomorrow.getDate() + 1)
      tomorrowFajr = (await fetchDay(tomorrow, lat, lon))?.times.fajr
    }

    renderNextPrayer(today.times, tomorrowFajr)
    markReady(el('hw-prayer-btn'))
    lastPrayerPoint = { lat, lon }
  }

  /** The point the current times were fetched for, so the Hijri date can be reused. */
  let lastPrayerPoint: { lat: number; lon: number } | null = null

  /**
   * Load the Hijri date — **on demand**.
   *
   * It needs its own request, because `HIJRI_OFFSET` shifts the Gregorian date
   * we ask about and Aladhan does the Hijri month arithmetic. Doing that on
   * every page view would double the widget's cost for a line hidden behind a
   * dropdown, which also counts against the data-saver budget.
   */
  async function loadHijriOnce(lat: number, lon: number) {
    if (!hijriEl || !hijriEl.hidden) return
    const date = new Date()
    date.setDate(date.getDate() + HIJRI_OFFSET)
    const day = await fetchDay(date, lat, lon)
    const text = formatHijri(day?.hijri, HIJRI_OFFSET)
    if (!text) return
    hijriEl.textContent = text
    hijriEl.hidden = false
  }

  /**
   * Fetch weather for a point.
   *
   * ⚠️ `weather_code` was requested here for as long as the widget existed and
   * the response type never declared it, so the condition beside the
   * temperature was frozen at whatever the build had baked. It is now read and
   * written — and an unknown code renders **nothing** rather than defaulting to
   * WMO `0`, which means "clear sky".
   */
  async function loadWeather(lat: number, lon: number) {
    try {
      const url =
        `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
        `&current=temperature_2m,weather_code`
      const response = await fetch(url, { signal: AbortSignal.timeout(5000) })
      if (!response.ok) return
      const current = (await response.json())?.current

      const temp = current?.temperature_2m
      if (typeof temp === 'number' && tempEl) {
        tempEl.textContent = `${toBn(Math.round(temp))}°`
      }

      const label = weatherLabel(current?.weather_code)
      if (label && condEl) condEl.textContent = label
      // Minimal ribbon (owner request): the button shows city + temp only;
      // the full condition surfaces as the browser hover tooltip.
      const weatherBtn = el('hw-weather')
      if (weatherBtn && label) weatherBtn.title = `আবহাওয়া: ${label}`

      markReady(el('hw-weather'))
    } catch {
      // Keep the placeholder — a failed lookup must not blank the widget.
    }
  }

  function applyLocation(lat: number, lon: number, label: string, remember: boolean) {
    if (cityEl) cityEl.textContent = label
    if (locationSelect) {
      const value = `${lat},${lon}`
      const known = CITIES.some((c) => `${c.lat},${c.lon}` === value)
      locationSelect.value = known ? value : ''
    }
    if (remember) {
      storeLocation({ labelBn: label, lat, lon, source: 'user' })
    }
    lastPrayerPoint = null
    // A disabled widget is not in the DOM, so its nodes are null and there is
    // neither anything to fill nor a reason to spend a request on it. Checking
    // the elements avoids threading the feature flags into this module.
    if (nextTimeEl) void loadPrayer(lat, lon)
    if (tempEl) void loadWeather(lat, lon)
  }

  /** Prayer dropdown. */
  // Hover opens the schedule too — the ribbon shows only the next start
  // time, so the panel is where the detail lives (owner request: minimal
  // by default, more on hover). Click still works for touch readers.
  const openPanel = () => {
    if (!prayerPanel || !prayerBtn) return
    prayerPanel.removeAttribute('hidden')
    prayerBtn.setAttribute('aria-expanded', 'true')
    if (lastPrayerPoint) void loadHijriOnce(lastPrayerPoint.lat, lastPrayerPoint.lon)
  }
  const closePanel = () => {
    if (!prayerPanel || !prayerBtn) return
    prayerPanel.setAttribute('hidden', '')
    prayerBtn.setAttribute('aria-expanded', 'false')
  }
  prayerBtn?.addEventListener('mouseenter', openPanel)
  prayerBtn?.addEventListener('focus', openPanel)
  prayerBtn?.addEventListener('mouseleave', () => {
    if (prayerPanel && !prayerPanel.matches(':hover')) closePanel()
  })
  prayerPanel?.addEventListener('mouseleave', closePanel)
  prayerBtn?.addEventListener('click', () => {
    if (!prayerPanel) return
    const open = prayerPanel.hasAttribute('hidden')
    if (open) prayerPanel.removeAttribute('hidden')
    else prayerPanel.setAttribute('hidden', '')
    prayerBtn.setAttribute('aria-expanded', String(open))
    if (open && lastPrayerPoint) {
      void loadHijriOnce(lastPrayerPoint.lat, lastPrayerPoint.lon)
    }
  })

  document.addEventListener('click', (event) => {
    if (!prayerPanel || !prayerBtn) return
    const target = event.target as Node
    if (!prayerBtn.contains(target) && !prayerPanel.contains(target)) {
      prayerPanel.setAttribute('hidden', '')
      prayerBtn.setAttribute('aria-expanded', 'false')
    }
  })

  /** Resolve the reader's location, then refresh both widgets. */
  async function init() {
    const stored = readStoredLocation()

    if (stored) {
      applyLocation(stored.lat, stored.lon, stored.labelBn, false)
      return
    }

    const detected = await detectLocationByIp()
    if (detected) {
      applyLocation(detected.lat, detected.lon, detected.labelBn, false)
      storeLocation(detected)
      return
    }

    const fallback = getDefaultLocation()
    applyLocation(fallback.lat, fallback.lon, fallback.labelBn, false)
  }

  locationSelect?.addEventListener('change', () => {
    const value = locationSelect.value
    if (!value) {
      // "সনাক্ত করুন" — try a fresh IP lookup.
      void detectLocationByIp().then((detected) => {
        const loc = detected ?? getDefaultLocation()
        applyLocation(loc.lat, loc.lon, loc.labelBn, true)
      })
      return
    }
    const [lat, lon] = value.split(',').map(Number)
    const city = nearestCity(lat, lon)
    applyLocation(lat, lon, city?.labelBn ?? 'আপনার এলাকা', true)
  })

  // Deferred: never compete with first paint.
  //
  // ⚠️ The capability is read off a *separate* binding on purpose. Testing
  // `'requestIdleCallback' in window` narrows `window` itself, and in the else
  // branch TypeScript narrows it all the way to `never` — which silently
  // disables type checking on every later use of `window` in this scope.
  const idle = window as Window & { requestIdleCallback?: (cb: () => void) => void }
  if (typeof idle.requestIdleCallback === 'function') {
    idle.requestIdleCallback(() => void init())
  } else {
    window.addEventListener('load', () => void init())
  }
</script>