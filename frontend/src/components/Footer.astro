---
/**
 * Site footer.
 *
 * Three responsive zones:
 *   1. Top — brand wordmark + tagline + contact
 *   2. Middle — category links + footer pages (from CMS) + social links
 *   3. Bottom — copyright + legal links
 *
 * The footer text is CMS-managed (SiteSettings.footerText) so the owner can
 * update it without a code change.
 */
import Logo from './Logo.astro'
import NewsletterSignup from './NewsletterSignup.astro'
import type { CmsSiteSettings, CmsCategory, CmsPage } from '../lib/cms'
import { getPublicCmsOrigin } from '../lib/interactive'

interface Props {
  settings: CmsSiteSettings
  categories: CmsCategory[]
  footerPages?: CmsPage[]
}

const { settings, categories, footerPages = [] } = Astro.props

const currentYear = new Date().getFullYear()

const socialLinks = Object.entries(settings.social ?? {}).filter(([, url]) => !!url)

/**
 * The newsletter form posts to the CMS from the browser, so it needs the
 * browser-reachable origin. `null` when unconfigured, in which case
 * `NewsletterSignup` renders nothing at all.
 */
const cmsOrigin = getPublicCmsOrigin()
---

<footer class="border-t border-rule bg-surface-raised dark:border-dark-rule dark:bg-dark-surface">
  {/* ── Top zone: brand ─────────────────────────────────────────────── */}
  <div class="container-page py-10">
    <div class="grid-12 items-start">
      {/* Brand */}
      <div class="col-span-4 sm:col-span-8 lg:col-span-4">
        <Logo siteName={settings.siteName} siteNameEn={settings.siteNameEn} logo={settings.logo} />
        {settings.tagline && (
          <p class="mt-3 text-sm text-ink-muted dark:text-dark-ink-muted">{settings.tagline}</p>
        )}

        {/* Self-hiding: renders only when there is a CMS to subscribe against.
            Deliberately a sibling of the tagline, not a child of its conditional
            — whether a newsletter is offered must not depend on whether the
            owner filled in a tagline. */}
        <NewsletterSignup cmsOrigin={cmsOrigin} />
        {/* Full contact block. The CMS stores all three; the footer must show
            all three — an address or phone the owner enters has to appear, or
            editing it looks broken. */}
        <address class="mt-3 space-y-1 text-sm not-italic text-ink-muted dark:text-dark-ink-muted">
          {settings.contact?.address && (
            <p class="whitespace-pre-line">{settings.contact.address}</p>
          )}
          {settings.contact?.phone && (
            <p>
              <a
                href={`tel:${settings.contact.phone.replace(/\s+/g, '')}`}
                class="underline decoration-rule underline-offset-2 transition-colors hover:text-brand-red dark:decoration-dark-rule"
              >
                {settings.contact.phone}
              </a>
            </p>
          )}
          {settings.contact?.email && (
            <p>
              <a
                href={`mailto:${settings.contact.email}`}
                class="underline decoration-rule underline-offset-2 transition-colors hover:text-brand-red dark:decoration-dark-rule"
              >
                {settings.contact.email}
              </a>
            </p>
          )}
        </address>

        {/* E-E-A-T legal block — shown when the owner has supplied it. */}
        {
          (settings.legal?.tradeLicense ||
            settings.legal?.tin ||
            settings.legal?.ministryRegistration) && (
            <dl class="mt-3 space-y-0.5 text-xs text-ink-subtle dark:text-dark-ink-muted">
              {settings.legal?.tradeLicense && (
                <div class="flex gap-1.5">
                  <dt>ট্রেড লাইসেন্স:</dt>
                  <dd>{settings.legal.tradeLicense}</dd>
                </div>
              )}
              {settings.legal?.tin && (
                <div class="flex gap-1.5">
                  <dt>টিআইএন:</dt>
                  <dd>{settings.legal.tin}</dd>
                </div>
              )}
              {settings.legal?.ministryRegistration && (
                <div class="flex gap-1.5">
                  <dt>নিবন্ধন:</dt>
                  <dd>{settings.legal.ministryRegistration}</dd>
                </div>
              )}
            </dl>
          )
        }
      </div>

      {/* Category links */}
      <div class="col-span-4 mt-8 sm:col-span-4 sm:mt-0 lg:col-span-3 lg:col-start-6">
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
          বিভাগ
        </h3>
        <ul class="space-y-2">
          {
            categories.map((cat) => (
              <li>
                <a
                  href={`/category/${cat.slug}`}
                  class="text-sm text-ink-muted transition-colors hover:text-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
                >
                  {cat.nameBn}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Footer pages + social */}
      <div class="col-span-4 mt-8 sm:col-span-4 sm:mt-0 lg:col-span-3">
        {footerPages.length > 0 && (
          <>
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
              আমাদের সম্পর্কে
            </h3>
            <ul class="space-y-2">
              {footerPages.map((page) => (
                <li>
                  <a
                    href={`/page/${page.slug}`}
                    class="text-sm text-ink-muted transition-colors hover:text-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
                  >
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        {socialLinks.length > 0 && (
          <div class="mt-6">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
              সোশ্যাল মিডিয়া
            </h3>
            <div class="flex flex-wrap gap-3">
              {socialLinks.map(([platform, url]) => (
                <a
                  href={url!}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-1.5 text-sm text-ink-muted shadow-sm transition-colors hover:text-brand-red dark:bg-dark-raised dark:text-dark-ink-muted dark:hover:text-brand-red"
                  aria-label={platform}
                >
                  {platform}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {/* ── Bottom zone: copyright ──────────────────────────────────────── */}
  <div class="border-t border-rule dark:border-dark-rule">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-5 sm:flex-row">
      <p class="text-center text-xs text-ink-subtle dark:text-dark-ink-muted">
        © {currentYear} {settings.siteName}। সর্বস্বত্ব সংরক্ষিত।
      </p>
      <nav aria-label="আইনি লিংক">
        <ul class="flex flex-wrap items-center justify-center gap-4 text-xs">
          <li>
            <a
              href="/page/privacy-policy"
              class="text-ink-subtle underline decoration-transparent underline-offset-2 transition-colors hover:text-brand-red hover:decoration-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
            >
              গোপনীয়তা নীতি
            </a>
          </li>
          <li>
            <a
              href="/page/terms-of-use"
              class="text-ink-subtle underline decoration-transparent underline-offset-2 transition-colors hover:text-brand-red hover:decoration-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
            >
              ব্যবহারের শর্তাবলী
            </a>
          </li>
          <li>
            <a
              href="/page/contact"
              class="text-ink-subtle underline decoration-transparent underline-offset-2 transition-colors hover:text-brand-red hover:decoration-brand-red dark:text-dark-ink-muted dark:hover:text-brand-red"
            >
              যোগাযোগ
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  {settings.footerText && (
    <div class="border-t border-rule bg-surface dark:border-dark-rule dark:bg-dark-base">
      <div class="container-page py-4">
        <p class="text-center text-xs text-ink-subtle dark:text-dark-ink-muted">{settings.footerText}</p>
      </div>
    </div>
  )}
</footer>
