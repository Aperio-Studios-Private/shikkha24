---
/**
 * Site header.
 *
 * Three horizontal bands:
 *   1. Utility ribbon — date, widgets (weather, prayer), search, text resizer,
 *      theme toggle, social links
 *   2. Main header — logo + main navigation in one row
 *   3. Mobile menu drawer — collapsed navigation for small screens
 *
 * Responsive: on mobile the main nav collapses to a hamburger menu and the
 * utility ribbon keeps only the essential controls.
 */
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.astro'
import TextResizer from './TextResizer.astro'
import type { CmsSiteSettings, CmsCategory } from '../lib/cms'
import { isEnabled } from '../lib/feature-flags'
import { formatBanglaDate, formatBnBd } from '../lib/bangla-date'
import { formatHijriDate } from '../lib/hijri-date'
import SocialLinks from './SocialLinks.astro'
import HeaderWidgets from './HeaderWidgets.astro'

interface Props {
  settings: CmsSiteSettings
  categories: CmsCategory[]
}

const { settings, categories } = Astro.props

/**
 * The weather and prayer flags still gate the widgets — but they no longer gate
 * a build-time fetch. Both widgets render a neutral placeholder and resolve the
 * reader's own location in the browser, because a build can only ever know one
 * city. See `lib/widgets.ts` for why that moved.
 */
const showWeather = isEnabled('weatherWidget')
const showPrayer = isEnabled('prayerWidget')

/*
 * Bengali date — the masthead shows ALL THREE calendars, as a Bengali newspaper does:
 *   বঙ্গাব্দ      ২৮ ভাদ্র, ১৪৩৩      (what readers mean by "the Bengali date")
 *   খ্রিস্টাব্দ   ১২ সেপ্টেম্বর, ২০২৬  (familiar for deadlines and official dates)
 *   হিজরি      ৬ই জমাদিউল আউয়াল, ১৪৪৮  (the Islamic date, added by owner request)
 *
 * `toLocaleDateString('bn-BD')` alone is NOT enough — that is the Gregorian
 * date in Bengali digits, which is not what a masthead is expected to show.
 *
 * With `output: 'static'` any date minted here is BAKED IN at build time — the
 * masthead would show the build day forever (owner reported exactly that on
 * 2026-10-17). The frontmatter strings below stay as the no-JS/SEO fallback;
 * the module script at the bottom recomputes both lines on every view, in
 * Asia/Dhaka via `../lib/bangla-date`.
 */
const now = new Date()
const banglaDate = formatBanglaDate(now)
const gregorianDate = formatBnBd(now, { year: 'numeric', month: 'long', day: 'numeric' })
const hijriDate = formatHijriDate(now)
---

<header class="border-b border-rule bg-surface dark:border-dark-rule dark:bg-dark-base">
  {/* ── 1. Utility ribbon ───────────────────────────────────────────── */}
  <div class="border-b border-rule bg-surface-raised dark:border-dark-rule dark:bg-dark-surface">
    <div class="container-page flex items-center justify-between gap-3 py-1.5">
      {/* Date + optional widgets */}
      <div class="flex min-w-0 items-center gap-2 text-xs text-ink-muted dark:text-dark-ink-muted">
        <time id="masthead-date" datetime={now.toISOString()} class="font-ui whitespace-nowrap">
          {banglaDate}
          <span class="hidden text-ink-subtle sm:inline dark:text-dark-ink-muted"> · {gregorianDate}</span>
          <span class="hidden text-ink-subtle sm:inline dark:text-dark-ink-muted"> · {hijriDate}</span>
        </time>

        {/* Weather, prayer and location. Each renders a neutral placeholder and
            resolves the reader's own location in the browser. */}
        <div class="hidden sm:block">
          <HeaderWidgets showWeather={showWeather} showPrayer={showPrayer} />
        </div>
      </div>

      {/* Reader tools + social links */}
      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        {/* Search (icon-only on mobile, expands on focus) */}
        <form
          action="/search"
          method="get"
          class="relative flex items-center"
          role="search"
          aria-label="সাইটে খুঁজুন"
        >
          <input
            type="search"
            name="q"
            placeholder="খবর খুঁজুন"
            class="h-8 w-8 rounded-md border border-transparent bg-transparent pl-8 text-sm text-ink placeholder:text-ink-subtle transition-all focus:w-40 focus:border-rule focus:bg-surface focus:outline-none sm:w-44 sm:pl-8 dark:text-dark-ink dark:focus:border-dark-rule dark:focus:bg-dark-surface"
            aria-label="খুঁজুন"
          />
          <svg
            class="pointer-events-none absolute left-2 text-ink-subtle dark:text-dark-ink-muted"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </form>

        {/* Text resizer — hidden on very small screens */}
        <div class="hidden sm:block">
          <TextResizer />
        </div>

        {/* Theme toggle */}
        <ThemeToggle />

        {/* Official social accounts — desktop only; the mobile drawer carries
            the same links, so nothing is lost on a small screen. */}
        <SocialLinks social={settings.social} variant="header" />
      </div>
    </div>
  </div>

  {/* ── 2. Main header row: logo + navigation ───────────────────────── */}
  <div class="container-page flex items-center justify-between gap-4 py-3 sm:py-4">
    {/* Logo */}
    <Logo
      siteName={settings.siteName}
      logo={settings.logo}
      showNameWithLogo={settings.showNameWithLogo}
    />

    {/* Main navigation — desktop */}
    <nav class="hidden items-center gap-1 sm:flex" aria-label="প্রধান মেনু">
      <a
        href="/"
        class="inline-block px-3 py-2.5 text-sm font-medium text-ink transition-colors hover:text-brand-red dark:text-dark-ink dark:hover:text-brand-red"
      >
        হোম
      </a>
      {
        categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="inline-block px-3 py-2.5 text-sm font-medium text-ink transition-colors hover:text-brand-red dark:text-dark-ink dark:hover:text-brand-red"
          >
            {cat.nameBn}
          </a>
        ))
      }
    </nav>

    {/* Mobile hamburger */}
    <button
      type="button"
      id="mobile-menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink sm:hidden dark:text-dark-ink-muted dark:hover:bg-dark-raised dark:hover:text-dark-ink"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="মেনু খুলুন"
    >
      <svg
        id="hamburger-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg
        id="close-menu-icon"
        class="hidden"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  {/* ── 3. Mobile menu (drawer) ─────────────────────────────────────── */}
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden bg-black/50 sm:hidden"
    aria-hidden="true"
  >
    <div
      class="absolute right-0 top-0 h-full w-72 overflow-y-auto border-l border-rule bg-surface shadow-xl dark:border-dark-rule dark:bg-dark-surface"
      role="dialog"
      aria-modal="true"
      aria-label="প্রধান মেনু"
    >
      <div class="flex items-center justify-between border-b border-rule px-4 py-3 dark:border-dark-rule">
        <span class="font-headline text-lg font-bold">{settings.siteName}</span>
        <button
          type="button"
          id="mobile-menu-close"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink-muted dark:text-dark-ink-muted"
          aria-label="মেনু বন্ধ করুন"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="px-4 py-3">
        <TextResizer />
      </div>

      <ul class="border-t border-rule px-4 py-2 dark:border-dark-rule">
        <li>
          <a href="/" class="block py-2.5 text-base font-medium text-ink dark:text-dark-ink">হোম</a>
        </li>
        {
          categories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}`}
                class="block py-2.5 text-base font-medium text-ink dark:text-dark-ink"
              >
                {cat.nameBn}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Education tools — the S10 specialised sections */}
      <div class="border-t border-rule px-4 py-2 dark:border-dark-rule">
        <h2 class="mb-1 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
          শিক্ষা সেবা
        </h2>
        <ul>
          <li><a href="/scholarships" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বৃত্তি</a></li>
          <li><a href="/results" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">ফলাফল</a></li>
          <li><a href="/institutions" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">প্রতিষ্ঠান</a></li>
          <li><a href="/circulars" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বিজ্ঞপ্তি</a></li>
          <li><a href="/study-abroad" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বিদেশে পড়াশোনা</a></li>
          <li><a href="/exams" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">পরীক্ষার রুটিন</a></li>
          <li><a href="/gpa" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">জিপিএ ক্যালকুলেটর</a></li>
          <li><a href="/cgpa" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">সিজিপিএ ক্যালকুলেটর</a></li>
        </ul>
      </div>

      {/* The same official accounts as the desktop ribbon, with labels — there
          is room for words in the drawer, and a bare glyph is ambiguous. */}
      <SocialLinks social={settings.social} variant="drawer" />
    </div>
  </div>
</header>

<script>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle')
    const close = document.getElementById('mobile-menu-close')
    const drawer = document.getElementById('mobile-menu')
    const hamburger = document.getElementById('hamburger-icon')
    const closeIcon = document.getElementById('close-menu-icon')

    function open() {
      if (!drawer) return
      drawer.classList.remove('hidden')
      drawer.setAttribute('aria-hidden', 'false')
      toggle?.setAttribute('aria-expanded', 'true')
      hamburger?.classList.add('hidden')
      closeIcon?.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      if (!drawer) return
      drawer.classList.add('hidden')
      drawer.setAttribute('aria-hidden', 'true')
      toggle?.setAttribute('aria-expanded', 'false')
      hamburger?.classList.remove('hidden')
      closeIcon?.classList.add('hidden')
      document.body.style.overflow = ''
    }

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true'
      if (expanded) closeMenu()
      else open()
    })

    close?.addEventListener('click', closeMenu)

    // Close on backdrop click.
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) closeMenu()
    })

    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu()
    })
  })()
</script>

<script>
  // The masthead dates are prerendered with output:'static', so the shipped HTML
  // shows the build day forever. Recompute all three calendar lines from the
  // reader's clock in Asia/Dhaka on every view; the prerendered text remains
  // the fallback for no-JS crawlers.
  import { formatHijriDate } from '../lib/hijri-date'
  import { formatBanglaDate, formatBnBd } from '../lib/bangla-date'

  const masthead = document.getElementById('masthead-date');
  if (masthead) {
    const now = new Date();
    const bangla = formatBanglaDate(now);
    const gregorian = formatBnBd(now, { year: 'numeric', month: 'long', day: 'numeric' });
    const hijri = formatHijriDate(now);
    masthead.setAttribute('datetime', now.toISOString());
    const extraClass = 'hidden text-ink-subtle sm:inline dark:text-dark-ink-muted';
    const gregorianSpan = document.createElement('span');
    gregorianSpan.className = extraClass;
    gregorianSpan.textContent = ` · ${gregorian}`;
    const hijriSpan = document.createElement('span');
    hijriSpan.className = extraClass;
    hijriSpan.textContent = ` · ${hijri}`;
    masthead.replaceChildren(bangla, gregorianSpan, hijriSpan);
  }
</script>
