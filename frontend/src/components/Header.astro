---
/**
 * Site header.
 *
 * Three horizontal bands:
 *   1. Utility ribbon — date, widgets (weather, prayer), search, text resizer,
 *      theme toggle, social links
 *   2. Main header — logo + main navigation in one row
 *   3. Mobile menu drawer — collapsed navigation for small screens
 *
 * Responsive: on mobile the main nav collapses to a hamburger menu and the
 * utility ribbon keeps only the essential controls.
 */
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.astro'
import TextResizer from './TextResizer.astro'
import type { CmsSiteSettings, CmsCategory } from '../lib/cms'
import { isEnabled } from '../lib/feature-flags'
import { formatBanglaDate, formatBnBd } from '../lib/bangla-date'
import { formatHijriDate } from '../lib/hijri-date'
import SocialLinks from './SocialLinks.astro'
import HeaderWidgets from './HeaderWidgets.astro'

interface Props {
  settings: CmsSiteSettings
  categories: CmsCategory[]
}

const { settings, categories } = Astro.props

/**
 * The weather and prayer flags still gate the widgets — but they no longer gate
 * a build-time fetch. Both widgets render a neutral placeholder and resolve the
 * reader's own location in the browser, because a build can only ever know one
 * city. See `lib/widgets.ts` for why that moved.
 */
const showWeather = isEnabled('weatherWidget')
const showPrayer = isEnabled('prayerWidget')

/*
 * Bengali date — the masthead shows ALL THREE calendars, as a Bengali newspaper does:
 *   বঙ্গাব্দ      ২৮ ভাদ্র, ১৪৩৩      (what readers mean by "the Bengali date")
 *   খ্রিস্টাব্দ   ১২ সেপ্টেম্বর, ২০২৬  (familiar for deadlines and official dates)
 *   হিজরি      ৬ই জমাদিউল আউয়াল, ১৪৪৮  (the Islamic date, added by owner request)
 *
 * `toLocaleDateString('bn-BD')` alone is NOT enough — that is the Gregorian
 * date in Bengali digits, which is not what a masthead is expected to show.
 *
 * With `output: 'static'` any date minted here is BAKED IN at build time — the
 * masthead would show the build day forever (owner reported exactly that on
 * 2026-10-17). The frontmatter strings below stay as the no-JS/SEO fallback;
 * the module script at the bottom recomputes both lines on every view, in
 * Asia/Dhaka via `../lib/bangla-date`.
 */
const now = new Date()
const banglaDate = formatBanglaDate(now)
const gregorianDate = formatBnBd(now, { year: 'numeric', month: 'long', day: 'numeric' })
const hijriDate = formatHijriDate(now)
// Weekday for the permanent slot — formatBanglaDate begins with it, so reuse
// the same source instead of a second formatter that could disagree.
const weekdayBn = banglaDate.split(',')[0] ?? ''
// The flip slot shows the Bangla CALENDAR date (no weekday — the weekday lives
// in the permanent slot, so it never repeats).
const banglaCalendar = banglaDate.split(',').slice(1).join(',').trim()
---

<header class="relative border-b border-rule bg-surface dark:border-dark-rule dark:bg-dark-base">
  {/* ── 1. Utility ribbon ───────────────────────────────────────────── */}
  <div class="border-b border-rule bg-surface-raised dark:border-dark-rule dark:bg-dark-surface">
    <div class="container-page flex items-center justify-between gap-4 py-2">
      {/* Date + optional widgets. DATE DISPLAY (owner request, 2026-10-28):
          the Gregorian date stays PERMANENTLY visible; the Bangla and Hijri
          dates take turns in a flipping slot beside it — one line always. */}
      <div class="flex min-w-0 items-center gap-2 whitespace-nowrap text-xs text-ink-muted dark:text-dark-ink-muted">
        <time
          id="masthead-date"
          datetime={now.toISOString()}
          class="font-ui inline-flex h-5 items-center align-middle"
        >
          <span class="whitespace-nowrap text-ink dark:text-dark-ink">
            {weekdayBn}, {gregorianDate}
          </span>
          {/* Flip slot: width = the LONGER of the two strings (measured server-
              side via ch), so the longest Hijri month name never truncates.
              MOBILE (owner request): hidden below sm — phones show only the
              weekday + Gregorian date, no Bangla/Hijri flip. */}
          <span
            class="relative mx-1 hidden h-5 overflow-hidden align-middle sm:inline-block"
            style={`width:${Math.max(banglaDate.length, hijriDate.length)}ch`}
          >
            <span class="date-flip absolute inset-0 block whitespace-nowrap" data-slot="0">{banglaCalendar}</span>
            <span class="date-flip absolute inset-0 block whitespace-nowrap" data-slot="1" hidden>{hijriDate}</span>
          </span>
        </time>

        {/* Weather, prayer and location. Each renders a neutral placeholder and
            resolves the reader's own location in the browser. */}
        <div class="hidden min-w-0 sm:block">
          <HeaderWidgets showWeather={showWeather} showPrayer={showPrayer} />
        </div>
      </div>

      {/* Reader tools + social links */}
      <div class="flex shrink-0 items-center gap-1 sm:gap-2">
        {/* Search — single icon button (owner request); clicking opens a
            lightweight overlay with the full search form. The overlay is a
            regular /search redirect, so no JS search index is needed. */}
        <button
          type="button"
          id="search-toggle"
          class="inline-flex h-12 w-12 items-center justify-center rounded-md text-ink-subtle transition-colors hover:bg-surface-raised hover:text-brand-red dark:text-dark-ink-muted dark:hover:bg-dark-raised"
          aria-label="খবর খুঁজুন"
          aria-expanded="false"
          aria-controls="search-overlay"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
        <div
          id="search-overlay"
          hidden
          class="absolute inset-x-0 top-full z-50 border-b border-rule bg-surface p-3 shadow-lg dark:border-dark-rule dark:bg-dark-surface"
        >
          <form action="/search" method="get" role="search" class="mx-auto flex max-w-6xl items-center gap-2 px-4">
            <input
              type="search"
              id="search-overlay-input"
              name="q"
              placeholder="খবর খুঁজুন..."
              autocomplete="off"
              class="h-12 w-full rounded-md border border-rule bg-surface px-3 text-sm text-ink placeholder:text-ink-subtle focus:border-brand-red focus:outline-none dark:border-dark-rule dark:bg-dark-surface dark:text-dark-ink"
              aria-label="খুঁজুন"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-suggestions"
            />
            <button
              type="submit"
              class="h-12 shrink-0 rounded-md bg-brand-red px-4 text-sm font-medium text-white hover:opacity-90"
            >
              খুঁজুন
            </button>
          </form>
          {/* Live suggestions + recent searches. Populated by the script below:
              typing queries the same Pagefind index /search uses; with an
              empty box, the reader's recent searches (localStorage) show. */}
          <div class="mx-auto max-w-6xl px-4">
            <ul
              id="search-suggestions"
              class="mt-2 hidden overflow-hidden rounded-md border border-rule bg-surface text-sm dark:border-dark-rule dark:bg-dark-surface"
              role="listbox"
            >
            </ul>
          </div>
        </div>

        {/* Text resizer — hidden on very small screens */}
        <div class="hidden sm:block">
          <TextResizer />
        </div>

        {/* Theme toggle */}
        <ThemeToggle />

        {/* Official social accounts — desktop only; the mobile drawer carries
            the same links, so nothing is lost on a small screen. */}
        <SocialLinks social={settings.social} variant="header" />
      </div>
    </div>
  </div>

  {/* ── 2. Main header row: logo + navigation ───────────────────────── */}
  <div class="container-page flex items-center justify-between gap-4 py-3 sm:py-4">
    {/* Logo */}
    <Logo
      siteName={settings.siteName}
      logo={settings.logo}
      showNameWithLogo={settings.showNameWithLogo}
    />

    {/* Main navigation — desktop */}
    <nav class="hidden items-center gap-1 sm:flex" aria-label="প্রধান মেনু">
      <a
        href="/"
        class="inline-block px-3 py-2.5 text-sm font-medium text-ink transition-colors hover:text-brand-red dark:text-dark-ink dark:hover:text-brand-red"
      >
        হোম
      </a>
      {
        categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="inline-block px-3 py-2.5 text-sm font-medium text-ink transition-colors hover:text-brand-red dark:text-dark-ink dark:hover:text-brand-red"
          >
            {cat.nameBn}
          </a>
        ))
      }
    </nav>

    {/* Mobile hamburger */}
    <button
      type="button"
      id="mobile-menu-toggle"
      class="inline-flex h-12 w-12 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface-raised hover:text-ink sm:hidden dark:text-dark-ink-muted dark:hover:bg-dark-raised dark:hover:text-dark-ink"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="মেনু খুলুন"
    >
      <svg
        id="hamburger-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg
        id="close-menu-icon"
        class="hidden"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  {/* ── 3. Mobile menu (drawer) ─────────────────────────────────────── */}
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden bg-black/50 sm:hidden"
    aria-hidden="true"
  >
    <div
      class="absolute right-0 top-0 h-full w-72 overflow-y-auto border-l border-rule bg-surface shadow-xl dark:border-dark-rule dark:bg-dark-surface"
      role="dialog"
      aria-modal="true"
      aria-label="প্রধান মেনু"
    >
      <div class="flex items-center justify-between border-b border-rule px-4 py-3 dark:border-dark-rule">
        <span class="font-headline text-lg font-bold">{settings.siteName}</span>
        <button
          type="button"
          id="mobile-menu-close"
          class="inline-flex h-12 w-12 items-center justify-center rounded-md text-ink-muted dark:text-dark-ink-muted"
          aria-label="মেনু বন্ধ করুন"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="flex items-center justify-between gap-2 px-4 py-3">
        <TextResizer />
        {/* Search row in the drawer (mobile audit M3): a drawer user should
            not have to close the menu to search. Links to /search — simple,
            works without JS. */}
        <a
          href="/search"
          class="inline-flex min-h-12 items-center gap-2 rounded-md border border-rule px-3 text-sm font-medium text-ink hover:border-brand-red hover:text-brand-red dark:border-dark-rule dark:text-dark-ink"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          খবর খুঁজুন
        </a>
      </div>

      <ul class="border-t border-rule px-4 py-2 dark:border-dark-rule">
        <li>
          <a href="/" class="block py-2.5 text-base font-medium text-ink dark:text-dark-ink">হোম</a>
        </li>
        {
          categories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}`}
                class="block py-2.5 text-base font-medium text-ink dark:text-dark-ink"
              >
                {cat.nameBn}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Education tools — the S10 specialised sections */}
      <div class="border-t border-rule px-4 py-2 dark:border-dark-rule">
        <h2 class="mb-1 text-xs font-semibold uppercase tracking-wide text-ink-subtle dark:text-dark-ink-muted">
          শিক্ষা সেবা
        </h2>
        <ul>
          <li><a href="/scholarships" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বৃত্তি</a></li>
          <li><a href="/results" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">ফলাফল</a></li>
          <li><a href="/institutions" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">প্রতিষ্ঠান</a></li>
          <li><a href="/circulars" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বিজ্ঞপ্তি</a></li>
          <li><a href="/study-abroad" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">বিদেশে পড়াশোনা</a></li>
          <li><a href="/exams" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">পরীক্ষার রুটিন</a></li>
          <li><a href="/gpa" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">জিপিএ ক্যালকুলেটর</a></li>
          <li><a href="/cgpa" class="block py-2 text-sm font-medium text-ink dark:text-dark-ink">সিজিপিএ ক্যালকুলেটর</a></li>
        </ul>
      </div>

      {/* The same official accounts as the desktop ribbon, with labels — there
          is room for words in the drawer, and a bare glyph is ambiguous. */}
      <SocialLinks social={settings.social} variant="drawer" />
    </div>
  </div>
</header>

<script>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle')
    const close = document.getElementById('mobile-menu-close')
    const drawer = document.getElementById('mobile-menu')
    const hamburger = document.getElementById('hamburger-icon')
    const closeIcon = document.getElementById('close-menu-icon')

    function open() {
      if (!drawer) return
      drawer.classList.remove('hidden')
      drawer.setAttribute('aria-hidden', 'false')
      toggle?.setAttribute('aria-expanded', 'true')
      hamburger?.classList.add('hidden')
      closeIcon?.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      if (!drawer) return
      drawer.classList.add('hidden')
      drawer.setAttribute('aria-hidden', 'true')
      toggle?.setAttribute('aria-expanded', 'false')
      hamburger?.classList.remove('hidden')
      closeIcon?.classList.add('hidden')
      document.body.style.overflow = ''
    }

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true'
      if (expanded) closeMenu()
      else open()
    })

    close?.addEventListener('click', closeMenu)

    // Close on backdrop click.
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) closeMenu()
    })

    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu()
    })
  })()
</script>

<script>
  // The masthead dates are prerendered with output:'static', so the shipped HTML
  // shows the build day forever. Recompute all three calendar lines from the
  // reader's clock in Asia/Dhaka on every view; the prerendered text remains
  // the fallback for no-JS crawlers.
  //
  // ROTATING TICKER (owner request): one date visible at a time — each holds
  // ~2s, slides up out, and the next slides in, cycling Bangla → Gregorian →
  // Hijri. The three spans are the slots; the recomputed strings replace their
  // text so a reader who keeps the tab open never sees a stale day.
  import { formatHijriDate } from '../lib/hijri-date'
  import { formatBanglaDate, formatBnBd } from '../lib/bangla-date'

  const masthead = document.getElementById('masthead-date');
  if (masthead) {
    const now = new Date();
    masthead.setAttribute('datetime', now.toISOString());
    // The Gregorian date is permanent markup; only the flip slot rotates.
    const slots = masthead.querySelectorAll('.date-flip');
    const texts = [formatBanglaDate(now), formatHijriDate(now)];
    slots.forEach((slot, i) => {
      slot.textContent = texts[i] ?? '';
    });

    let current = 0;
    const HOLD_MS = 2500;
    setInterval(() => {
      const outgoing = slots[current];
      const incoming = slots[(current + 1) % slots.length];
      outgoing.classList.add('date-flip--out');
      window.setTimeout(() => {
        outgoing.setAttribute('hidden', '');
        outgoing.classList.remove('date-flip--out');
        incoming.classList.add('date-flip--in');
        incoming.removeAttribute('hidden');
        void incoming.offsetWidth;
        incoming.classList.remove('date-flip--in');
        current = (current + 1) % slots.length;
      }, 220);
    }, HOLD_MS);
  }
</script>

<script>
  // Search overlay — the ribbon carries one icon button; clicking reveals the
  // full search form. Escape / outside-click / focus-out all close it.
  const toggle = document.getElementById('search-toggle');
  const overlay = document.getElementById('search-overlay');
  if (toggle && overlay) {
    const input = overlay.querySelector('input');
    const setOpen = (open: boolean) => {
      overlay.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input?.focus();
    };
    toggle.addEventListener('click', () => {
      setOpen(overlay.hasAttribute('hidden'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!overlay.hasAttribute('hidden') && !overlay.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });

    // ── Interactive suggestions + recent searches (owner request) ──────────
    // Typing queries the SAME Pagefind index /search uses (loaded lazily on
    // first open — one small wasm fetch, cached afterwards). An empty box
    // shows the reader's recent searches from localStorage, each clickable.
    const RECENT_KEY = 'shikkha24-recent-searches';
    const list = document.getElementById('search-suggestions');

    const readRecent = (): string[] => {
      try {
        const raw = localStorage.getItem(RECENT_KEY);
        const arr = raw ? (JSON.parse(raw) as unknown) : [];
        return Array.isArray(arr) ? arr.filter((v): v is string => typeof v === 'string').slice(0, 5) : [];
      } catch {
        return [];
      }
    };

    const renderRecent = () => {
      if (!list) return;
      const recent = readRecent();
      if (recent.length === 0) {
        list.setAttribute('hidden', '');
        return;
      }
      list.innerHTML = recent
        .map(
          (q) =>
            `<li><a href="/search?q=${encodeURIComponent(q)}" class="flex items-center gap-2 px-3 py-2 hover:bg-surface-raised dark:hover:bg-dark-raised"><span aria-hidden class="text-ink-subtle dark:text-dark-ink-muted">🕘</span>${q}</a></li>`,
        )
        .join('');
      list.removeAttribute('hidden');
    };

    // Pagefind is loaded by INJECTING a script tag, not a dynamic import.
    // Astro's build wraps dynamic imports in its own importModule helper,
    // which cannot load the post-build /pagefind asset (the production
    // suggestion regression). A script tag is bundler-invisible and matches
    // the proven /search pattern.
    let pagefindPromise: Promise<any> | null = null;
    const loadPagefind = (): Promise<any> => {
      if (pagefindPromise) return pagefindPromise;
      pagefindPromise = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = '/pagefind/pagefind.js';
        s.onload = () => resolve((window as any).pagefind);
        s.onerror = () => reject(new Error('pagefind failed to load'));
        document.head.appendChild(s);
      });
      return pagefindPromise;
    };

    const renderSuggestions = async (q: string) => {
      if (!list) return;
      if (q.trim().length < 2) {
        renderRecent();
        return;
      }
      try {
        const pf = await loadPagefind();
        const search = await pf.debouncedSearch(q, {}, 500);
        const results = (search?.results ?? []).slice(0, 5);
        if (results.length === 0) {
          list.setAttribute('hidden', '');
          return;
        }
        const items = await Promise.all(
          results.map(async (r: { data: () => Promise<{ url: string; meta: { title: string } }> }) => {
            const data = await r.data();
            return `<li><a href="${data.url}" class="flex items-center gap-2 px-3 py-2 hover:bg-surface-raised dark:hover:bg-dark-raised"><span aria-hidden class="text-ink-subtle dark:text-dark-ink-muted">🔍</span>${data.meta.title}</a></li>`;
          }),
        );
        list.innerHTML = items.join('');
        list.removeAttribute('hidden');
      } catch {
        list.setAttribute('hidden', '');
      }
    };

    // Save a search as "recent" when the reader submits the form.
    overlay.querySelector('form')?.addEventListener('submit', () => {
      const q = (input as HTMLInputElement | null)?.value.trim();
      if (!q) return;
      const recent = [q, ...readRecent().filter((r) => r !== q)].slice(0, 5);
      localStorage.setItem(RECENT_KEY, JSON.stringify(recent));
    });

    let debounceTimer: number | undefined;
    input?.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      const q = (input as HTMLInputElement).value;
      debounceTimer = window.setTimeout(() => void renderSuggestions(q), 200);
    });
    toggle.addEventListener('click', () => {
      if (!overlay.hasAttribute('hidden')) renderRecent();
    });
  }
</script>
