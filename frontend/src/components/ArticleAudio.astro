---
/**
 * Article audio reader — browser Web Speech API.
 *
 * Lets a reader listen to the article. This matters more here than on a general
 * news site: a student commuting, or a reader with low literacy or a visual
 * impairment, gets the content in another channel.
 *
 * ## Why the Web Speech API and not a TTS service
 *
 * `docs/performance-budget.md` and the no-card constraint rule out a paid TTS
 * API, and a Bengali TTS model is exactly the kind of heavy dependency the
 * static architecture exists to avoid. The Web Speech API is built into the
 * browser, costs nothing, and ships no bytes.
 *
 * The trade-off is real and worth stating: **voice quality depends entirely on
 * the reader's device and OS.** Some Android builds have no Bengali voice at
 * all. So the control hides itself when the API is missing rather than showing a
 * button that does nothing.
 *
 * ## Bengali locale
 *
 * The utterance is tagged `bn-BD`. Without it a device may read Bengali with an
 * English voice, which produces gibberish — the tag is not cosmetic.
 */
import { isEnabled } from '../lib/feature-flags'

interface Props {
  /** Plain text to read. Extracted from the article, not the HTML. */
  text: string
}

const { text } = Astro.props

if (!isEnabled('audioReader')) return null
---

<div
  id="article-audio"
  class="mt-4 hidden items-center gap-3 rounded-md border border-rule bg-surface-raised px-4 py-3 dark:border-dark-rule dark:bg-dark-raised"
  aria-label="খবর শুনুন"
>
  <button
    type="button"
    id="audio-play"
    class="inline-flex h-9 shrink-0 items-center gap-2 rounded-md bg-brand-red px-4 text-sm font-medium text-white"
    aria-label="শুনুন"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <polygon points="6 4 20 12 6 20 6 4" />
    </svg>
    <span id="audio-play-label">শুনুন</span>
  </button>

  <button
    type="button"
    id="audio-stop"
    class="inline-flex h-9 shrink-0 items-center gap-2 rounded-md border border-rule px-3 text-sm font-medium text-ink dark:border-dark-rule dark:text-dark-ink"
    aria-label="থামান"
  >
    থামান
  </button>

  <p class="text-xs text-ink-subtle dark:text-dark-ink-muted">
    ডিভাইসের স্বয়ংক্রিয় কণ্ঠে পাঠ
  </p>
</div>

{/*
  The article text travels as non-executable JSON, not through `define:vars`.
  `define:vars` emits an **inline** `{/*
  Loaded as a **classic** same-origin script, not a bundled module.

  Astro turns a bare `<script>` into a deferred module, and a deferred reveal of
  this bar shifts everything below it by the bar's height — measured 0.036 CLS on
  the article template, over the 0.02 budget. A classic script blocks parsing
  where it sits, so the bar is part of the first layout and nothing moves. The
  site CSP (`script-src 'self'`) allows it; only inline scripts are blocked,
  which is why the article text travels in the JSON tag above.
*/}
<script src="/article-audio.js" is:inline></script>
