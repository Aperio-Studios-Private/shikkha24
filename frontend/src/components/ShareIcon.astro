/**
 * Utility marks — outlined glyphs, stroked with `currentColor`. Heroicons v2, MIT.
 *
 * ⚠️ Stroke marks sit on the **outline** buttons, which have no background of
 * their own, so they must stroke with `currentColor` and not `fill`. Mixing the
 * two is why the brand buttons read as solid chips and these as outlines.
 */
const STROKED: Record<string, string> = {
