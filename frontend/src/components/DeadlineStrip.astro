---
/**
 * Deadline strip — N1 (scholarship tracker) + N2 (academic calendar).
 *
 * The homepage surface for the two highest-intent education features: upcoming
 * scholarship deadlines and dated academic events, soonest first.
 *
 * ## Why this is the strip and not a full tracker
 *
 * N1's full spec is "deadline-sorted, filterable by level / country / funding
 * type" — that belongs on its own page (S10). The homepage carries the urgent
 * head of that list: what is closing soonest. Same data model, different cut.
 *
 * ## Staleness — a real, accepted trade
 *
 * Days-remaining is computed at BUILD time, because the site is static HTML. A
 * build that happened at 09:00 shows "আজ" for a deadline that expires at 18:00,
 * and keeps showing it until the next publish. That is acceptable here only
 * because publishing happens 15–40 times a day, so the page is rarely more than
 * an hour old. It would NOT be acceptable for a live countdown — which is why
 * this is a date strip, not a timer.
 *
 * ## Zero CLS
 *
 * Cards are fixed-width with a reserved height; the rail scrolls horizontally
 * rather than wrapping, so content length never changes page height.
 */
import type { CmsDeadline } from '../lib/cms'
import { formatBnBd, getDhakaDate } from '../lib/bangla-date'

interface Props {
  deadlines: CmsDeadline[]
}

const { deadlines } = Astro.props

/**
 * Bengali labels for the deadline `type` select.
 *
 * These keys MUST track `DEADLINE_TYPES` in `cms/src/collections/Deadlines.ts`.
 * A missing key is not fatal — the raw value renders as a fallback — but it
 * would look broken, so keep the two lists in step.
 */
const TYPE_LABELS: Record<string, string> = {
  admission: 'ভর্তি',
  result: 'ফলাফল',
  examRoutine: 'পরীক্ষার রুটিন',
  scholarshipDeadline: 'বৃত্তির সময়সীমা',
  holiday: 'ছুটি',
  circular: 'বিজ্ঞপ্তি',
}

/**
 * The relative chip ("আজ", "২ দিন বাকি") is computed **in the browser**, not at
 * build time. This strip ships inside a static build that can serve for days,
 * so a build-time `new Date()` froze "আজ" onto whatever day the last deploy
 * happened (T-32) — precisely the staleness a deadline list must never show.
 * The absolute date in each card stays server-rendered, so no-JS readers keep
 * the real information; only this label hydrates.
 */

function formatDate(date: string | null | undefined): string {
  if (!date) return ''
  return formatBnBd(date, { day: 'numeric', month: 'short', year: 'numeric' })
}
---

{
  deadlines.length > 0 && (
    <section class="border-y border-rule bg-surface-raised dark:border-dark-rule dark:bg-dark-surface">
      <div class="container-page py-6">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="font-headline text-xl font-bold text-ink dark:text-dark-ink">
            শিক্ষা ক্যালেন্ডার ও ডেডলাইন
          </h2>
          <div class="flex items-center gap-4">
            <p class="flex items-center gap-1.5 text-xs text-ink-subtle dark:text-dark-ink-muted">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 4 4 14M20 10 20" />
                <path d="M4 4h10v10H4z" opacity="0.3" />
              </svg>
              <span>ডানে-বামে টেনে দেখুন</span>
            </p>
            <a
              href="/deadlines"
              class="shrink-0 text-sm font-medium text-brand-red hover:underline"
            >
              সব দেখুন →
            </a>
          </div>
        </div>

        <ul id="deadline-rail" class="deadline-rail flex cursor-grab snap-x snap-mandatory gap-3 overflow-x-auto pb-2 active:cursor-grabbing">
          {deadlines.map((deadline) => {
            const targetIso = getDhakaDate(deadline.dateEnd ?? deadline.dateStart)
            const typeLabel = deadline.type ? (TYPE_LABELS[deadline.type] ?? deadline.type) : null

            return (
              <li class="w-64 shrink-0 snap-start">
                <a
                  href={deadline.relatedArticle ? '#' : '/deadlines'}
                  class="flex h-full flex-col gap-2 rounded-lg border border-rule bg-surface p-4 no-underline transition-colors hover:border-brand-red dark:border-dark-rule dark:bg-dark-raised dark:hover:border-brand-red"
                >
                  <div class="flex items-center justify-between gap-2">
                    {typeLabel && (
                      <span class="rounded bg-brand-red/10 px-2 py-0.5 text-xs font-semibold text-brand-red-on-tint dark:text-brand-red-on-tint-dark dark:bg-brand-red/20">
                        {typeLabel}
                      </span>
                    )}
                    {targetIso && (
                      <span
                        data-days-until={targetIso}
                        class="text-xs font-semibold text-ink-subtle dark:text-dark-ink-muted"
                      />
                    )}
                  </div>

                  <h3 class="font-headline line-clamp-2 text-base font-bold text-ink dark:text-dark-ink">
                    {deadline.title}
                  </h3>

                  {deadline.description && (
                    <p class="line-clamp-2 text-xs text-ink-muted dark:text-dark-ink-muted">
                      {deadline.description}
                    </p>
                  )}

                  <time class="mt-auto text-xs text-ink-subtle dark:text-dark-ink-muted">
                    {formatDate(deadline.dateEnd ?? deadline.dateStart)}
                  </time>
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    </section>
  )
}

<script>
  // T-32: relative deadline labels are computed at view time in Asia/Dhaka — a
  // static build can serve for days and must never show a frozen "আজ".
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dhaka' }).format(new Date())
  const toUtc = (iso: string): number => {
    const [y, m, d] = iso.split('-').map(Number)
    return Date.UTC(y, (m ?? 1) - 1, d ?? 1)
  }
  document.querySelectorAll<HTMLElement>('[data-days-until]').forEach((el) => {
    const target = el.dataset.daysUntil
    if (!target) return
    const days = Math.round((toUtc(target) - toUtc(today)) / 86_400_000)
    const markUrgent = (): void => {
      el.classList.remove('text-ink-subtle', 'dark:text-dark-ink-muted')
      el.classList.add('text-brand-red')
    }
    if (days < 0) {
      el.textContent = 'শেষ'
    } else if (days === 0) {
      el.textContent = 'আজ'
      markUrgent()
    } else if (days === 1) {
      el.textContent = 'আগামীকাল'
      markUrgent()
    } else {
      el.textContent = `${days.toLocaleString('bn-BD')} দিন বাকি`
      if (days <= 3) markUrgent()
    }
  })
</script>

<style>
  /* Hide the scrollbar chrome but keep the rail scrollable by touch, keyboard
     and pointer. A visible scrollbar on a 320px screen wastes vertical space. */
  .deadline-rail {
    scrollbar-width: thin;
    user-select: none;
    touch-action: pan-x;
  }

  .deadline-rail::-webkit-scrollbar {
    height: 4px;
  }

  .deadline-rail::-webkit-scrollbar-thumb {
    background: var(--color-rule);
    border-radius: 999px;
  }
</style>

<script>
  (function () {
    var rail = document.getElementById('deadline-rail')
    if (!rail) return

    var isDown = false
    var startX = 0
    var scrollLeft = 0

    rail.addEventListener('mousedown', function (e) {
      isDown = true
      rail.classList.add('cursor-grabbing')
      startX = e.pageX - rail.offsetLeft
      scrollLeft = rail.scrollLeft
    })

    rail.addEventListener('mouseleave', function () {
      isDown = false
      rail.classList.remove('cursor-grabbing')
    })

    rail.addEventListener('mouseup', function () {
      isDown = false
      rail.classList.remove('cursor-grabbing')
    })

    rail.addEventListener('mousemove', function (e) {
      if (!isDown) return
      e.preventDefault()
      var x = e.pageX - rail.offsetLeft
      var walk = (x - startX) * 1.5
      rail.scrollLeft = scrollLeft - walk
    })
  })()
</script>
