---
/**
 * Trending / most-read list.
 *
 * ⚠️ **PROVISIONAL — this is not real trending yet.**
 *
 * A genuine "most read" ranking needs view counts, and a static site has nowhere
 * to accumulate them: there is no server in the request path. The `Articles`
 * collection has no view-count field, and adding one would not help without a
 * runtime to increment it.
 *
 * So this component currently renders whatever the caller passes — the homepage
 * passes the most recent published articles — and is **honestly labelled
 * "জনপ্রিয়" only once real data exists**. Until then it is visually a ranked
 * list and semantically a recent list.
 *
 * The real fix belongs with analytics: either Apache access log analysis
 * feeding a periodic build-time ranking, or an editorial "trending" flag
 * on the collection that an editor sets by hand. Both are noted in the S3
 * section todo; neither belongs in S3, which is about homepage structure.
 *
 * Numbering uses Bengali digits — a Bengali-only UI should not count in Latin.
 */
import type { CmsArticle } from '../lib/cms'
import { toBnDigits } from '../lib/widgets'
import { articleUrl } from '../lib/url'

interface Props {
  articles: CmsArticle[]
  title?: string
}

const { articles, title = 'জনপ্রিয়' } = Astro.props

const items = articles.slice(0, 8)
---

{
  items.length > 0 && (
    <section aria-label={title}>
      <div class="mb-3 flex items-baseline justify-between gap-4 border-b-2 border-brand-red pb-2">
        <h2 class="font-headline text-xl font-bold text-ink dark:text-dark-ink">{title}</h2>
      </div>

      <ol class="flex flex-col">
        {items.map((article, index) => (
          <li class="flex gap-3 border-b border-rule py-3 last:border-b-0 dark:border-dark-rule">
            <span
              class="font-headline shrink-0 text-2xl font-bold leading-none text-brand-red/40 dark:text-brand-red/50"
              aria-hidden="true"
            >
              {toBnDigits(index + 1)}
            </span>
            <a href={articleUrl(article)} class="group min-w-0 flex-1 no-underline">
              <h3 class="font-headline line-clamp-2 text-base font-bold text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red">
                {article.title}
              </h3>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
