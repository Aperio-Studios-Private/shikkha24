---
/**
 * Ad slot with strictly reserved space.
 *
 * ## Why the space is reserved even when empty
 *
 * Layout shift happens when an element grows AFTER the reader has started
 * reading. An ad that arrives late and pushes the article down is the single
 * most common CLS source on news sites, and `docs/performance-budget.md` treats
 * CLS as a hard gate. Reserving the box before the ad loads costs a little empty
 * space when an ad does not fill; not reserving it costs the reader their place
 * in the text. The first is a cosmetic trade, the second is a usability failure.
 *
 * ## Why it takes a position, not a free-form label
 *
 * `position` is a value from `AD_POSITIONS`, mirrored in the CMS
 * (`cms/src/collections/AdUnits.ts`). An Ad Manager picks a position in the admin
 * and this slot picks it up — so the two can never drift into the state where an
 * editor configures a placement that the layout does not reserve.
 *
 * ## Why it is flag-gated
 *
 * `docs/reliability.md` §5: heavy or fragile third-party features must be
 * switchable off without a redeploy. AdSense is a third-party script — if it
 * degrades, setting `PUBLIC_FLAG_ADS=false` drops every slot from the next build
 * while the markup stays untouched.
 *
 * ## What renders
 *
 * A resolved unit renders through `AdCreative`. With no unit configured — or a
 * unit whose creative is incomplete — the slot falls back to the labelled
 * placeholder, which is what makes the reserved space visible rather than
 * mysterious during review.
 */
import { type AdPosition, getAdForPosition, getAdsenseClientId } from '../lib/ads'
import { isEnabled } from '../lib/feature-flags'
import AdCreative from './AdCreative.astro'
import DemoAd from './DemoAd.astro'

interface Props {
  /** A value from `AD_POSITIONS` — must have a matching slot in the CMS. */
  position: AdPosition
  width: number
  height: number
  class?: string
}

const { position, width, height, class: className = '' } = Astro.props

if (!isEnabled('ads')) return null

/**
 * Map the reserved box to a named inventory format. Real inventory is defined by
 * size — 300x250 IS a medium rectangle — so deriving the label from the
 * dimensions keeps the two from disagreeing.
 */
type Format = 'leaderboard' | 'rectangle' | 'skyscraper' | 'mobile' | 'infeed'
const format: Format =
  width >= 700
    ? 'leaderboard'
    : height >= 500
      ? 'skyscraper'
      : // Short and wide is a mobile banner. Note this must test HEIGHT, not
        // width: a 300x250 medium rectangle is narrower than 320 but is
        // emphatically not a mobile banner.
        height <= 120
        ? 'mobile'
        : 'rectangle'

const [unit, clientId] = await Promise.all([getAdForPosition(position), getAdsenseClientId()])

const image = unit?.image && typeof unit.image === 'object' ? unit.image : null

/**
 * An AdSense unit with no publisher id or slot id renders as a blank box, which
 * reads as a bug. An image unit with no image does the same. Both fall back to
 * the placeholder instead.
 */
const canRender = unit
  ? unit.adType === 'adsense'
    ? Boolean(clientId && unit.adsenseSlotId)
    : Boolean(image?.url)
  : false
---

<div
  data-ad-slot={position}
  class:list={['overflow-hidden rounded', className]}
  style={`width:100%;max-width:${width}px;height:${height}px`}
>
  {
    canRender && unit ? (
      <AdCreative unit={unit} width={width} height={height} clientId={clientId} />
    ) : (
      <DemoAd format={format} slot={position} />
    )
  }
</div>
