---
/**
 * Enhancement scripts for the S8 article content blocks.
 *
 * ## Why this is a component that renders nothing
 *
 * The block markup is injected into the article body with `set:html`, so there is
 * no Astro component wrapping those elements to host a script. A script-only
 * component keeps the wiring in one place instead of scattered inline in the
 * article page, and Astro bundles it once no matter how many articles exist.
 *
 * ## What it enhances
 *
 *   - **before/after** — switches the stacked pair into an overlay slider and
 *     drives the clip position from the range input
 *   - **scrollytelling** — marks the section so the CSS scroll-driven animation
 *     applies
 *   - **video embed** — turns the link into an inline player on the reader's
 *     first tap, and only then
 *
 * All are additive. None of the blocks needs this script to be readable, so a
 * failure here costs polish and nothing else.
 */

import '../styles/content-blocks.css'
---

<script>
  /**
   * Before/after comparison slider.
   *
   * The control is a real `<input type="range">`, so it is keyboard-operable and
   * announced correctly by a screen reader without any ARIA of our own. The
   * script only mirrors its value into a CSS custom property — no drag handling,
   * no pointer events, nothing to break on a touch device.
   */
  for (const figure of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const range = figure.querySelector<HTMLInputElement>('[data-compare-range]')
    const overlay = figure.querySelector<HTMLElement>('[data-compare-overlay]')

    // Without both halves there is no comparison to drive — leave the stacked
    // fallback alone rather than half-enabling it.
    if (!range || !overlay) continue

    const apply = (): void => {
      figure.style.setProperty('--compare-position', `${range.value}%`)
    }

    apply()
    range.addEventListener('input', apply)

    // Last, so the layout never renders mid-switch.
    figure.classList.add('is-enhanced')
  }

  /**
   * Scrollytelling.
   *
   * The class is the signal that JavaScript is present; the animation itself is
   * declared in CSS behind `@supports (animation-timeline: view())` and
   * `prefers-reduced-motion`. Gating on both means an unsupported browser or a
   * reader who asked for less motion gets the plain ordered list, never a
   * half-faded one.
   */
  for (const section of document.querySelectorAll('[data-scrolly]')) {
    section.classList.add('is-enhanced')
  }

  /**
   * Click-to-load video embeds.
   *
   * The iframe is built here rather than shipped in the markup, so an article
   * carrying a video makes **no third-party request** until the reader asks for
   * one. The trigger is a real link, so if this script never runs the reader
   * still reaches the video — in a new tab, which is worse than playing in place
   * but far better than a dead button.
   *
   * The id is read back out of the DOM and re-validated. `parseYouTubeId` already
   * guaranteed it at build time, but a page is not a trusted input once it is on
   * a CDN edge, and this is the line that decides what gets framed.
   */
  const VIDEO_ID = /^[A-Za-z0-9_-]{11}$/

  for (const figure of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const trigger = figure.querySelector<HTMLAnchorElement>('[data-video-trigger]')
    const id = figure.dataset.videoId ?? ''

    if (!trigger || !VIDEO_ID.test(id)) continue

    trigger.addEventListener('click', (event) => {
      // The link stays a link until this handler decides otherwise — so a
      // browser that blocks the frame still has the ordinary navigation path.
      event.preventDefault()

      const frame = document.createElement('iframe')
      frame.className = 'video-frame'
      // `autoplay=1` is allowed because a tap is a user gesture. `rel=0` keeps
      // the end screen inside this channel; `playsinline` stops iOS Safari from
      // hijacking the screen with its own fullscreen player.
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`
      frame.title = figure.querySelector('.video-label')?.textContent?.trim() || 'ভিডিও'
      // Scoped to what a player needs — not a blanket permission delegation.
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture'
      frame.allowFullscreen = true
      frame.setAttribute('loading', 'lazy')

      trigger.replaceWith(frame)
      // The trigger has just left the document. Without this, focus falls back
      // to `<body>` and a keyboard reader loses their place entirely.
      frame.focus()
    })
  }
</script>
