---
/**
 * Live blog page (S8) — `/live/:slug`.
 *
 * Result-day and admission-day coverage (`docs/education-feature-inventory.md` §3).
 *
 * ## Rendering
 *
 * Every entry is baked into the HTML at build time. That is the whole reliability
 * story: with JavaScript off, on a 3G phone, or while the CMS is down, the reader
 * still gets the complete timeline as it stood at the last build
 * (`docs/reliability.md` §4 — "live blog: fall back to a static list of entries").
 *
 * The opt-in refresh in `LiveBlogTimeline` is an enhancement on top, never a
 * dependency. See that file for why it is not an auto-poll.
 *
 * ## A closed live blog keeps its URL
 *
 * `isActive: false` stops promotion and stops new votes. It does not delete the
 * page — the timeline is the record of what happened that day and it is linked to
 * from social posts. Only the status badge changes.
 */
import Layout from '../../layouts/Layout.astro'
import LiveBlogTimeline from '../../components/LiveBlogTimeline.astro'
import AdSlot from '../../components/AdSlot.astro'
import { getAllLiveBlogSlugs, getLiveBlogBySlug, getPublicCmsOrigin } from '../../lib/interactive'
import { lexicalToPlainText } from '../../lib/richtext'
import {
  FALLBACK_CATEGORIES,
  FALLBACK_SETTINGS,
  getCategories,
  getFooterPages,
  getSiteSettings,
} from '../../lib/cms'
import { isEnabled } from '../../lib/feature-flags'

/**
 * Flag-gated: with `PUBLIC_FLAG_LIVE_BLOG=false` no live-blog route is generated
 * at all, which is what `docs/reliability.md` §5 asks for — the feature can be
 * switched off without a redeploy and without touching the markup.
 */
export async function getStaticPaths() {
  if (!isEnabled('liveBlog')) return []

  const slugs = await getAllLiveBlogSlugs().catch(() => [])
  return slugs.map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params

const [settings, categories, footerPages] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
])

const blog = await getLiveBlogBySlug(slug ?? '').catch(() => null)

// A slug that exists in the CMS but not here means the build raced a deletion.
if (!blog) return Astro.redirect('/404')

const entries = blog.entries ?? []
const cmsOrigin = getPublicCmsOrigin()

const canonical = new URL(`/live/${blog.slug}`, Astro.site ?? Astro.url).href

/** Oldest and newest entry — `LiveBlogPosting` wants the coverage window. */
const oldest = entries.length > 0 ? entries[entries.length - 1] : undefined
const newest = entries[0]

/**
 * `LiveBlogPosting` schema (`docs/seo-plan.md` §4).
 *
 * Each update is a nested `BlogPosting` with its own timestamp, which is what
 * lets Google show a live timeline badge rather than a single stale article.
 * Bodies are the plain text of the entry, truncated — schema payloads are
 * shipped to every crawler, so they stay small on purpose.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LiveBlogPosting',
  headline: blog.title,
  url: canonical,
  datePublished: oldest?.timestamp ?? blog.updatedAt ?? undefined,
  dateModified: blog.updatedAt ?? newest?.timestamp ?? undefined,
  coverageStartTime: oldest?.timestamp ?? undefined,
  coverageEndTime: blog.isActive ? undefined : (newest?.timestamp ?? undefined),
  liveBlogUpdate: entries.map((entry) => ({
    '@type': 'BlogPosting',
    headline: lexicalToPlainText(entry.content).slice(0, 110),
    datePublished: entry.timestamp,
  })),
  publisher: { '@type': 'Organization', name: settings.siteName },
  inLanguage: 'bn-BD',
}
---

<Layout
  title={`${blog.title} — লাইভ আপডেট`}
  description={`${blog.title} — শিক্ষা২৪ এর লাইভ কভারেজ।`}
  canonical={canonical}
  jsonLd={jsonLd}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <div class="grid-12">
      <div class="col-span-4 sm:col-span-8 lg:col-span-8">
        <nav aria-label="breadcrumb" class="mb-3">
          <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-subtle dark:text-dark-ink-muted">
            <li><a href="/" class="hover:text-brand-red">হোম</a></li>
            <li aria-hidden="true">/</li>
            <li>লাইভ</li>
          </ol>
        </nav>

        <div class="flex flex-wrap items-center gap-3">
          <h1
            class="font-headline text-2xl font-bold leading-tight text-ink sm:text-3xl dark:text-dark-ink"
          >
            {blog.title}
          </h1>
          {
            blog.isActive ? (
              <span class="inline-flex items-center gap-1.5 rounded bg-brand-red px-2 py-0.5 text-xs font-semibold text-white">
                <span class="h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true" />
                চলমান
              </span>
            ) : (
              <span class="rounded border border-rule px-2 py-0.5 text-xs font-medium text-ink-muted dark:border-dark-rule dark:text-dark-ink-muted">
                সমাপ্ত
              </span>
            )
          }
        </div>

        <div class="mt-5">
          <AdSlot position="liveBlogTop" width={728} height={90} />
        </div>

        <div class="mt-6">
          <LiveBlogTimeline entries={entries} slug={blog.slug} cmsOrigin={cmsOrigin} />
        </div>
      </div>

      <aside class="col-span-4 mt-8 sm:col-span-8 lg:col-span-4 lg:mt-0">
        <div class="lg:sticky lg:top-4">
          <AdSlot position="sidebarTop" width={300} height={250} />
        </div>
      </aside>
    </div>
  </div>
</Layout>
