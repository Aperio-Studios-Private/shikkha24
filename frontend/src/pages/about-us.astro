---
/**
 * `/about-us` → `/about`.
 *
 * The governance page is published at `/about`, the path the SEO plan and the
 * master plan both specify. `/about-us` is the name people actually type, so it
 * redirects rather than carrying a second copy of the same text — duplicate
 * body content would compete with the canonical page instead of reinforcing it.
 */
const canonical = new URL('/about', Astro.site ?? Astro.url).href
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${canonical}`} />
    <title>পুনর্নির্দেশ — আমাদের সম্পর্কে</title>
  </head>
  <body>
    <h1 style="font-family: sans-serif; font-size: 1.5rem; font-weight: 700; text-align: center; margin: 0; padding: 2rem 2rem 0;">
      আমাদের সম্পর্কে
    </h1>
    <p style="font-family: sans-serif; text-align: center; padding: 2rem;">
      স্বয়ংক্রিয়ভাবে নতুন ঠিকানায় নিয়ে যাওয়া হচ্ছে…{' '}
      <a href={canonical}>এগিয়ে যান</a>
    </p>
  </body>
</html>
