---
/**
 * Privacy policy — `/privacy-policy`.
 *
 * Required for launch: Google News / E-E-A-T eligibility expects a reachable
 * privacy policy, and the footer links to it from every page.
 *
 * ⚠️ **Why this is a static route, not a `/page/[slug]` CMS page.** The footer
 * originally linked to `/page/privacy-policy`, but the CMS `pages` collection is
 * empty, so that URL 404'd on every page (171 broken links across 82 pages,
 * found in the 2026-09-14 audit). `/about` and `/contact` had already moved to
 * static routes for the same reason, so this follows that pattern.
 *
 * The content describes what the site **actually** does, read from the code:
 * comments and newsletter store data in the CMS; bookmarks and reading
 * preferences stay in the browser; AdSense sets advertising cookies; `ipwho.is`
 * receives the reader's IP for approximate location; prayer/weather data is
 * fetched server-side at build time and sends nothing about the reader.
 * If a feature's data handling changes, this page must change with it.
 */
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { getSiteSettings, getCategories, getFooterPages, FALLBACK_SETTINGS, FALLBACK_CATEGORIES } from '../lib/cms'
import { formatBnBd } from '../lib/bangla-date'

const [settings, categories, footerPages] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
])

/** Contact details, so the policy names a real address a reader can write to. */
const contactEmail = settings.contact?.email
const contactAddress = settings.contact?.address

const sections = [
  {
    id: 'collect',
    heading: 'আমরা কী তথ্য সংগ্রহ করি',
    body: [
      'আমরা কেবল নির্দিষ্ট সেবা সচল রাখার জন্য যতটুকু দরকার, ঠিক ততটুকুই তথ্য সংগ্রহ করি। কোনো বাড়তি বা অপ্রয়োজনীয় তথ্য নেওয়া হয় না।',
    ],
    list: [
      'মন্তব্য: আপনার দেওয়া নাম, এবং সামাজিক মাধ্যমে সাইন ইন করলে প্রোভাইডারের পরিচয়। ইমেইল দেওয়া বাধ্যতামূলক নয়।',
      'নিউজলেটার: আপনার ইমেইল ঠিকানা। সাবস্ক্রিপশন নিশ্চিত করার জন্য একটি যাচাইকরণ লিংক পাঠানো হয়।',
      'খবর পাঠান (নাগরিক সাংবাদিকতা): আপনি যে সংবাদ, ছবি বা যোগাযোগের বিবরণ জমা দেন।',
      'আবেদনের সময়সীমা স্মরণিকা: আপনি সম্মতি দিলে ব্রাউজারের পুশ নোটিফিকেশন ঠিকানা।',
      'প্রতিক্রিয়া: কোন সংবাদে কী প্রতিক্রিয়া দিয়েছেন এবং একই প্রতিক্রিয়া একাধিকবার গণনা এড়াতে ব্রাউজার তথ্যের একটি একমুখী হ্যাশ (কাঁচা আইপি কোথাও সংরক্ষণ করা হয় না)।',
    ],
  },
  {
    id: 'browser',
    heading: 'ব্রাউজারেই যা সংরক্ষিত থাকে',
    body: [
      'সাইন ইন না করলে নিচের তথ্যগুলো কেবল আপনার ডিভাইসেই জমা থাকে, আমাদের সার্ভারে যায় না:',
    ],
    list: [
      'সংরক্ষিত খবরের তালিকা (বুকমার্ক)',
      'পঠন সুবিধা: থিম (হালকা বা গাঢ়) এবং অক্ষরের আকার',
      'অ্যাপ বা নোটিফিকেশন সংক্রান্ত ব্রাউজার সেটিংস',
      'সংবাদে আপনার দেওয়া প্রতিক্রিয়া চিহ্নিত রাখার সাময়িক নিশানা (আসল গণনা সার্ভারে থাকে)',
    ],
  },
  {
    id: 'third-party',
    heading: 'তৃতীয় পক্ষের সেবা',
    body: [
      'কিছু সেবা সক্রিয় রাখতে আমরা বাইরের নির্ভরযোগ্য প্রযুক্তির ওপর নির্ভর করি। তাদের তথ্য প্রবাহের নিয়ম নিচে তুলে ধরা হলো:',
    ],
    list: [
      'Google AdSense: বিজ্ঞাপন প্রদর্শনের জন্য। এটি কুকি ব্যবহার করে পাঠকের আগ্রহের ভিত্তিতে প্রাসঙ্গিক বিজ্ঞাপন প্রদর্শন করতে পারে।',
      'ipwho.is: আপনার আইপি ঠিকানা থেকে কেবল আনুমানিক অঞ্চল (শহর বা দেশ) জানার জন্য। এটি কোনো কুকি ব্যবহার করে না। অঞ্চলভিত্তিক নামাজের সময়সূচি ও স্থানীয় আবহাওয়ার তথ্য দেখানোর জন্যই কেবল এটি ব্যবহৃত হয়।',
      'Aladhan ও Open-Meteo: নামাজের সময়সূচি ও আবহাওয়ার পূর্বাভাস। পাতা তৈরির সময়ে সার্ভার থেকে তথ্য আনা হয়, ফলে পাঠকের ব্যক্তিগত তথ্য এদের কাছে যায় না।',
      'YouTube: ভিডিও চালু না করলে ইউটিউবের সার্ভারে কোনো অনুরোধ যায় না। আমরা ইউটিউবের গোপনীয়তাবান্ধব ডোমেইন (youtube-nocookie) ব্যবহার করি, যা ভিডিও দেখার আগে কোনো ট্র্যাকিং কুকি বসায় না।',
      'Google ও Facebook: কেবল আপনি নিজে সমাজমাধ্যম ব্যবহার করে সাইন ইন করার সিদ্ধান্ত নিলে।',
    ],
  },
  {
    id: 'use',
    heading: 'তথ্যের ব্যবহার',
    body: [
      'সংগৃহীত তথ্য কেবল নির্দিষ্ট সেবাটি পৌঁছে দেওয়ার কাজেই ব্যবহৃত হয়; যেমন মন্তব্য প্রকাশ, ইমেইলে সংবাদ পাঠানো কিংবা আবেদনের সময়সীমা মনে করিয়ে দেওয়া।',
      'আমরা কখনোই কোনো পাঠকের ব্যক্তিগত তথ্য কারো কাছে বিক্রি, ভাড়া বা বাণিজ্যিক উদ্দেশ্যে হস্তান্তর করি না।',
    ],
  },
  {
    id: 'retention',
    heading: 'সংরক্ষণ ও তথ্য মুছে ফেলা',
    body: [
      'যতদিন সেবাটি সক্রিয় থাকে, ততদিন প্রয়োজনীয় তথ্য সংরক্ষিত থাকে।',
      /*
       * ⚠️ This must stay in step with `cms/src/endpoints/account.ts`. The copy
       * names exactly what is deleted and what is only anonymised, because a
       * reader should not have to discover the difference afterwards.
       */
      'সামাজিক মাধ্যমে সাইন ইন করে তৈরি করা অ্যাকাউন্ট আপনি যেকোনো সময় নিজেই মুছে ফেলতে পারেন। "সংরক্ষিত" পাতার নিচে "আমার অ্যাকাউন্ট মুছুন" বোতাম চাপলেই আপনার অ্যাকাউন্ট, সংরক্ষিত খবরের তালিকা, আবেদনের সময়সীমা, পুশ নোটিফিকেশন ও যাবতীয় প্রতিক্রিয়া স্থায়ীভাবে মুছে যাবে। আপনার করা মন্তব্যগুলো পাঠকদের উন্মুক্ত আলোচনার অংশ হিসেবে থেকে গেলেও আপনার নাম ও ইমেইল ঠিকানা পুরোপুরি সরিয়ে দেওয়া হবে।',
      'অ্যাকাউন্ট ছাড়া করা কোনো কাজ (যেমন সংবাদে প্রতিক্রিয়া বা মতামত জরিপে অংশ নেওয়া) কেবল আপনার আইপি ও ব্রাউজার তথ্যের একটি একমুখী গাণিতিক সংকেত (হ্যাশ) হিসেবে জমা থাকে। এটি থেকে কখনোই মূল আইপি বা ব্যক্তির পরিচয় বের করা সম্ভব নয়।',
      'তথ্য সংরক্ষণ বিষয়ে অন্য কোনো জিজ্ঞাসা থাকলে আমাদের সাথে যোগাযোগ করতে পারেন।',
    ],
    contact: true,
  },
]

const legal = settings.legal ?? {}
const legalRows = [
  { label: 'ট্রেড লাইসেন্স', value: legal.tradeLicense },
  { label: 'টিআইএন (TIN)', value: legal.tin },
  { label: 'তথ্য মন্ত্রণালয় নিবন্ধন', value: legal.ministryRegistration },
].filter((row) => Boolean(row.value))
---

<Layout
  title="গোপনীয়তা নীতি"
  description={`${settings.siteName}: গোপনীয়তা নীতি। আমরা কীভাবে তথ্য সংগ্রহ ও সুরক্ষা করি।`}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'গোপনীয়তা নীতি' }]} />

    <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
      গোপনীয়তা নীতি
    </h1>

    <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink-muted dark:text-dark-ink-muted">
      এই নীতিমালায় স্পষ্ট করা হয়েছে <strong class="font-semibold text-ink dark:text-dark-ink">{settings.siteName}</strong>
      কী ধরনের তথ্য সংগ্রহ করে, কীভাবে তা ব্যবহার করে এবং আপনি কীভাবে নিজের তথ্য মুছে ফেলতে পারেন।
    </p>

    <div class="mt-8 max-w-3xl space-y-8">
      {
        sections.map((section) => (
          <section id={section.id} aria-labelledby={`h-${section.id}`}>
            <h2
              id={`h-${section.id}`}
              class="font-headline text-lg font-bold text-ink dark:text-dark-ink"
            >
              {section.heading}
            </h2>
            {section.body.map((paragraph) => (
              <p class="mt-3 text-base leading-relaxed text-ink dark:text-dark-ink">{paragraph}</p>
            ))}
            {section.list && (
              <ul class="mt-3 space-y-2 pl-5 text-base leading-relaxed text-ink dark:text-dark-ink">
                {section.list.map((item) => (
                  <li class="list-disc">{item}</li>
                ))}
              </ul>
            )}
            {section.contact && (
              <p class="mt-3 text-base leading-relaxed text-ink dark:text-dark-ink">
                অনুরোধ করতে ইমেইল করুন
                {contactEmail ? (
                  <>
                    {' '}
                    <a href={`mailto:${contactEmail}`} class="text-brand-red hover:underline">
                      {contactEmail}
                    </a>
                  </>
                ) : (
                  <> আমাদের <a href="/contact" class="text-brand-red hover:underline">যোগাযোগ</a> পাতার ঠিকানায়</>
                )}
                {contactAddress ? ` অথবা লিখুন: ${contactAddress}।` : '।'}
              </p>
            )}
          </section>
        ))
      }

      <section id="ads" aria-labelledby="h-ads">
        <h2 id="h-ads" class="font-headline text-lg font-bold text-ink dark:text-dark-ink">
          বিজ্ঞাপন ও কুকি
        </h2>
        <p class="mt-3 text-base leading-relaxed text-ink dark:text-dark-ink">
          এই সাইটে Google AdSense-এর বিজ্ঞাপন প্রদর্শিত হতে পারে। Google ও তাদের অংশীদারেরা বিজ্ঞাপন প্রদর্শনে
          কুকি ব্যবহার করতে পারে। আপনি চাইলে ব্রাউজারের সেটিংস থেকে যেকোনো সময় কুকি মুছে ফেলতে পারেন; তাতেও
          সাইটের যেকোনো সংবাদ নির্বিঘ্নে পড়া যাবে।
        </p>
      </section>

      {
        legalRows.length > 0 && (
          <section
            id="ownership"
            aria-labelledby="h-ownership"
            class="border-t border-rule pt-6 dark:border-dark-rule"
          >
            <h2 id="h-ownership" class="font-headline text-lg font-bold text-ink dark:text-dark-ink">
              প্রকাশক
            </h2>
            <dl class="mt-3 grid gap-3 sm:grid-cols-2">
              {legalRows.map((row) => (
                <div class="rounded-lg border border-rule bg-surface p-4 dark:border-dark-rule dark:bg-dark-surface">
                  <dt class="text-sm font-medium text-ink-muted dark:text-dark-ink-muted">
                    {row.label}
                  </dt>
                  <dd class="mt-1 text-base text-ink dark:text-dark-ink">{row.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <p class="border-t border-rule pt-6 text-sm text-ink-muted dark:border-dark-rule dark:text-dark-ink-muted">
        শেষ হালনাগাদ: {formatBnBd(new Date(), { year: 'numeric', month: 'long' })}
      </p>
    </div>
  </div>
</Layout>
