---
/**
 * Scholarship tracker — N1.
 *
 * Deadline-sorted list of active scholarships. Each card shows the funding
 * type, level, country and an urgency label. No external API — editorially
 * curated (`docs/education-feature-inventory.md` §4).
 */
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { toBnDigits } from '../../lib/widgets'
import { formatBnBd } from '../../lib/bangla-date'
import { getActiveScholarships, type CmsScholarship } from '../../lib/education'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
} from '../../lib/cms'

const [settings, categories, footerPages, scholarships] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getActiveScholarships().catch(() => []),
])

const FUNDING_LABELS: Record<string, string> = {
  full: 'সম্পূর্ণ বৃত্তি',
  partial: 'আংশিক বৃত্তি',
  tuition: 'শুধু টিউশন',
}

const TODAY = new Date()
TODAY.setHours(0, 0, 0, 0)

function daysUntil(date: string | null | undefined): number | null {
  if (!date) return null
  const target = new Date(date)
  target.setHours(0, 0, 0, 0)
  return Math.round((target.getTime() - TODAY.getTime()) / 86_400_000)
}

function urgencyLabel(days: number | null): { text: string; urgent: boolean } | null {
  if (days === null) return null
  if (days < 0) return { text: 'শেষ', urgent: false }
  if (days === 0) return { text: 'আজ', urgent: true }
  if (days === 1) return { text: 'আগামীকাল', urgent: true }
  return { text: `${toBnDigits(days)} দিন বাকি`, urgent: days <= 7 }
}

function formatDate(date: string | null | undefined): string {
  if (!date) return ''
  return formatBnBd(date, { day: 'numeric', month: 'long', year: 'numeric' })
}

function levelNames(s: CmsScholarship): string[] {
  if (!Array.isArray(s.level)) return []
  return s.level.map((l) => (typeof l === 'object' && l ? l.nameBn : null)).filter(Boolean) as string[]
}

const jsonLd = scholarships.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'বৃত্তির তালিকা',
  itemListElement: scholarships.slice(0, 10).map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    url: s.applyUrl ?? undefined,
  })),
} : undefined
---

<Layout
  title="বৃত্তির তালিকা"
  description="সময়সীমা অনুযায়ী সাজানো বৃত্তির তালিকা — দেশি ও বিদেশি।"
  settings={settings}
  categories={categories}
  footerPages={footerPages}
  jsonLd={jsonLd}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'বৃত্তি', href: '/scholarships' }]} />

    <header class="mb-6 border-b-2 border-brand-red pb-3">
      <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
        বৃত্তির তালিকা
      </h1>
      <p class="mt-2 text-base text-ink-muted dark:text-dark-ink-muted">
        দেশি ও বিদেশি বৃত্তির সুযোগ — আবেদনের শেষ তারিখ অনুযায়ী সাজানো।
      </p>
    </header>

    {
      scholarships.length === 0 ? (
        <p class="rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">
          এখনো কোনো বৃত্তি যোগ করা হয়নি।
        </p>
      ) : (
        <ul class="flex flex-col gap-3">
          {scholarships.map((s) => {
            const days = daysUntil(s.deadline)
            const urgency = urgencyLabel(days)
            const funding = s.fundingType ? FUNDING_LABELS[s.fundingType] ?? s.fundingType : null
            const levels = levelNames(s)
            return (
              <li class="rounded-lg border border-rule bg-surface p-4 dark:border-dark-rule dark:bg-dark-surface">
                <div class="flex flex-wrap items-center gap-2">
                  {funding && (
                    <span class="rounded bg-brand-red/10 px-2 py-0.5 text-xs font-semibold text-brand-red dark:bg-brand-red/20">
                      {funding}
                    </span>
                  )}
                  {s.isInternational && (
                    <span class="rounded bg-blue-500/10 px-2 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-400/20 dark:text-blue-300">
                      আন্তর্জাতিক
                    </span>
                  )}
                  {urgency && (
                    <span class:list={['text-xs font-semibold', urgency.urgent ? 'text-brand-red' : 'text-ink-subtle dark:text-dark-ink-muted']}>
                      {urgency.text}
                    </span>
                  )}
                </div>

                <h2 class="font-headline mt-2 text-lg font-bold text-ink dark:text-dark-ink">{s.title}</h2>
                <p class="mt-1 text-sm text-ink-muted dark:text-dark-ink-muted">{s.provider}</p>

                <div class="mt-2 flex flex-wrap gap-3 text-xs text-ink-subtle dark:text-dark-ink-muted">
                  {levels.length > 0 && <span>শ্রেণি: {levels.join(', ')}</span>}
                  {s.country && <span>দেশ: {s.country}</span>}
                  {s.amount && <span>পরিমাণ: {s.amount}</span>}
                </div>

                {s.eligibility && (
                  <p class="mt-2 text-sm text-ink-muted dark:text-dark-ink-muted">{s.eligibility}</p>
                )}

                <div class="mt-3 flex items-center gap-3">
                  {s.deadline && (
                    <time class="text-xs text-ink-subtle dark:text-dark-ink-muted">
                      শেষ তারিখ: {formatDate(s.deadline)}
                    </time>
                  )}
                  {s.applyUrl && (
                    <a href={s.applyUrl} rel="noopener noreferrer nofollow" class="text-sm font-semibold text-brand-red hover:underline">
                      আবেদন করুন →
                    </a>
                  )}
                </div>
              </li>
            )
          })}
        </ul>
      )
    }
  </div>
</Layout>
