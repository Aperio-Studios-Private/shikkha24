---
/**
 * Newsletter confirmation landing page.
 *
 * The email link points here with `?token=…`; the page then POSTs the token.
 * See `components/NewsletterTokenAction.astro` for why the token is not used
 * directly from the link.
 *
 * `noindex` — a confirmation URL has no search value, and a token sitting in a
 * search result would be a small privacy leak.
 */
import Layout from '../../layouts/Layout.astro'
import NewsletterTokenAction from '../../components/NewsletterTokenAction.astro'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
} from '../../lib/cms'
import { getPublicCmsOrigin } from '../../lib/interactive'

const [settings, categories, footerPages] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
])

const cmsOrigin = getPublicCmsOrigin()
---

<Layout
  title="সাবস্ক্রিপশন নিশ্চিত করুন"
  description="শিক্ষা২৪ নিউজলেটার সাবস্ক্রিপশন নিশ্চিত করুন।"
  settings={settings}
  categories={categories}
  footerPages={footerPages}
  hideShareBar
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  {
    cmsOrigin ? (
      <NewsletterTokenAction
        endpoint={`${cmsOrigin}/api/newsletter/confirm`}
        heading="সাবস্ক্রিপশন নিশ্চিত করুন"
        intro="নিচের বোতামে ক্লিক করলে আপনার ইমেইলটি নিউজলেটার তালিকায় যুক্ত হবে।"
        action="নিশ্চিত করুন"
        success="ধন্যবাদ — আপনার সাবস্ক্রিপশন নিশ্চিত হয়েছে। এখন থেকে শিক্ষা২৪-এর নিউজলেটার পাবেন।"
      />
    ) : (
      <section class="mx-auto max-w-xl py-8">
        <h1 class="font-headline text-2xl font-bold text-ink dark:text-dark-ink">
          নিশ্চিতকরণ এখন সম্ভব নয়
        </h1>
        <p class="mt-3 text-base leading-relaxed text-ink-muted dark:text-dark-ink-muted">
          এই ডিপ্লয়ে নিউজলেটার সেবা চালু নেই। ইমেইলের লিংকটি পরে আবার ব্যবহার করতে পারবেন।
        </p>
      </section>
    )
  }
</Layout>
