---
/**
 * Latest articles — `/latest`.
 *
 * The full chronological feed. The homepage shows the head of this list; this
 * is the rest of it, and the target of the homepage's "আরও →" link.
 */
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ArticleGrid from '../components/ArticleGrid.astro'
import Pagination from '../components/Pagination.astro'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  getArticlesPage,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
  PAGE_SIZE,
} from '../lib/cms'

const page = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1

const [settings, categories, footerPages, result] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getArticlesPage({ page, limit: PAGE_SIZE }).catch(() => ({
    docs: [],
    page,
    totalPages: 1,
    totalDocs: 0,
    hasPrev: false,
    hasNext: false,
  })),
])
---

<Layout
  title="সর্বশেষ খবর"
  description={`${settings.siteName}-এ প্রকাশিত সর্বশেষ সংবাদ।`}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'সর্বশেষ', href: '/latest' }]} />

    <header class="mb-6 border-b-2 border-brand-red pb-3">
      <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
        সর্বশেষ খবর
      </h1>
      <p class="mt-1 text-xs text-ink-subtle dark:text-dark-ink-muted">
        {result.totalDocs} টি খবর
      </p>
    </header>

    <ArticleGrid articles={result.docs} emptyMessage="এখনো কোনো খবর প্রকাশিত হয়নি।" />

    <Pagination page={result.page} totalPages={result.totalPages} basePath="/latest" />
  </div>
</Layout>
