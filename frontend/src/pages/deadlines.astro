---
/**
 * Deadlines — `/deadlines`.
 *
 * The full N1 (scholarship) + N2 (academic calendar) list with N9
 * district-first filtering. The homepage strip shows the urgent head;
 * this is the complete, filterable surface and the target of the
 * strip's "সব দেখুন".
 *
 * N2/N9: client-side filter by type, level, and district. Each deadline
 * li carries data-* attributes; a component script (emitted as an external
 * hashed file by Astro, so strict CSP holds) toggles `hidden` on change.
 */
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import DeadlineReminder from '../components/DeadlineReminder.astro'
import { toBnDigits } from '../lib/widgets'
import { formatBnBd } from '../lib/bangla-date'
import { getPublicCmsOrigin } from '../lib/interactive'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  getAllDeadlines,
  relationName,
  relationSlugs,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
} from '../lib/cms'
import type { CmsRelation } from '../lib/cms'

const [settings, categories, footerPages, deadlines] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getAllDeadlines().catch(() => []),
])

/** Browser-reachable CMS origin — null when unconfigured → no reminder UI. */
const cmsOrigin = getPublicCmsOrigin()

const TYPE_LABELS: Record<string, string> = {
  admission: 'ভর্তি',
  result: 'ফলাফল',
  examRoutine: 'পরীক্ষার রুটিন',
  scholarshipDeadline: 'বৃত্তির সময়সীমা',
  holiday: 'ছুটি',
  circular: 'বিজ্ঞপ্তি',
}

/** Type filter chips — the first entry (empty value) means "all". */
const TYPE_FILTERS = [
  { value: '', label: 'সব' },
  { value: 'admission', label: 'ভর্তি' },
  { value: 'result', label: 'ফলাফল' },
  { value: 'examRoutine', label: 'পরীক্ষার রুটিন' },
  { value: 'scholarshipDeadline', label: 'বৃত্তির সময়সীমা' },
  { value: 'holiday', label: 'ছুটি' },
  { value: 'circular', label: 'বিজ্ঞপ্তি' },
]

/**
 * First slug of a relation.
 *
 * `level` / `district` are `hasMany` in the CMS, so Payload returns an array
 * even when one value is set. Reading it as a single object is silently wrong —
 * `typeof [] === 'object'` is true, so `rel.slug` is `undefined` and the filter
 * options came out empty. Only the first slug is needed to *name* an option;
 * the data attributes below carry every slug so filtering stays correct.
 */
function relSlug(rel: CmsRelation | CmsRelation[] | undefined): string {
  return relationSlugs(rel)[0] ?? ''
}

/** Bengali display name of a relation. */
function relName(rel: CmsRelation | CmsRelation[] | undefined): string {
  return relationName(rel)
}

/** Every slug, space-separated, for the `data-level` / `data-district` match. */
function relSlugs(rel: CmsRelation | CmsRelation[] | undefined): string {
  return relationSlugs(rel).join(' ')
}

/** Unique level options from the deadlines themselves (not all levels). */
const levelOptions = new Map<string, string>()
const districtOptions = new Map<string, string>()
for (const d of deadlines) {
  const ls = relSlug(d.level)
  if (ls) levelOptions.set(ls, relName(d.level))
  const ds = relSlug(d.district)
  if (ds) districtOptions.set(ds, relName(d.district))
}

const TODAY = new Date()
TODAY.setHours(0, 0, 0, 0)

function daysUntil(date: string | null | undefined): number | null {
  if (!date) return null
  const target = new Date(date)
  target.setHours(0, 0, 0, 0)
  return Math.round((target.getTime() - TODAY.getTime()) / 86_400_000)
}

function urgencyLabel(days: number | null): { text: string; urgent: boolean } | null {
  if (days === null) return null
  if (days < 0) return { text: 'শেষ', urgent: false }
  if (days === 0) return { text: 'আজ', urgent: true }
  if (days === 1) return { text: 'আগামীকাল', urgent: true }
  return { text: `${toBnDigits(days)} দিন বাকি`, urgent: days <= 3 }
}

function formatDate(date: string | null | undefined): string {
  if (!date) return ''
  return formatBnBd(date, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
}
---

<Layout
  title="শিক্ষা ক্যালেন্ডার ও ডেডলাইন"
  description="বৃত্তি, ভর্তি, পরীক্ষা ও ফলাফলের সব গুরুত্বপূর্ণ তারিখ ও সময়সূচি একনজরে।"
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'ডেডলাইন', href: '/deadlines' }]} />

    <header class="mb-6 border-b-2 border-brand-red pb-3">
      <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
        শিক্ষা ক্যালেন্ডার ও ডেডলাইন
      </h1>
      <p class="mt-2 text-base text-ink-muted dark:text-dark-ink-muted">
        বৃত্তির আবেদন, ভর্তির সময়সীমা, পরীক্ষার রুটিন ও ফলাফলের তারিখ একনজরে জেনে নিন।
      </p>
    </header>

    {
      deadlines.length === 0 ? (
        <p class="rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">
          বর্তমানে কোনো সময়সীমা বা ডেডলাইন নেই।
        </p>
      ) : (
        <>
          {/* N2/N9 filter bar — client-side, no-JS fallback shows all */}
          <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="ফিল্টার">
            <div class="flex flex-wrap gap-1.5">
              {TYPE_FILTERS.map((t) => (
                <button
                  type="button"
                  data-type-filter={t.value}
                  class="rounded-full border border-rule px-3 py-1 text-xs font-medium text-ink-muted transition-colors hover:border-brand-red hover:text-brand-red aria-pressed:border-brand-red aria-pressed:bg-brand-red aria-pressed:text-white dark:border-dark-rule dark:text-dark-ink-muted dark:aria-pressed:border-brand-red dark:aria-pressed:text-white"
                  aria-pressed={t.value === ''}
                >
                  {t.label}
                </button>
              ))}
            </div>
            {levelOptions.size > 0 && (
              <select data-level-filter class="min-h-12 rounded-md border border-rule bg-surface px-3 text-sm text-ink dark:border-dark-rule dark:bg-dark-surface dark:text-dark-ink" aria-label="শিক্ষার স্তর নির্বাচন করুন">
                <option value="">সব স্তর</option>
                {[...levelOptions.entries()].map(([slug, name]) => (
                  <option value={slug}>{name}</option>
                ))}
              </select>
            )}
            {districtOptions.size > 0 && (
              <select data-district-filter class="min-h-12 rounded-md border border-rule bg-surface px-3 text-sm text-ink dark:border-dark-rule dark:bg-dark-surface dark:text-dark-ink" aria-label="জেলা নির্বাচন করুন">
                <option value="">সব জেলা</option>
                {[...districtOptions.entries()].map(([slug, name]) => (
                  <option value={slug}>{name}</option>
                ))}
              </select>
            )}
          </div>

          <ul id="deadline-list" class="flex flex-col gap-3">
            {deadlines.map((deadline) => {
              const days = daysUntil(deadline.dateEnd ?? deadline.dateStart)
              const urgency = urgencyLabel(days)
              const typeLabel = deadline.type ? TYPE_LABELS[deadline.type] ?? deadline.type : null
              const lSlug = relSlugs(deadline.level)
              const dSlug = relSlugs(deadline.district)

              return (
                <li
                  data-deadline-item
                  data-type={deadline.type ?? ''}
                  data-level={lSlug}
                  data-district={dSlug}
                  class="rounded-lg border border-rule bg-surface p-4 dark:border-dark-rule dark:bg-dark-surface"
                >
                  <div class="flex flex-wrap items-center gap-2">
                    {typeLabel && (
                      <span class="rounded bg-brand-red/10 px-2 py-0.5 text-xs font-semibold text-brand-red-on-tint dark:text-brand-red-on-tint-dark dark:bg-brand-red/20">
                        {typeLabel}
                      </span>
                    )}
                    {urgency && (
                      <span
                        class:list={[
                          'text-xs font-semibold',
                          urgency.urgent
                            ? 'text-brand-red'
                            : 'text-ink-subtle dark:text-dark-ink-muted',
                        ]}
                      >
                        {urgency.text}
                      </span>
                    )}
                  </div>

                  <h2 class="font-headline mt-2 text-lg font-bold text-ink dark:text-dark-ink">
                    {deadline.title}
                  </h2>

                  {deadline.description && (
                    <p class="mt-1 text-sm text-ink-muted dark:text-dark-ink-muted">
                      {deadline.description}
                    </p>
                  )}

                  <time class="mt-2 block text-xs text-ink-subtle dark:text-dark-ink-muted">
                    {formatDate(deadline.dateEnd ?? deadline.dateStart)}
                  </time>

                  {/* N7 — opt-in only. Renders nothing without a VAPID key, a CMS
                      origin, or a reminder moment that is still in the future. */}
                  <DeadlineReminder
                    deadlineId={deadline.id}
                    deadlineTitle={deadline.title}
                    deadlineDate={deadline.dateEnd ?? deadline.dateStart}
                    cmsOrigin={cmsOrigin}
                  />
                </li>
              )
            })}
          </ul>

          {/* No-results message — shown by the script when all items are hidden */}
          <p id="no-results" class="mt-4 hidden rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">
            এই বিভাগে বর্তমানে কোনো ডেডলাইন পাওয়া যায়নি।
          </p>
        </>
      )
    }
  </div>
</Layout>

<script>
  (function () {
    var list = document.getElementById('deadline-list')
    if (!list) return
    var items = list.querySelectorAll('[data-deadline-item]')
    var typeChips = document.querySelectorAll('[data-type-filter]')
    var levelSelect = document.querySelector('[data-level-filter]')
    var districtSelect = document.querySelector('[data-district-filter]')
    var noResults = document.getElementById('no-results')

    var activeType = ''
    var activeLevel = ''
    var activeDistrict = ''

    function applyFilters() {
      var visible = 0
      items.forEach(function (item) {
        var type = item.getAttribute('data-type') || ''
        // hasMany relations: several slugs, space-separated, match on any.
        var levels = (item.getAttribute('data-level') || '').split(/\s+/).filter(Boolean)
        var districts = (item.getAttribute('data-district') || '').split(/\s+/).filter(Boolean)

        var match =
          (!activeType || type === activeType) &&
          (!activeLevel || levels.length === 0 || levels.indexOf(activeLevel) !== -1) &&
          (!activeDistrict || districts.length === 0 || districts.indexOf(activeDistrict) !== -1)

        if (match) {
          item.classList.remove('hidden')
          visible++
        } else {
          item.classList.add('hidden')
        }
      })

      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0)
      }
    }

    typeChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        activeType = chip.getAttribute('data-type-filter') || ''
        typeChips.forEach(function (c) {
          c.setAttribute('aria-pressed', 'false')
        })
        chip.setAttribute('aria-pressed', 'true')
        applyFilters()
      })
    })

    if (levelSelect) {
      levelSelect.addEventListener('change', function () {
        activeLevel = levelSelect.value
        applyFilters()
      })
    }

    if (districtSelect) {
      districtSelect.addEventListener('change', function () {
        activeDistrict = districtSelect.value
        applyFilters()
      })
    }
  })()
</script>
