---
/**
 * Citizen journalism submission — `/citizen`.
 *
 * ## What this page promises, and what it must not
 *
 * A reader submitting a news tip is doing unpaid work on the strength of an
 * expectation. So the page states three things plainly and keeps all three:
 *
 *   1. **It is a tip, not a story.** The confirmation says an editor will look
 *      at it. Nothing is published from here — `POST /api/citizen/submit`
 *      writes a row with `status: 'new'`, and no route renders it.
 *   2. **Their contact details are not public.** The CMS restricts
 *      `reporterEmail` and `reporterPhone` to authenticated users at the field
 *      level, so an editor sees them and a reader never can.
 *   3. **A photo can carry location data.** Uploaded media is re-encoded and
 *      stripped of EXIF by the media pipeline, but the page says to avoid
 *      sending anything they would not want identified.
 *
 * ## Self-hiding
 *
 * With no CMS origin or the flag off, the form is not rendered — a submission
 * form that cannot submit is worse than no form (`docs/reliability.md` §4).
 *
 * ## No CAPTCHA
 *
 * The guard is a honeypot plus 3 submissions per IP per 10 minutes, enforced
 * server-side. Every free CAPTCHA needs a third-party script, which costs the
 * data-saver and initial-payload budgets, and reCAPTCHA needs an account the
 * owner cannot open.
 */
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { getPublicCmsOrigin } from '../lib/interactive'
import { isEnabled } from '../lib/feature-flags'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  getDistricts,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
} from '../lib/cms'

const [settings, categories, footerPages, districts] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getDistricts().catch(() => []),
])

const cmsOrigin = getPublicCmsOrigin()
const renderable = Boolean(cmsOrigin) && isEnabled('citizen')
---

<Layout
  title="খবর পাঠান"
  description="আপনার এলাকার শিক্ষা সংক্রান্ত খবর, ছবি বা তথ্য শিক্ষা২৪-কে পাঠান।"
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'খবর পাঠান' }]} />

    <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
      খবর পাঠান
    </h1>

    <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-muted dark:text-dark-ink-muted">
      আপনার এলাকার শিক্ষা সংক্রান্ত খবর, প্রতিষ্ঠানের তথ্য বা ছবি আমাদের পাঠাতে পারেন।
      সম্পাদকীয় দল যাচাই করে প্রয়োজনীয় পদক্ষেপ নেবে।
    </p>

    {
      !renderable ? (
        <p class="mt-4 text-base text-ink-muted dark:text-dark-ink-muted">
          এই ফর্মটি এই মুহূর্তে চালু নেই।
        </p>
      ) : (
        <form class="mt-6 max-w-2xl" data-citizen-form data-origin={cmsOrigin} novalidate>
          <div>
            <label for="citizen-title" class="block text-sm font-semibold text-ink dark:text-dark-ink">
              শিরোনাম
            </label>
            <input
              id="citizen-title"
              name="title"
              type="text"
              required
              maxlength="200"
              class="mt-1 min-h-12 w-full rounded-md border border-rule bg-white px-3 text-base text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
            />
          </div>

          <div class="mt-4">
            <label for="citizen-body" class="block text-sm font-semibold text-ink dark:text-dark-ink">
              বিস্তারিত
            </label>
            <textarea
              id="citizen-body"
              name="body"
              required
              rows="7"
              maxlength="5000"
              class="mt-1 w-full rounded-md border border-rule bg-white px-3 py-2 text-base leading-relaxed text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
            ></textarea>
            <p class="mt-1 text-xs text-ink-subtle dark:text-dark-ink-muted">
              কোথায়, কখন, কে — এই তথ্যগুলো থাকলে যাচাই করা সহজ হয়।
            </p>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="citizen-name" class="block text-sm font-semibold text-ink dark:text-dark-ink">
                আপনার নাম
              </label>
              <input
                id="citizen-name"
                name="reporterName"
                type="text"
                required
                maxlength="120"
                autocomplete="name"
                class="mt-1 min-h-12 w-full rounded-md border border-rule bg-white px-3 text-base text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
              />
            </div>

            <div>
              <label for="citizen-email" class="block text-sm font-semibold text-ink dark:text-dark-ink">
                ইমেইল
              </label>
              <input
                id="citizen-email"
                name="reporterEmail"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                class="mt-1 min-h-12 w-full rounded-md border border-rule bg-white px-3 text-base text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
              />
            </div>

            <div>
              <label for="citizen-phone" class="block text-sm font-semibold text-ink dark:text-dark-ink">
                ফোন <span class="font-normal text-ink-subtle">(ঐচ্ছিক)</span>
              </label>
              <input
                id="citizen-phone"
                name="reporterPhone"
                type="tel"
                maxlength="40"
                autocomplete="tel"
                inputmode="tel"
                class="mt-1 min-h-12 w-full rounded-md border border-rule bg-white px-3 text-base text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
              />
            </div>

            {
              districts.length > 0 && (
                <div>
                  <label
                    for="citizen-district"
                    class="block text-sm font-semibold text-ink dark:text-dark-ink"
                  >
                    জেলা <span class="font-normal text-ink-subtle">(ঐচ্ছিক)</span>
                  </label>
                  <select
                    id="citizen-district"
                    name="district"
                    class="mt-1 min-h-12 w-full rounded-md border border-rule bg-white px-3 text-base text-ink dark:border-dark-rule dark:bg-dark-base dark:text-dark-ink"
                  >
                    <option value="">নির্বাচন করুন</option>
                    {districts.map((district) => (
                      <option value={district.id}>{district.nameBn}</option>
                    ))}
                  </select>
                </div>
              )
            }
          </div>

          {/* Honeypot — off-screen, never focusable, never filled by a human. */}
          <input
            type="text"
            name="company"
            data-citizen-honeypot
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="pointer-events-none absolute h-0 w-0 opacity-0"
          />

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button
              type="submit"
              data-citizen-submit
              class="min-h-12 rounded-md bg-brand-red px-5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-60"
            >
              পাঠান
            </button>
            <p
              data-citizen-status
              role="status"
              aria-live="polite"
              class="min-h-5 text-sm text-ink-muted dark:text-dark-ink-muted"
            >
            </p>
          </div>

          <p class="mt-3 text-xs leading-relaxed text-ink-subtle dark:text-dark-ink-muted">
            জমা দেওয়া তথ্য স্বয়ংক্রিয়ভাবে প্রকাশিত হয় না — সম্পাদক যাচাই করে সিদ্ধান্ত নেন।
            আপনার ইমেইল ও ফোন নম্বর কখনো প্রকাশ করা হয় না। ছবি পাঠালে সেটি থেকে অবস্থানের তথ্য
            মুছে ফেলা হয়।
          </p>
        </form>
      )
    }
  </div>
</Layout>

<script>
  /**
   * Citizen submission.
   *
   * Posts to `POST /api/citizen/submit` rather than the generated collection
   * route: the generated one would let a caller set `status`, and cannot rate
   * limit. The server hard-sets `status: 'new'` regardless of what is sent.
   */
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-citizen-form]')) {
    const origin = form.dataset.origin
    const status = form.querySelector<HTMLElement>('[data-citizen-status]')
    const submit = form.querySelector<HTMLButtonElement>('[data-citizen-submit]')
    const honeypot = form.querySelector<HTMLInputElement>('[data-citizen-honeypot]')

    if (!origin || !submit) continue

    const setStatus = (message: string): void => {
      if (status) status.textContent = message
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      const data = new FormData(form)
      const title = String(data.get('title') ?? '').trim()
      const body = String(data.get('body') ?? '').trim()
      const reporterName = String(data.get('reporterName') ?? '').trim()
      const reporterEmail = String(data.get('reporterEmail') ?? '').trim()

      if (!title || !body || !reporterName || !reporterEmail) {
        setStatus('শিরোনাম, বিস্তারিত, নাম ও ইমেইল পূরণ করুন।')
        return
      }

      const district = String(data.get('district') ?? '')
      const reporterPhone = String(data.get('reporterPhone') ?? '').trim()

      submit.disabled = true
      setStatus('পাঠানো হচ্ছে…')

      try {
        const response = await fetch(`${origin}/api/citizen/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            title,
            body,
            reporterName,
            reporterEmail,
            ...(reporterPhone ? { reporterPhone } : {}),
            ...(district ? { district: Number(district) } : {}),
            company: honeypot?.value ?? '',
          }),
        })

        const payload = (await response.json().catch(() => ({}))) as { error?: string }

        if (response.ok) {
          form.reset()
          setStatus('ধন্যবাদ — আপনার পাঠানো তথ্য সম্পাদকীয় দলের কাছে পৌঁছেছে।')
        } else if (response.status === 429) {
          setStatus('অনেকবার জমা দেওয়া হয়েছে। কিছুক্ষণ পরে আবার চেষ্টা করুন।')
        } else {
          setStatus(payload.error ?? 'জমা দেওয়া যায়নি। আবার চেষ্টা করুন।')
        }
      } catch {
        setStatus('সংযোগ করা যায়নি। একটু পরে আবার চেষ্টা করুন।')
      } finally {
        submit.disabled = false
      }
    })
  }
</script>
