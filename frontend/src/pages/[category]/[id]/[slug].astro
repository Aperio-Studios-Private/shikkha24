---
/**
 * Article page (S4) — new URL architecture `/:category/:id/:slug` (S11).
 *
 * The `:id` is the stable part — a headline edit changes the slug but not
 * the URL, because the ID does not move. See `lib/url.ts` and
 * `docs/seo-plan.md` §2.
 *
 * ## Rendering the body
 *
 * The body is Lexical JSON from Payload, converted to HTML by
 * `lib/richtext.ts`, which escapes everything. The CMS is never trusted to
 * emit markup: reporter-entered text is still user input, and this page carries
 * our domain's authority.
 *
 * ## Graceful degradation
 *
 * If the CMS is unreachable at build time, `getAllArticlePaths` returns nothing
 * and no article pages are generated — the build still succeeds. A missing
 * article is a 404 at runtime, not a broken build.
 */
import Layout from '../../../layouts/Layout.astro'
import KeyTakeaways from '../../../components/KeyTakeaways.astro'
import AuthorCard from '../../../components/AuthorCard.astro'
import RelatedArticles from '../../../components/RelatedArticles.astro'
import ShareRow from '../../../components/ShareRow.astro'
import BookmarkButton from '../../../components/BookmarkButton.astro'
import BookmarkSync from '../../../components/BookmarkSync.astro'
import ReadingProgress from '../../../components/ReadingProgress.astro'
import CorrectionNotice from '../../../components/CorrectionNotice.astro'
import ArticleAudio from '../../../components/ArticleAudio.astro'
import PrintStyles from '../../../components/PrintStyles.astro'
import SponsoredLabel from '../../../components/SponsoredLabel.astro'
import AdSlot from '../../../components/AdSlot.astro'
import ContentBlockScripts from '../../../components/ContentBlockScripts.astro'
import CommentSection from '../../../components/CommentSection.astro'
import ReactionBar from '../../../components/ReactionBar.astro'
import PhotoStory from '../../../components/PhotoStory.astro'
import MediaEmbed from '../../../components/MediaEmbed.astro'
import { countParagraphs, lexicalToHtml, lexicalToPlainText, splitHtmlAtParagraph } from '../../../lib/richtext'
import { mediaUrl, resolveCmsImage } from '../../../lib/media'
import CmsImage from '../../../components/CmsImage.astro'
import { getPublicCmsOrigin } from '../../../lib/interactive'
import { getApprovedComments } from '../../../lib/engagement'
import { articleUrl } from '../../../lib/url'
import { resolvePhotoFrames } from '../../../lib/photo-story'
import ArticlePlaceholder from '../../../components/ArticlePlaceholder.astro'
import FramedImage from '../../../components/FramedImage.astro'
import { videoEmbedProps } from '../../../lib/video'
import { toBnDigits, formatBnBd, getDhakaYearMonth } from '../../../lib/bangla-date'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  getAllArticlePaths,
  getArticleBySlug,
  getRelatedArticles,
  getAuthor,
  relationEntries,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
} from '../../../lib/cms'

export async function getStaticPaths() {
  const paths = await getAllArticlePaths().catch(() => [])
  // No CMS → no article pages. The build must still succeed.
  return paths
    .filter((p) => p.categorySlug)
    .map((p) => ({
      params: {
        category: p.categorySlug!,
        id: String(p.id),
        slug: p.slug,
      },
    }))
}

const { slug, id, category: categorySlug } = Astro.params

const [settings, categories, footerPages] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
])

const article = await getArticleBySlug(slug!).catch(() => null)

// Unknown slug → 404. Astro serves the framework's default 404 for a missing
// route; returning it explicitly keeps the behaviour obvious.
if (!article) return Astro.redirect('/404')

// Verify the ID in the URL matches the article — prevents a wrong-ID/right-slug
// URL from rendering (someone could link /education-news/999/real-slug).
if (String(article.id) !== id) return Astro.redirect('/404')

const [author, related] = await Promise.all([
  getAuthor(article.author).catch(() => null),
  getRelatedArticles(article).catch(() => []),
])

/**
 * Tags for the footer row.
 *
 * `article.tags` is a `hasMany` relationship, so Payload returns an array — and
 * at `depth=0` it would be bare ids. `relationEntries` normalises both and drops
 * anything without a slug, so a chip never links to `/tag/12`.
 */
const tagEntries = relationEntries(article.tags)

/**
 * Comments — baked in at build time, like everything else on this page.
 *
 * Fetched only when there is a CMS origin to submit to. With no origin the
 * section is not rendered at all, so there is no point paying for the request:
 * a comment list with no way to comment is a dead end. This is the same
 * self-hiding rule the S8 islands follow.
 */
const cmsOrigin = getPublicCmsOrigin()
const comments = cmsOrigin ? await getApprovedComments(article.id).catch(() => []) : []

const bodyHtml = lexicalToHtml(article.body)
const bodyText = lexicalToPlainText(article.body)

/**
 * Mid-article ad placement.
 *
 * Splitting the body is only worth doing on a piece long enough that a reader
 * scrolls past the middle — on a four-paragraph story an "in-article" unit lands
 * next to the byline and reads as a mistake. Six paragraphs is the floor, and the
 * cut is made at the midpoint rather than a fixed paragraph count so short and
 * long pieces both get a sensible position.
 */
const paragraphCount = countParagraphs(bodyHtml)
const showMiddleAd = paragraphCount >= 6
const [bodyBeforeAd, bodyAfterAd] = showMiddleAd
  ? splitHtmlAtParagraph(bodyHtml, Math.floor(paragraphCount / 2))
  : [bodyHtml, '']

const category =
  article.category && typeof article.category === 'object' ? article.category : null

/**
 * Hero image — the article's own photo, else the category archetype.
 *
 * The homepage cards have always fallen back to `getCategoryImage()`; this page
 * did not. It rendered the hero only when `featuredImage` resolved, so an
 * article with no photo of its own (which is most of them — reporters publish
 * the text first and upload a photo later) showed no image at all, while its
 * card on the homepage showed the category archetype.
 *
 * Sharing `resolveCmsImage` with the cards also means the hero gets a real
 * `srcset` from the CMS variants and the true dimensions, instead of the
 * hard-coded 1200×675 box this page used to reserve.
 */
const photo = resolveCmsImage(article.featuredImage, article.title)

/**
 * The social preview image — the featured photo when there is one, otherwise this
 * article's own branded card.
 *
 * ⚠️ **Why the card is the fallback, not the default.** `Layout` already falls
 * back to the site-wide `/og-default.png`, so an article with no featured image
 * used to share as the same generic picture as every other one. S14's photocard is
 * a per-article 1200×1200 image — the featured photo darkened, with the headline,
 * category and site name over it — and `lib/id-card.ts` calls it "built for
 * Facebook" because the sharer scrapes this very tag.
 *
 * The featured photo still wins when it exists: it is the real journalism, and the
 * card is a composite of it anyway.
 *
 * ⚠️ **`cmsOrigin` is what makes this safe.** Without it the URL would be a
 * same-origin `/api/…` path, and the static host serves no `/api/` — the exact
 * defect that shipped in the S14 share links and only surfaced in CI. `null` here
 * means the page keeps the working `/og-default.png`.
 */
const socialImage =
  photo?.src ?? (cmsOrigin ? `${cmsOrigin}/api/photocard/${article.id}.png` : undefined)

const published = article.publishedAt
  ? formatBnBd(article.publishedAt, { day: 'numeric', month: 'long', year: 'numeric' })
  : null

/**
 * `YYYY-MM` for the search page's date filter.
 *
 * Derived with `getDhakaYearMonth()` so the filter key always agrees with the
 * displayed date — both anchored to Asia/Dhaka. A story published at 02:00
 * Dhaka on 1 September shows "1 সেপ্টেম্বর" and has filter key `2026-09`,
 * even when built in UTC.
 */
const publishedMonth = article.publishedAt
  ? getDhakaYearMonth(article.publishedAt)
  : null

const canonical = new URL(articleUrl(article), Astro.site ?? Astro.url).href

/**
 * Article JSON-LD — `NewsArticle` per `docs/seo-plan.md` §4.
 *
 * `NewsArticle` (not the generic `Article`) is what Google News and Discover
 * need. Key requirements from the spec:
 *   - headline ≤110 chars (matching the visible `<h1>`)
 *   - image ≥1200px wide and ≥800,000px² — the archetype or the photo
 *   - datePublished / dateModified in ISO 8601 with +06:00 offset
 *   - author as `Person` with `sameAs` when available
 *   - publisher as `Organization` with logo
 *   - `isAccessibleForFree: true` — all content is free
 *   - `speakable` — the headline and summary are the parts a voice assistant reads
 *
 * Sponsored articles keep the same schema; the «বিজ্ঞাপন» label is a
 * visible human-readable signal, not a schema property (`docs/seo-plan.md` §6a).
 */
const siteUrl = Astro.site?.href ?? Astro.url.origin

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title,
  description: article.excerpt ?? undefined,
  // ⚠️ Use `socialImage`, not `photo?.src`. The schema used to emit `image` only
  // when the article had a featured photo, so an article without one carried **no
  // `image` property at all** — and Google News treats `image` as required for
  // `NewsArticle`. Since the CMS media files are currently unreadable on the host
  // (T-25), that was *every* article. `socialImage` already resolves the correct
  // chain (featured photo → this article's branded photocard → nothing, and
  // `Layout` supplies `/og-default.png`), and its photocard branch is verified
  // live: `GET /api/photocard/23.png` → 200, 80,860 bytes. The schema now
  // agrees with the `og:image` tag instead of silently disagreeing with it.
  image: socialImage ? [socialImage] : undefined,
  datePublished: article.publishedAt ?? undefined,
  dateModified: article.updatedAt ?? article.publishedAt ?? undefined,
  author: author
    ? {
        '@type': 'Person',
        name: author.nameBn,
        alternateName: author.nameEn ?? undefined,
        // `new URL` rather than `${siteUrl}/author/…`: `Astro.site.href` already
        // ends in a slash, so interpolation produced `…com//author/…` — a dead
        // URL in the structured data that no `href` check would ever see.
        url: author.slug
          ? new URL(`/author/${author.slug}`, Astro.site ?? Astro.url).href
          : undefined,
      }
    : { '@type': 'Person', name: settings.siteName },
  publisher: {
    '@type': 'Organization',
    name: settings.siteName,
    alternateName: settings.siteNameEn ?? undefined,
    // `mediaUrl()` — not the raw `settings.logo.url`. Payload stores a
    // *relative* `/api/media/file/…`, and the static host serves no `/api/`, so
    // the raw value was a publisher logo pointing at a 404 on every article.
    // Google News reads this field, and the JSON-LD surface is invisible to an
    // `href`-only link check — which is why `verify:links` now reads it too.
    logo: mediaUrl(settings.logo?.url)
      ? { '@type': 'ImageObject', url: mediaUrl(settings.logo?.url) }
      : undefined,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'bn-BD',
  articleSection: category?.nameBn ?? undefined,
  isAccessibleForFree: true,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article h1', 'article .article-excerpt'],
  },
  isPartOf: {
    '@type': 'NewsMediaOrganization',
    name: settings.siteName,
    url: siteUrl,
  },
}

/*
 * ── S17: photo story and video news ─────────────────────────────────────────
 *
 * Both are optional decorations on an ordinary article: the layout decides which
 * template presents the body, and a video URL adds a player above it. An article
 * with neither renders exactly as it did before this section existed, so nothing
 * here changes the common path.
 */
const isPhotoStory = article.layout === 'photoStory'
const photoFrames = resolvePhotoFrames(article.photoStory)

/** The video, when the stored URL validates. `null` renders nothing at all. */
const videoEmbed = videoEmbedProps(article)

/*
 * A photo story is an image gallery as far as a crawler is concerned, so the
 * gallery schema is emitted **in addition to** the `NewsArticle`, never instead
 * of it — the article is still the page's subject, and the gallery only describes
 * how it is presented. `Layout` already accepts an array of JSON-LD objects.
 */
const imageGalleryLd =
  isPhotoStory && photoFrames.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ImageGallery',
        name: article.title,
        url: canonical,
        inLanguage: 'bn-BD',
        numberOfItems: photoFrames.length,
        image: photoFrames.map((frame) => ({
          '@type': 'ImageObject',
          url: frame.image.src,
          width: frame.image.width,
          height: frame.image.height,
          caption: frame.caption || undefined,
        })),
      }
    : null
---

<Layout
  title={article.title}
  description={article.excerpt ?? undefined}
  canonical={canonical}
  ogImage={socialImage}
  publishDate={article.publishedAt ?? undefined}
  modifiedDate={article.updatedAt ?? article.publishedAt ?? undefined}
  jsonLd={imageGalleryLd ? [jsonLd, imageGalleryLd] : jsonLd}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <ReadingProgress />
  <PrintStyles />
  {/* Enhances the before/after and scrollytelling blocks, if this article has
      any. Renders nothing itself; both blocks are readable without it. */}
  <ContentBlockScripts />

  {/* data-pagefind-body scopes the search index to the story itself, so
      results are not polluted by the nav, sidebar or footer. */}
  <article class="container-page py-6" data-pagefind-body>
    {/*
      ── Pagefind filters ────────────────────────────────────────────────────
      The section and date axes of `/search`.

      Inline (`key:value`) form, so the value comes from the attribute rather
      than from the element's text — a filter element with visible content would
      also be indexed as body text.

      **The keys are Bengali on purpose.** Pagefind UI renders the *filter key*
      as the group heading and ships no per-filter label translation (only
      `filters_label`), so an English key would put an English heading on an
      otherwise Bengali page.

      **The date value is `YYYY-MM` in Bengali numerals.** Bengali digits run
      U+09E6–U+09EF consecutively, so `২০২৬-০৯` still sorts chronologically as a
      string — which a month *name* would not, and which matters because
      Pagefind offers no way to reorder filter values.
    */}
    {category?.nameBn && <span data-pagefind-filter={`বিভাগ:${category.nameBn}`} hidden />}
    {publishedMonth && <span data-pagefind-filter={`তারিখ:${toBnDigits(publishedMonth)}`} hidden />}

    <div class="grid-12">
      <div class="col-span-4 sm:col-span-8 lg:col-span-8">
        {/* Breadcrumb */}
        <nav aria-label="পৃষ্ঠার অবস্থান" class="mb-3">
          <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-subtle dark:text-dark-ink-muted">
            <li><a href="/" class="hover:text-brand-red">হোম</a></li>
            {
              category && (
                <>
                  <li aria-hidden="true">/</li>
                  <li>
                    <a href={`/category/${category.slug}`} class="hover:text-brand-red">
                      {category.nameBn}
                    </a>
                  </li>
                </>
              )
            }
          </ol>
        </nav>

        {/* Paid content must be disclosed before the headline is read. */}
        {article.isSponsored && (
          <SponsoredLabel sponsorName={article.sponsorName} variant="banner" />
        )}

        {/* Headline */}
        <h1 class="font-headline text-2xl font-bold leading-tight text-ink sm:text-3xl lg:text-4xl dark:text-dark-ink">
          {article.title}
        </h1>

        {/* Byline */}
        <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-subtle dark:text-dark-ink-muted">
          {
            author && (
              <span class="font-medium text-ink dark:text-dark-ink">
                {author.slug ? (
                  <a href={`/author/${author.slug}`} class="hover:text-brand-red hover:underline">
                    {author.nameBn}
                  </a>
                ) : (
                  author.nameBn
                )}
              </span>
            )
          }
          {published && (
            <time datetime={article.publishedAt ?? undefined}>{published}</time>
          )}
          {
            article.readingTimeMinutes ? (
              <>
                <span aria-hidden="true">·</span>
                <span>{toBnDigits(article.readingTimeMinutes)} মিনিট</span>
              </>
            ) : null
          }
          {article.isBreaking && (
            <span class="rounded bg-brand-red px-1.5 py-0.5 text-xs font-semibold text-white">
              ব্রেকিং
            </span>
          )}
          {article.isSponsored && (
            <SponsoredLabel sponsorName={article.sponsorName} />
          )}
        </div>

        {
          /* The hero is the LCP element on this page, so it is eager and
             high-priority. The wrapper carries `aspect-16/9` and writes
             intrinsic width/height, so the box is reserved before the bytes
             arrive — zero CLS, which the budget treats as a hard gate.
             Owner rule changed 2026-10-18: an article without its own cover now
             renders the brand placeholder (white panel, centred logo) rather
             than text alone. The box is unchanged, so CLS is identical to the
             photo case and a cover added later does not shift the layout. */
          <div class="mt-5 aspect-16/9 w-full overflow-hidden rounded-lg bg-surface-raised dark:bg-dark-raised">
            {photo ? (
              /* The hero is the LCP element: eager + high priority, and
                 FramedImage so an off-ratio cover fills its own gaps rather
                 than being cropped or letterboxed. */
              <FramedImage
                src={photo.src}
                width={photo.width}
                height={photo.height}
                alt={photo.alt}
                sizes="(min-width: 1024px) 800px, 100vw"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full"
              />
            ) : (
              <ArticlePlaceholder class="h-full w-full" markHeight={96} />
            )}
          </div>
        }

        {/* Correction — above the body, never buried */}
        <CorrectionNotice
          notice={article.correctionNotice?.hasCorrection ? article.correctionNotice.note : null}
          updatedAt={article.updatedAt}
        />

        {article.keyTakeaways?.length ? (
          <KeyTakeaways points={article.keyTakeaways.map((k) => k.point)} />
        ) : null}

        {bodyText && <ArticleAudio text={`${article.title}. ${bodyText}`} />}

        {/* S17. A video sits directly above the body: the reader meets it before
            the prose. It is click-to-load, so the markup carries no iframe and no
            third-party URL until they tap play. */}
        {
          videoEmbed && (
            <div class="mt-6">
              <MediaEmbed
                provider={videoEmbed.provider}
                videoId={videoEmbed.videoId}
                pageUrl={videoEmbed.pageUrl}
                title={article.title}
                poster={photo}
              />
            </div>
          )
        }

        {/* S17. A photo story presents its frames ahead of the prose — the
            editorial text stays, because a layout should not silently discard what
            an editor wrote. Every frame reserves its box from the image's true
            dimensions; this is the most image-dense page on the site. */}
        {isPhotoStory && photoFrames.length > 0 && <PhotoStory frames={photoFrames} />}

        {/* In-article, top — placed after the header block so it can never land
            in the initial viewport, which the performance budget forbids. */}
        <div class="mt-6 flex justify-center">
          <AdSlot position="articleTop" width={728} height={90} />
        </div>

        {/* Body — converted Lexical, already escaped. Split so a mid-article ad
            can sit inside the prose; the cut is always made directly after a
            `</p>`, so no tag is ever sliced in half. */}
        <div class="prose-bn mt-6 text-ink dark:text-dark-ink" set:html={bodyBeforeAd} />

        {
          showMiddleAd && (
            <div class="my-6 flex justify-center">
              <AdSlot position="articleMiddle" width={728} height={90} />
            </div>
          )
        }

        {showMiddleAd && (
          <div class="prose-bn text-ink dark:text-dark-ink" set:html={bodyAfterAd} />
        )}

        {/* Tags sit between the story and the share row: a reader who has just
            finished reading is the one who wants to browse the subject. */}
        {
          tagEntries.length > 0 && (
            <nav class="mt-6 flex flex-wrap items-center gap-2" aria-label="ট্যাগ">
              {tagEntries.map((tag) => (
                <a
                  href={`/tag/${tag.slug}`}
                  class="rounded-full border border-rule px-3 py-1.5 text-sm text-ink hover:border-brand-red hover:text-brand-red dark:border-dark-rule dark:text-dark-ink"
                >
                  {tag.name}
                </a>
              ))}
            </nav>
          )
        }

        {/* Share and save sit together — both are "keep this" actions, and a
            reader looking for one will look where the other is. The bookmark
            button needs no CMS origin: the list is browser-local. */}
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <ShareRow
            url={canonical}
            title={article.title}
            cardPath={`/api/photocard/${article.id}.png`}
          />
          <BookmarkButton
            kind="article"
            id={article.id}
            slug={article.slug}
            title={article.title}
          />
        </div>

        {/* Renders no markup — it mirrors bookmark changes to the CMS (S9). */}
        <BookmarkSync />

        <AuthorCard author={author} publishedAt={article.publishedAt} />

        {/* S16. After the byline and before the closing ad: a reader who has
            finished the story is the one who can react to it. The control
            self-hides when no CMS origin is configured, and it renders no counts
            — those are read at runtime, on the reader's first tap. */}
        <ReactionBar articleId={article.id} cmsOrigin={cmsOrigin} />

        <div class="mt-8 flex justify-center">
          <AdSlot position="articleBottom" width={728} height={90} />
        </div>

        {/* Below the ad, deliberately: a reader who has finished the story meets
            the discussion last, and an ad between the byline and the comments
            reads as an interruption of the conversation. */}
        <CommentSection articleId={article.id} comments={comments} cmsOrigin={cmsOrigin} />
      </div>

      {/* Sidebar — related articles on desktop.
          Excluded from the index: these headlines belong to other stories and
          would make this article match queries it is not about. */}
      <aside
        class="col-span-4 mt-8 sm:col-span-8 lg:col-span-4 lg:mt-0"
        data-pagefind-ignore
      >
        <div class="lg:sticky lg:top-4">
          <RelatedArticles articles={related} />
        </div>
      </aside>
    </div>
  </article>
</Layout>
