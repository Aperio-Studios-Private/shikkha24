---
/**
 * Shortlink redirect — `/a/:id` → `/:category/:id/:slug`.
 *
 * Per `docs/seo-plan.md` §2: "plus an automated shortlink for social
 * sharing." The shortlink is stable and never reused — the `:id` does not
 * change even if the slug is edited, so a link shared on WhatsApp remains
 * valid after a headline edit.
 *
 * This page resolves the ID to the full article URL at build time and
 * emits a 301 redirect via `<meta http-equiv="refresh">` + a canonical
 * link to the new URL.
 */
import { FALLBACK_SETTINGS, getAllArticlePaths, getSiteSettings } from '../../lib/cms'
import { articleUrl } from '../../lib/url'
import type { ArticleRef } from '../../lib/url'

export async function getStaticPaths() {
  const paths = await getAllArticlePaths().catch(() => [])
  return paths.map((p) => ({
    params: { id: String(p.id) },
    props: {
      slug: p.slug,
      categorySlug: p.categorySlug,
    },
  }))
}

const { slug, categorySlug } = Astro.props
const ref: ArticleRef = { id: Astro.params.id!, slug, category: categorySlug ? { slug: categorySlug } : null }
const newUrl = articleUrl(ref)
const canonical = new URL(newUrl, Astro.site ?? Astro.url).href

/** A bare redirect shell, but its `<title>` is still the brand. */
const settings = await getSiteSettings().catch(() => FALLBACK_SETTINGS)
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${canonical}`} />
    <title>{settings.siteName}</title>
  </head>
  <body>
    <p style="font-family: sans-serif; text-align: center; padding: 2rem;">
      <a href={canonical}>এগিয়ে যান</a>
    </p>
  </body>
</html>
