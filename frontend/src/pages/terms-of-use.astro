---
/**
 * Terms of use — `/terms-of-use`.
 *
 * Required for launch: Google News / E-E-A-T eligibility expects reachable
 * terms, and the footer links here from every page.
 *
 * ⚠️ **Why this is a static route, not a `/page/[slug]` CMS page.** Same reason
 * as `/privacy-policy` — the footer linked to `/page/terms-of-use`, but the CMS
 * `pages` collection is empty, so it 404'd everywhere (171 broken links, found
 * in the 2026-09-14 audit). `/about` and `/contact` already use static routes.
 *
 * The terms describe the site's actual editorial and comment behaviour, read
 * from the code: comments are moderated before publication, sponsored content is
 * labelled «বিজ্ঞাপন», and reader submissions are reviewed before use. If those
 * behaviours change, this page must change with them.
 */
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { getSiteSettings, getCategories, getFooterPages, FALLBACK_SETTINGS, FALLBACK_CATEGORIES } from '../lib/cms'
import { formatBnBd } from '../lib/bangla-date'

const [settings, categories, footerPages] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
])

const contactEmail = settings.contact?.email

const sections = [
  {
    id: 'acceptance',
    heading: 'শর্তাবলির স্বীকৃতি',
    paragraphs: [
      `এই সাইট ব্যবহার করার অর্থ আপনি এর ব্যবহারের যাবতীয় শর্তাবলি মেনে নিচ্ছেন। আপনি এই শর্তাবলিতে সম্মত না হলে সাইট ব্যবহার থেকে বিরত থাকুন।`,
    ],
  },
  {
    id: 'content',
    heading: 'সংবাদের ব্যবহার ও স্বত্ব',
    paragraphs: [
      'এই সাইটের সব সংবাদ, ছবি ও কনটেন্ট আমাদের বা সংশ্লিষ্ট মূল সূত্রের কপিরাইটভুক্ত। ব্যক্তিগত পাঠ, শিক্ষামূলক উদ্দেশ্য কিংবা সামাজিক মাধ্যমে শেয়ারের জন্য আপনি সংবাদের লিংক ব্যবহার করতে পারেন।',
      'পুরো সংবাদ হুবহু অনুকরণ বা অনুলিপি করে অন্য কোথাও নিজের নামে প্রকাশ করা সম্পূর্ণ নিষেধ। উদ্ধৃতি হিসেবে ব্যবহারের ক্ষেত্রে অবশ্যই সাইটের নাম ও মূল লিংক উল্লেখ করতে হবে।',
    ],
  },
  {
    id: 'comments',
    heading: 'মন্তব্য ও পাঠকের মতামত',
    paragraphs: [
      'পাঠকের মন্তব্য প্রকাশের আগে তা সম্পাদকীয়ভাবে পর্যবেক্ষণ করা হয়, ফলে প্রকাশের জন্য কিছুটা সময় লাগতে পারে।',
      'কাউকে ব্যক্তিগত আক্রমণ, উসকানিমূলক বা ধর্মীয় অনুভূতিতে আঘাত হানে এমন কোনো মন্তব্য প্রকাশ করা হয় না। এমন মন্তব্য মুছে ফেলার ও প্রয়োজনে সংশ্লিষ্ট অ্যাকাউন্ট বন্ধ করার পূর্ণ অধিকার সম্পাদকীয় বিভাগের রয়েছে।',
      'আমাদের সাইটে প্রেরিত কোনো তথ্য বা মতামতের প্রকাশ ও সম্পাদনার সার্বিক অধিকার আমাদের থাকবে।',
    ],
  },
  {
    id: 'accuracy',
    heading: 'তথ্যের নির্ভুলতা ও সংশোধন নীতি',
    paragraphs: [
      'আমরা প্রতিটি খবর বস্তুনিষ্ঠভাবে যাচাই করে প্রকাশ করি। তবে ভর্তি, পরীক্ষা ও সরকারি বিজ্ঞপ্তির সময়সীমা সময়ে সময়ে পরিবর্তিত হতে পারে।',
      'তাই যেকোনো চূড়ান্ত সিদ্ধান্ত নেওয়ার পূর্বে সংশ্লিষ্ট প্রতিষ্ঠানের অফিশিয়াল ওয়েবসাইট বা সরকারি বিজ্ঞপ্তি দেখে নেওয়ার পরামর্শ দেওয়া হচ্ছে। সাইটের তথ্যের ভিত্তিতে নেওয়া কোনো ব্যক্তিগত সিদ্ধান্তের জন্য কর্তৃপক্ষ দায়বদ্ধ থাকবে না।',
      'কোনো তথ্যগত অসঙ্গতি চোখে পড়লে অনুগ্রহ করে আমাদের জানান, আমরা দ্রুত তা সংশোধন করব।',
    ],
  },
  {
    id: 'sponsored',
    heading: 'বিজ্ঞাপন ও বাণিজ্যিক কনটেন্ট',
    paragraphs: [
      'বিজ্ঞাপনদাতার সৌজন্যে প্রকাশিত যেকোনো বিষয়বস্তু স্পষ্টভাবে «বিজ্ঞাপন» হিসেবে চিহ্নিত করা হয়, যাতে পাঠক তা সহজেই আলাদা করতে পারেন।',
      'বিজ্ঞাপনদাতার বক্তব্যের দায়ভার সম্পাদকীয় বিভাগের নয় এবং বিজ্ঞাপনের কারণে সম্পাদকীয় স্বাধীনতা ক্ষুণ্ণ হয় না।',
    ],
  },
  {
    id: 'liability',
    heading: 'দায়সীমা ও পরিবর্তন',
    paragraphs: [
      'সাইটের কারিগরি ত্রুটি বা বহিরাগত লিংকের বিষয়বস্তুর জন্য কর্তৃপক্ষ দায়ী থাকবে না।',
      'ব্যবহারের এই শর্তাবলি যেকোনো সময়ে হালনাগাদ করা হতে পারে। নতুন শর্ত কার্যকর হওয়ার পরও সাইট ব্যবহার অব্যাহত রাখলে ধরে নেওয়া হবে আপনি নতুন শর্তাবলিতেও সম্মত হয়েছেন।',
    ],
  },
]

const legal = settings.legal ?? {}
const legalRows = [
  { label: 'ট্রেড লাইসেন্স', value: legal.tradeLicense },
  { label: 'টিআইএন (TIN)', value: legal.tin },
  { label: 'তথ্য মন্ত্রণালয় নিবন্ধন', value: legal.ministryRegistration },
].filter((row) => Boolean(row.value))
---

<Layout
  title="ব্যবহারের শর্তাবলি"
  description={`${settings.siteName}: ব্যবহারের শর্তাবলি। সংবাদের ব্যবহার, মন্তব্যের নিয়ম ও দায়সীমা।`}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'ব্যবহারের শর্তাবলি' }]} />

    <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">
      ব্যবহারের শর্তাবলি
    </h1>

    <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink-muted dark:text-dark-ink-muted">
      এই পাতায় <strong class="font-semibold text-ink dark:text-dark-ink">{settings.siteName}</strong>
      ব্যবহারের নিয়মাবলি, পাঠকদের মন্তব্যের শর্ত ও দায়সীমা স্পষ্টভাবে তুলে ধরা হয়েছে।
    </p>

    <div class="mt-8 max-w-3xl space-y-8">
      {
        sections.map((section) => (
          <section id={section.id} aria-labelledby={`h-${section.id}`}>
            <h2
              id={`h-${section.id}`}
              class="font-headline text-lg font-bold text-ink dark:text-dark-ink"
            >
              {section.heading}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p class="mt-3 text-base leading-relaxed text-ink dark:text-dark-ink">{paragraph}</p>
            ))}
          </section>
        ))
      }

      <section
        id="contact"
        aria-labelledby="h-contact"
        class="border-t border-rule pt-6 dark:border-dark-rule"
      >
        <h2 id="h-contact" class="font-headline text-lg font-bold text-ink dark:text-dark-ink">
          যোগাযোগ
        </h2>
        <p class="mt-3 text-base leading-relaxed text-ink dark:text-dark-ink">
          ব্যবহারের শর্তাবলি নিয়ে কোনো প্রশ্ন থাকলে
          {contactEmail ? (
            <>
              {' '}
              <a href={`mailto:${contactEmail}`} class="text-brand-red hover:underline">
                {contactEmail}
              </a>
              {' '}ঠিকানায় ইমেইল করুন, অথবা
            </>
          ) : null}
          {' '}আমাদের <a href="/contact" class="text-brand-red hover:underline">যোগাযোগ</a> পাতা দেখুন।
        </p>
      </section>

      {
        legalRows.length > 0 && (
          <section
            id="publisher"
            aria-labelledby="h-publisher"
            class="border-t border-rule pt-6 dark:border-dark-rule"
          >
            <h2 id="h-publisher" class="font-headline text-lg font-bold text-ink dark:text-dark-ink">
              প্রকাশক
            </h2>
            <dl class="mt-3 grid gap-3 sm:grid-cols-2">
              {legalRows.map((row) => (
                <div class="rounded-lg border border-rule bg-surface p-4 dark:border-dark-rule dark:bg-dark-surface">
                  <dt class="text-sm font-medium text-ink-muted dark:text-dark-ink-muted">
                    {row.label}
                  </dt>
                  <dd class="mt-1 text-base text-ink dark:text-dark-ink">{row.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <p class="border-t border-rule pt-6 text-sm text-ink-muted dark:border-dark-rule dark:text-dark-ink-muted">
        শেষ হালনাগাদ: {formatBnBd(new Date(), { year: 'numeric', month: 'long' })}
      </p>
    </div>
  </div>
</Layout>
