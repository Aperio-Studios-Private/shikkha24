---
/**
 * Circular tracker — N8. Education + BCS/job circulars, deadline-sorted.
 *
 * BCS and government-job circulars are explicitly in scope (owner decision,
 * `docs/education-feature-inventory.md` §0).
 */
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { toBnDigits } from '../../lib/widgets'
import { getActiveCirculars } from '../../lib/education'
import {
  getSiteSettings, getCategories, getFooterPages,
  FALLBACK_SETTINGS, FALLBACK_CATEGORIES,
} from '../../lib/cms'

const [settings, categories, footerPages, circulars] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getActiveCirculars().catch(() => []),
])

const TYPE_LABELS: Record<string, string> = {
  education: 'শিক্ষা', bcs: 'বিসিএস',
  governmentJob: 'সরকারি চাকরি', privateJob: 'বেসরকারি চাকরি',
}

const TODAY = new Date()
TODAY.setHours(0, 0, 0, 0)

function daysUntil(date: string | null | undefined): number | null {
  if (!date) return null
  const target = new Date(date); target.setHours(0, 0, 0, 0)
  return Math.round((target.getTime() - TODAY.getTime()) / 86_400_000)
}

function urgencyLabel(days: number | null): { text: string; urgent: boolean } | null {
  if (days === null) return null
  if (days < 0) return { text: 'শেষ', urgent: false }
  if (days === 0) return { text: 'আজ', urgent: true }
  if (days === 1) return { text: 'আগামীকাল', urgent: true }
  return { text: `${toBnDigits(days)} দিন বাকি`, urgent: days <= 7 }
}

function formatDate(date: string | null | undefined): string {
  if (!date) return ''
  return new Date(date).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' })
}

const jsonLd = circulars.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'বিজ্ঞপ্তির তালিকা',
  itemListElement: circulars.slice(0, 10).map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.title, url: c.applyUrl ?? undefined,
  })),
} : undefined
---

<Layout title="বিজ্ঞপ্তির তালিকা" description="শিক্ষা ও চাকরির বিজ্ঞপ্তি — আবেদনের শেষ তারিখসহ।"
  settings={settings} categories={categories} footerPages={footerPages} jsonLd={jsonLd}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'বিজ্ঞপ্তি', href: '/circulars' }]} />
    <header class="mb-6 border-b-2 border-brand-red pb-3">
      <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">বিজ্ঞপ্তির তালিকা</h1>
      <p class="mt-2 text-base text-ink-muted dark:text-dark-ink-muted">শিক্ষা, বিসিএস ও সরকারি চাকরির বিজ্ঞপ্তি — শেষ তারিখ অনুযায়ী সাজানো।</p>
    </header>
    {circulars.length === 0 ? (
      <p class="rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">এখনো কোনো বিজ্ঞপ্তি যোগ করা হয়নি।</p>
    ) : (
      <ul class="flex flex-col gap-3">
        {circulars.map((c) => {
          const days = daysUntil(c.deadline)
          const urgency = urgencyLabel(days)
          const typeLabel = c.type ? TYPE_LABELS[c.type] ?? c.type : null
          return (
            <li class="rounded-lg border border-rule bg-surface p-4 dark:border-dark-rule dark:bg-dark-surface">
              <div class="flex flex-wrap items-center gap-2">
                {typeLabel && <span class="rounded bg-brand-red/10 px-2 py-0.5 text-xs font-semibold text-brand-red dark:bg-brand-red/20">{typeLabel}</span>}
                {urgency && <span class:list={['text-xs font-semibold', urgency.urgent ? 'text-brand-red' : 'text-ink-subtle dark:text-dark-ink-muted']}>{urgency.text}</span>}
              </div>
              <h2 class="font-headline mt-2 text-lg font-bold text-ink dark:text-dark-ink">{c.title}</h2>
              <p class="mt-1 text-sm text-ink-muted dark:text-dark-ink-muted">{c.organisation}</p>
              <div class="mt-2 flex flex-wrap gap-3 text-xs text-ink-subtle dark:text-dark-ink-muted">
                {c.vacancyCount && <span>পদসংখ্যা: {toBnDigits(c.vacancyCount)}</span>}
                {c.publishedDate && <span>প্রকাশ: {formatDate(c.publishedDate)}</span>}
              </div>
              <div class="mt-3 flex items-center gap-3">
                {c.deadline && <time class="text-xs text-ink-subtle dark:text-dark-ink-muted">শেষ তারিখ: {formatDate(c.deadline)}</time>}
                {c.applyUrl && <a href={c.applyUrl} rel="noopener noreferrer nofollow" class="text-sm font-semibold text-brand-red hover:underline">আবেদন করুন →</a>}
              </div>
            </li>
          )
        })}
      </ul>
    )}
  </div>
</Layout>
