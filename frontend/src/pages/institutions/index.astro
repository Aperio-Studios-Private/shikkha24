---
/**
 * Institution directory hub — N4.
 *
 * Starter set: public universities + top private, marked "growing"
 * (`docs/education-feature-inventory.md` §4).
 */
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { getInstitutions, type CmsInstitution } from '../../lib/education'
import { getSiteSettings, getCategories, getFooterPages, FALLBACK_SETTINGS, FALLBACK_CATEGORIES } from '../../lib/cms'

const [settings, categories, footerPages, institutions] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
  getFooterPages().catch(() => []),
  getInstitutions().catch(() => []),
])

const TYPE_LABELS: Record<string, string> = {
  public: 'সরকারি', private: 'বেসরকারি', madrasa: 'মাদ্রাসা', college: 'কলেজ',
}

function districtName(i: CmsInstitution): string | null {
  if (typeof i.district === 'object' && i.district) return i.district.nameBn ?? null
  return null
}

const jsonLd = institutions.length > 0 ? {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'শিক্ষা প্রতিষ্ঠানের তালিকা',
  itemListElement: institutions.slice(0, 20).map((i, idx) => ({
    '@type': 'ListItem', position: idx + 1, name: i.nameBn, url: `/institutions/${i.slug}`,
  })),
} : undefined
---

<Layout title="শিক্ষা প্রতিষ্ঠান" description="বিশ্ববিদ্যালয় ও কলেজের তালিকা — প্রাথমিক সেট দিয়ে শুরু, ক্রমে বাড়ছে।"
  settings={settings} categories={categories} footerPages={footerPages} jsonLd={jsonLd}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'প্রতিষ্ঠান', href: '/institutions' }]} />
    <header class="mb-6 border-b-2 border-brand-red pb-3">
      <h1 class="font-headline text-2xl font-bold text-ink sm:text-3xl dark:text-dark-ink">শিক্ষা প্রতিষ্ঠান</h1>
      <p class="mt-2 text-base text-ink-muted dark:text-dark-ink-muted">বিশ্ববিদ্যালয় ও কলেজের তালিকা — ক্রমে বাড়ছে।</p>
    </header>
    {institutions.length === 0 ? (
      <p class="rounded-md border border-rule bg-surface-raised p-6 text-center text-ink-muted dark:border-dark-rule dark:bg-dark-raised dark:text-dark-ink-muted">এখনো কোনো প্রতিষ্ঠান যোগ করা হয়নি।</p>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {institutions.map((i) => {
          const typeLabel = i.type ? TYPE_LABELS[i.type] ?? i.type : null
          const dist = districtName(i)
          return (
            <li>
              <a href={`/institutions/${i.slug}`} class="block rounded-lg border border-rule bg-surface p-4 transition hover:border-brand-red/40 dark:border-dark-rule dark:bg-dark-surface dark:hover:border-brand-red/60">
                <div class="flex items-center gap-2">
                  {typeLabel && <span class="rounded bg-brand-red/10 px-2 py-0.5 text-xs font-semibold text-brand-red dark:bg-brand-red/20">{typeLabel}</span>}
                  {i.isVerified && <span class="text-xs text-green-600 dark:text-green-400">✓ যাচাইকৃত</span>}
                </div>
                <h2 class="font-headline mt-2 text-lg font-bold text-ink dark:text-dark-ink">{i.nameBn}</h2>
                {i.nameEn && <p class="text-sm text-ink-muted dark:text-dark-ink-muted">{i.nameEn}</p>}
                <div class="mt-2 flex flex-wrap gap-3 text-xs text-ink-subtle dark:text-dark-ink-muted">
                  {dist && <span>জেলা: {dist}</span>}
                  {i.established && <span>প্রতিষ্ঠা: {i.established}</span>}
                </div>
              </a>
            </li>
          )
        })}
      </ul>
    )}
  </div>
</Layout>
