---
/**
 * Legacy article URL redirect — `/article/:slug` → `/:category/:id/:slug`.
 *
 * The old URL scheme was `/article/:slug`. The new scheme (S11,
 * `docs/seo-plan.md` §2) is `/:category/:id/:slug`, where the `:id` is the
 * stable part. This page resolves the slug to the new URL and 301-redirects
 * so old links (from WhatsApp, Facebook, Google's index) don't break.
 *
 * `docs/seo-plan.md` §9: "Never change a published URL." The redirect is
 * the safety net for the URLs that were already published under the old
 * scheme before S11.
 *
 * On a static site (DianaHost `public_html`) the 301 is baked at build time —
 * each old URL generates a tiny HTML page with a `<meta http-equiv="refresh">`
 * and a `<link rel="canonical">`. Apache also honours the redirect.
 */
import { getAllArticlePaths } from '../../lib/cms'
import { articleUrl } from '../../lib/url'
import Layout from '../../layouts/Layout.astro'
import { getSiteSettings, getCategories, FALLBACK_SETTINGS, FALLBACK_CATEGORIES } from '../../lib/cms'

export async function getStaticPaths() {
  const paths = await getAllArticlePaths().catch(() => [])
  return paths.map((p) => ({
    params: { slug: p.slug },
    props: {
      newUrl: p.categorySlug
        ? articleUrl({ id: p.id, slug: p.slug, category: { slug: p.categorySlug } })
        : `/article/${p.slug}`,
    },
  }))
}

const { newUrl } = Astro.props
const [settings, categories] = await Promise.all([
  getSiteSettings().catch(() => FALLBACK_SETTINGS),
  getCategories().catch(() => FALLBACK_CATEGORIES),
])
const canonical = new URL(newUrl, Astro.site ?? Astro.url).href
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${canonical}`} />
    <title>পুনর্নির্দেশ — {settings.siteName}</title>
  </head>
  <body>
    <h1 style="font-family: sans-serif; font-size: 1.5rem; font-weight: 700; text-align: center; margin: 0; padding: 2rem 2rem 0;">
      {settings.siteName}
    </h1>
    <p style="font-family: sans-serif; text-align: center; padding: 2rem;">
      স্বয়ংক্রিয়ভাবে নতুন ঠিকানায় নিয়ে যাওয়া হচ্ছে।{' '}
      <a href={canonical}>এগিয়ে যান</a>
    </p>
  </body>
</html>
