---
/**
 * Homepage (S3).
 *
 * Structure, top to bottom:
 *   1. Breaking ticker      — only when something is flagged breaking
 *   2. Filter bar           — level × district, applied across every section
 *   3. Lead story           — the editor's lead, else the newest
 *   4. Latest + Trending    — two columns; recency vs popularity
 *   5. Deadline strip       — N1 + N2, soonest first
 *   6. Category sections    — the 8 approved education categories
 *
 * ## Content comes from the CMS at build time
 *
 * Nothing here fetches in the reader's browser. If the CMS is unreachable the
 * helpers in `lib/cms.ts` return empty lists and the page still builds — sections
 * with no articles are omitted rather than filled with invented content, because
 * a news site that fabricates headlines during an outage is worse than one that
 * shows less.
 *
 * ## A note on "trending"
 *
 * Real trending needs view counts, which a static site cannot accumulate (no
 * server in the request path). The trending list is currently fed the most
 * recent articles and is documented as provisional — see TrendingList.astro.
 */
import Layout from '../layouts/Layout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import BreakingTicker from '../components/BreakingTicker.astro'
import DeadlineStrip from '../components/DeadlineStrip.astro'
import FilterBar from '../components/FilterBar.astro'
import CategorySection from '../components/CategorySection.astro'
import LatestFeed from '../components/LatestFeed.astro'
import TrendingList from '../components/TrendingList.astro'
import AdSlot from '../components/AdSlot.astro'
import InteractiveStrip from '../components/InteractiveStrip.astro'
import PollWidget from '../components/PollWidget.astro'
import CategoryImage from '../components/CategoryImage.astro'
import { getCategoryImage } from '../lib/images'
import { resolveCmsImage } from '../lib/media'
import { getActivePoll, getLiveBlogs, getPublicCmsOrigin, getQuizzes } from '../lib/interactive'
import { isEnabled } from '../lib/feature-flags'
import { articleUrl } from '../lib/url'
import { socialLinks } from '../lib/social'
import {
  getSiteSettings,
  getCategories,
  getFooterPages,
  getArticles,
  getBreakingNews,
  getDeadlines,
  getLevels,
  getDistricts,
  FALLBACK_SETTINGS,
  FALLBACK_CATEGORIES,
  FALLBACK_LEVELS,
} from '../lib/cms'

const [settings, categories, footerPages, breakingRaw, deadlines, levels, districts, latest] =
  await Promise.all([
    getSiteSettings().catch(() => FALLBACK_SETTINGS),
    getCategories().catch(() => FALLBACK_CATEGORIES),
    getFooterPages().catch(() => []),
    getBreakingNews().catch(() => []),
    getDeadlines().catch(() => []),
    getLevels().catch(() => FALLBACK_LEVELS),
    getDistricts().catch(() => []),
    getArticles({ limit: 14 }).catch(() => []),
  ])

/** One request per category, in parallel — 8 calls, once per build. */
const perCategory = await Promise.all(
  categories.map(async (category) => ({
    category,
    articles: await getArticles({ categorySlug: category.slug, limit: 5 }).catch(() => []),
  })),
)

/*
 * Interactive features (S8).
 *
 * Each is flag-gated *before* the fetch, so switching one off removes both the
 * request and the link. That matters more than it looks: a homepage linking to a
 * page that was never built is a 404 the reader finds for you.
 */
const [liveBlogs, activePoll, quizzes] = await Promise.all([
  isEnabled('liveBlog') ? getLiveBlogs().catch(() => []) : Promise.resolve([]),
  isEnabled('poll') ? getActivePoll().catch(() => null) : Promise.resolve(null),
  isEnabled('quiz') ? getQuizzes().catch(() => []) : Promise.resolve([]),
])

const liveBlog = liveBlogs[0] ?? null
const latestQuiz = quizzes[0] ?? null

/** `null` when unconfigured — the poll then renders nothing at all. */
const cmsOrigin = getPublicCmsOrigin()

/*
 * Sponsored stories are kept out of the masthead and the breaking ticker.
 *
 * The label makes a paid placement honest, but it does not make it the day's most
 * important story — and the lead slot says exactly that. A paid piece in the
 * masthead would borrow the authority of the front page. Sponsored content still
 * appears in the category sections and in the latest feed, where it carries the
 * label and sits alongside editorial on equal terms.
 */
const breaking = breakingRaw.filter((article) => !article.isSponsored)
const editorial = latest.filter((article) => !article.isSponsored)

/*
 * Newspaper hierarchy — the masthead block reads top-to-bottom in descending
 * importance, the way a printed front page does:
 *   lead    one story, largest image and headline
 *   medium  2-3 stories, medium treatment
 *   small   the next few, headline only
 */
const masthead = editorial.slice(0, 9)
const lead = masthead[0] ?? null
const medium = masthead.slice(1, 4)
const small = masthead.slice(4, 9)

/**
 * The latest feed is the full list minus whatever the masthead already showed.
 *
 * Filtering by slug rather than slicing by index matters once a sponsored story
 * is dropped from the masthead: `latest.slice(1)` would then re-show the
 * promoted story as the first item of the latest feed, so the same headline
 * would appear twice on one page.
 */
const mastheadSlugs = new Set(masthead.map((article) => article.slug))
const remainingLatest = latest.filter((article) => !mastheadSlugs.has(article.slug))

/**
 * Site-level JSON-LD: Organization + WebSite + SearchAction.
 *
 * `docs/seo-plan.md` §4 calls for Organization (name, logo, sameAs,
 * contactPoint) and WebSite with a SearchAction — the latter is what makes
 * Google show a sitelinks search box. The search target points at `/search`
 * with a `q` parameter, which is exactly how the Pagefind search page works.
 *
 * `sameAs` is built from the CMS `social` map through `socialLinks()`, the same
 * helper the header and the footer render from — so the three genuinely cannot
 * drift. (This comment previously claimed that unity while all three built the
 * list independently, and this one used a bare `Object.values`, which meant a
 * stored `javascript:` URL was published as structured data.)
 */
const socialUrls = socialLinks(settings.social).map((link) => link.url)

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  alternateName: settings.siteNameEn ?? undefined,
  url: Astro.site?.href ?? Astro.url.origin,
  logo: settings.logo?.url ?? undefined,
  sameAs: socialUrls.length > 0 ? socialUrls : undefined,
  contactPoint: settings.contact?.email
    ? {
        '@type': 'ContactPoint',
        email: settings.contact.email,
        contactType: 'customer support',
        availableLanguage: ['Bengali'],
      }
    : undefined,
}

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.siteName,
  alternateName: settings.siteNameEn ?? undefined,
  url: Astro.site?.href ?? Astro.url.origin,
  inLanguage: 'bn-BD',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${Astro.site?.href ?? Astro.url.origin}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
}
---

<Layout
  title="হোম"
  description={settings.tagline || undefined}
  settings={settings}
  categories={categories}
  footerPages={footerPages}
  jsonLd={[orgJsonLd, siteJsonLd]}
>
  {/* 1 — Breaking ticker. Renders nothing when nothing is flagged. */}
  <BreakingTicker articles={breaking} />

  {/* 1b — Entry point for the interactive features. Renders nothing when there
          is no live blog and no quiz, so it can never advertise an empty page. */}
  <InteractiveStrip liveBlog={liveBlog} latestQuiz={latestQuiz} />

  {/* 2 — Filter bar sits above the sections it filters. */}
  <FilterBar levels={levels} districts={districts} />

  <div class="container-page pt-6 pb-2">
    {/* 3 — LEAD: the biggest story. Image height is capped so the headline
            and the picture are both visible without scrolling. */}
    {
      lead && (
        <section class="mb-6 border-b border-rule pb-6 dark:border-dark-rule">
          <div class="grid-12">
            <div class="col-span-4 sm:col-span-8 lg:col-span-8">
              <ArticleCard article={lead} variant="lead" />
            </div>

            {/* 4 — MEDIUM: 2-3 supporting stories beside the lead. */}
            <div class="col-span-4 mt-6 sm:col-span-8 lg:col-span-4 lg:mt-0">
              <ul class="flex flex-col gap-4">
                {medium.map((article) => (
                  <li>
                    <ArticleCard article={article} variant="compact" headingLevel={3} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    {/* 5 — SMALL: headline-only strip. */}
    {
      small.length > 0 && (
        <section class="mb-6 border-b border-rule pb-6 dark:border-dark-rule">
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3 lg:grid-cols-5">
            {small.map((article) => (
              <li>
                <a href={articleUrl(article)} class="group block no-underline">
                  <h3 class="font-headline line-clamp-3 text-sm font-medium text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red">
                    {article.title}
                  </h3>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* 6 — Leaderboard ad, reserved space so nothing shifts. */}
    <div class="mb-8 flex justify-center">
      <AdSlot position="homepageLeaderboard" width={728} height={90} />
    </div>
  </div>

  {/* 7 — Deadline strip (full-bleed, between blocks) */}
  <DeadlineStrip deadlines={deadlines} />

  <div class="container-page">
    <div class="grid-12">
      {/* 8 — Category sections, stacked vertically, each with a few stories. */}
      <div class="col-span-4 sm:col-span-8 lg:col-span-8">
        {perCategory.map(({ category, articles }) => (
          <CategorySection category={category} articles={articles} />
        ))}

        {/* 10 — Latest: two columns, scrollable, so the feed does not
                 grow the page without limit. */}
        {
          remainingLatest.length > 0 && (
            <section class="border-t border-rule py-6 dark:border-dark-rule">
              <div class="mb-3 border-b-2 border-brand-red pb-2">
                <h2 class="font-headline text-xl font-bold text-ink dark:text-dark-ink">
                  সর্বশেষ
                </h2>
              </div>

              <ul class="latest-scroll flex flex-col gap-2">
                {remainingLatest.map((article) => {
                  const thumb = resolveCmsImage(article.featuredImage, article.title)
                  const category = article.category && typeof article.category === 'object' ? article.category : null
                  const fallback = getCategoryImage(category?.slug)

                  return (
                    <li class="border-b border-rule py-2 dark:border-dark-rule">
                      <a href={articleUrl(article)} class="group flex gap-3 no-underline">
                        <div class="aspect-1 h-16 w-16 shrink-0 overflow-hidden rounded bg-surface-raised dark:bg-dark-raised">
                          {thumb ? (
                            <img
                              src={thumb.src}
                              srcset={thumb.srcset}
                              sizes="64px"
                              alt={thumb.alt}
                              width={thumb.width}
                              height={thumb.height}
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover"
                            />
                          ) : (
                            fallback && (
                              <CategoryImage
                                image={fallback}
                                alt={article.title}
                                sizes="64px"
                                widths={[64, 128]}
                                class="h-full w-full object-cover"
                              />
                            )
                          )}
                        </div>
                        <div class="flex min-w-0 flex-col">
                          <h3 class="font-headline line-clamp-2 text-sm font-medium text-ink transition-colors group-hover:text-brand-red dark:text-dark-ink dark:group-hover:text-brand-red">
                            {article.title}
                          </h3>
                          {article.publishedAt && (
                            <time
                              datetime={article.publishedAt}
                              class="mt-0.5 block text-xs text-ink-subtle dark:text-dark-ink-muted"
                            >
                              {new Date(article.publishedAt).toLocaleTimeString('bn-BD', {
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: false,
                              })}
                            </time>
                          )}
                        </div>
                      </a>
                    </li>
                  )
                })}
              </ul>
            </section>
          )
        }

        <div class="flex justify-center py-8">
          <AdSlot position="homepageFooter" width={728} height={90} />
        </div>
      </div>

      {/* 9 — Right rail: sticky ad cards. */}
      <aside class="col-span-4 mt-8 sm:col-span-8 lg:col-span-4 lg:mt-0">
        <div class="lg:sticky lg:top-4 flex flex-col gap-4 py-6">
          <AdSlot position="sidebarTop" width={300} height={250} />
          {activePoll && <PollWidget poll={activePoll} cmsOrigin={cmsOrigin} />}
          <TrendingList articles={remainingLatest} />
          <AdSlot position="sidebarSticky" width={300} height={250} />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /*
   * The latest feed caps its own height and scrolls internally. Without this a
   * long feed makes the homepage endlessly long, and the reader can never reach
   * the footer.
   */
  .latest-scroll {
    max-height: 28rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .latest-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .latest-scroll::-webkit-scrollbar-thumb {
    background: var(--color-rule);
    border-radius: 999px;
  }
</style>
