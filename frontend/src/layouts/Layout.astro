---
/**
 * Base layout for every page.
 *
 * Responsibilities:
 *   - HTML5 boilerplate, charset, viewport, language
 *   - SEO meta tags (title, description, OG, Twitter)
 *   - Theme + text-scale restoration inline script (before paint, no FOUC)
 *   - Font preloading for the two Bengali font families
 *   - Skip link, Header, main content slot, Footer, MobileShareBar
 *   - Structured data (JSON-LD) hook
 *
 * Why the inline script is FIRST in <head>:
 *   If `.dark` or `font-size` is applied after paint, the reader sees a flash
 *   of the wrong theme or size. Running before any CSS blocks paint prevents it.
 */
import '../styles/global.css'
import BreakingTicker from '../components/BreakingTicker.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileShareBar from '../components/MobileShareBar.astro'
import type { CmsArticle, CmsSiteSettings, CmsCategory, CmsPage } from '../lib/cms'
import { getBreakingNews } from '../lib/cms'
import { mediaUrl } from '../lib/media'

interface Props {
  /** Page title — appended after the site name. */
  title?: string
  /** Meta description. Falls back to the site tagline. */
  description?: string
  /** Canonical URL. */
  canonical?: string
  /** Open Graph image URL. */
  ogImage?: string
  /** Article publish date (ISO 8601). */
  publishDate?: string
  /** Article modified date (ISO 8601). */
  modifiedDate?: string
  /** JSON-LD structured data — a single object or an array of objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Disable the mobile share bar on this page. */
  hideShareBar?: boolean
  /**
   * Emit `<meta name="robots" content="noindex">`.
   *
   * Used by `/verify/not-found`, the sentinel that `.htaccess` serves for an
   * unknown reporter ID. That page answers **200** by design (a 404 is what the
   * rewrite exists to avoid), so without this it would be a soft-404 that a
   * crawler could index as real content.
   */
  noindex?: boolean
  /** Site settings (fetched at build time). */
  settings: CmsSiteSettings
  /** Navigation categories (fetched at build time). */
  categories: CmsCategory[]
  /** Footer pages (fetched at build time). */
  footerPages?: CmsPage[]
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage,
  publishDate,
  modifiedDate,
  jsonLd,
  hideShareBar = false,
  noindex = false,
  settings,
  categories,
  footerPages = [],
} = Astro.props

const siteName = settings.siteName
const pageTitle = title ? `${title} — ${siteName}` : siteName
const metaDescription = description || settings.tagline || ''
/**
 * `og:image` must be an ABSOLUTE URL.
 *
 * The Open Graph protocol requires it, and the scrapers at Facebook, X, WhatsApp
 * and LinkedIn do not resolve relative paths — a relative value is silently
 * ignored and the share renders with no preview image at all. This was emitting
 * `/og-default.png` verbatim, so every page shared without an image.
 *
 * Article pages pass a CMS media path, which is relative too, so the origin is
 * applied to the fallback and to any relative override. An already-absolute URL
 * (e.g. a media CDN host) is left untouched rather than double-prefixed.
 *
 * The fallback image is a PNG, not SVG — social platforms (Facebook, X,
 * WhatsApp, LinkedIn) do not support SVG for og:image and silently ignore it.
 * See audit §2.1.
 */
const siteOrigin = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, '')
// ⚠️ Cache-break the DEFAULT share image when its bytes change (T-59). The
// file URL is years old and every platform caches og:image by URL — swapping
// the file in place left Facebook/WhatsApp serving the old red plate for days.
// Bump OG_DEFAULT_VERSION whenever og-default.png is regenerated; custom
// per-page images keep their own (content-hashed) URLs and need no version.
const OG_DEFAULT_VERSION = '20261019'
const ogImagePath = ogImage || `/og-default.png?v=${OG_DEFAULT_VERSION}`
const ogImageUrl = /^https?:\/\//i.test(ogImagePath) ? ogImagePath : `${siteOrigin}${ogImagePath}`

/**
 * Browser-tab icon — uploaded in Site Settings, not hardcoded.
 *
 * `mediaUrl()` is what turns Payload's relative `/api/media/file/…` into a URL
 * the static host can serve. The raw value would 404 exactly like the publisher
 * logo did before it was fixed — the static host serves no `/api/`.
 *
 * `type` comes from the media record's own mime type rather than from the
 * filename extension, so a file whose name lies about its format is still
 * declared correctly. Both the type and the size are enforced in the CMS
 * (`SiteSettings.beforeValidate`), so anything reaching here is already allowed.
 *
 * ## Two things that made the favicon appear not to change
 *
 * 1. **Competing candidates.** This used to emit the managed icon *and* the two
 *    static ones in `public/`. A browser collects every `rel="icon"` and picks
 *    the "most appropriate" — with no `sizes` declared that choice is ambiguous,
 *    and it can land on a stale static file. The managed icon is now emitted
 *    **alone** when one is set; the static pair is the fallback for when none is,
 *    not an alternative to it.
 * 2. **Caching.** Browsers cache favicons far more stubbornly than other assets —
 *    Chrome keeps them in a store that ignores ordinary cache headers — so
 *    re-uploading under the same filename would keep showing the old icon
 *    indefinitely. The URL is therefore versioned by the media record's
 *    `updatedAt`, which is the only reliable way to force a refetch.
 */
const faviconBase = mediaUrl(settings.favicon?.url)
const faviconType = settings.favicon?.mimeType ?? undefined

const faviconStamp = settings.favicon?.updatedAt
  ? Date.parse(settings.favicon.updatedAt)
  : Number.NaN

const faviconUrl =
  faviconBase && Number.isFinite(faviconStamp)
    ? `${faviconBase}${faviconBase.includes('?') ? '&' : '?'}v=${faviconStamp}`
    : faviconBase

/**
 * Site-wide breaking ticker data (S2 chrome, amended 2026-10-17 by the owner:
 * the red row moved from the homepage template into this layout so it renders
 * on every page, directly under the navbar).
 *
 * Sponsored pieces stay out for the same reason the homepage excluded them —
 * a paid placement must not borrow the urgency framing of breaking news.
 * `getBreakingNews()` is served by the build's shared CMS response cache, so
 * all 44 pages cost one request, not one per page.
 */
const breakingArticles = (await getBreakingNews().catch(() => [])).filter(
  (article) => !article.isSponsored,
)
---

<!doctype html>
<html lang="bn" dir="ltr">
  <head>
    {/* ── Anti-FOUC: restore reader preferences before paint ───────────────
        An EXTERNAL blocking script, deliberately — not inline. The CSP is
        `script-src 'self'` with no `'unsafe-inline'`, so an inline script is
        blocked and the theme/text-scale preferences silently stop applying.
        A same-origin `<script src>` with no async/defer still runs before paint,
        so the anti-flash guarantee is kept and the CSP stays strict.
        The file is in `public/`, so Astro copies it verbatim — no bundling, no
        content hash, so this URL never changes. */}
    <script is:inline src="/theme-init.js"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={metaDescription} />

    {/* ── Fonts — preload both weights ─────────────────────────────────────
        SolaimanLipi 400 is the file every headline and paragraph needs, so it
        goes on the critical path to avoid a flash of invisible text. Each file
        already covers Bengali AND Latin, so one preload serves mixed headlines
        like "HSC ২০২৬".

        700 is preloaded too, reversing the earlier "far less text uses it"
        reasoning. On the article template that was wrong in the one place it
        mattered most: the H1 title is bold and is the largest text on the page,
        so its swap moved every element below it. Both weights are together
        154 KB against a 200 KB budget (`docs/performance-budget.md` §3), and both
        are requested by the first paint on any article, so preloading the second
        adds a parallel fetch rather than a new round trip.

        `SolaimanLipi Fallback` in `global.css` carries the metric overrides that
        keep the swap from reflowing if these arrive after first paint. */}
    <link rel="preload" href="/fonts/solaimanlipi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/solaimanlipi-700.woff2" as="font" type="font/woff2" crossorigin />

    {/* ── Icons ─────────────────────────────────────────────────────────────
        Exactly one source, never both. Emitting the managed icon alongside the
        static pair left three `rel="icon"` candidates with no `sizes` to
        disambiguate them, and the browser was free to pick a stale static file.
        See the note on `faviconUrl`. */}
    {
      faviconUrl ? (
        <>
          <link rel="icon" href={faviconUrl} type={faviconType} />
          <link rel="apple-touch-icon" href={faviconUrl} />
        </>
      ) : (
        <>
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link rel="icon" href="/favicon.ico" />
          <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        </>
      )
    }
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#da1c25" />
    <link rel="canonical" href={canonical} />

    {/* ── Open Graph ──────────────────────────────────────────────── */}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={publishDate ? 'article' : 'website'} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:image" content={ogImageUrl} />

    {/* ── Twitter ─────────────────────────────────────────────────── */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* ── Article meta ────────────────────────────────────────────── */}
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

    {/* ── JSON-LD ─────────────────────────────────────────────────── */}
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {/* ── Page-specific head content ──────────────────────────────────
        Lets a page add its own stylesheet or preload (e.g. the search page
        loading the Pagefind UI CSS) without the Layout knowing about it. */}
    <slot name="head" />

    <title>{pageTitle}</title>
  </head>

  <body class="min-h-screen">
    {/* Skip link — first focusable element, jumps to main content */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-red focus:px-4 focus:py-2 focus:text-white focus:shadow-lg"
    >
      মূল বিষয়বস্তুতে যান
    </a>

    <Header settings={settings} categories={categories} />

    {/* Breaking ticker — site chrome (S2). Renders nothing when nothing is
        flagged breaking; an empty red bar is noise. */}
    <BreakingTicker articles={breakingArticles} />

    <main id="main-content" class="min-h-[50vh]">
      <slot />
    </main>

    <Footer settings={settings} categories={categories} footerPages={footerPages} />

    {!hideShareBar && <MobileShareBar />}
  </body>
</html>
