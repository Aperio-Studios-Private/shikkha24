{
  "name": "shikkha24",
  "version": "0.0.0",
  "private": true,
  "description": "Shikkha24 (শিক্ষা২৪) — Bengali-first education news portal. Monorepo: Astro static frontend + Payload CMS 3.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "audit:ci": "pnpm audit --audit-level=high",
    "build": "pnpm run build:frontend && pnpm run build:cms",
    "build:cms": "pnpm --filter @shikkha24/cms build",
    "build:frontend": "pnpm --filter @shikkha24/frontend build",
    "check:host-fork": "node scripts/check-host-fork.mjs",
    "dev": "pnpm --filter @shikkha24/frontend dev",
    "dev:cms": "pnpm --filter @shikkha24/cms dev",
    "indexnow": "node scripts/indexnow.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "setup": "node scripts/setup-env.mjs",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:cms",
    "typecheck:cms": "pnpm --filter @shikkha24/cms typecheck",
    "typecheck:frontend": "pnpm --filter @shikkha24/frontend typecheck",
    "verify": "pnpm run lint && pnpm run verify:astro-imports && pnpm run verify:dark-tokens && pnpm run verify:site-name && pnpm run verify:bengali-spacing && pnpm run verify:prayer-times && pnpm run verify:gpa && pnpm run verify:cgpa && pnpm run verify:bookmarks && pnpm run verify:ad-split && pnpm run verify:client-ip && pnpm run verify:sqlite-wal && pnpm run verify:cms-bundle && pnpm run verify:origins && pnpm run verify:pnpm-fallback && pnpm run verify:host-extract && pnpm run typecheck && pnpm run build && pnpm run verify:build-output && pnpm run verify:links && pnpm run verify:search-init && pnpm run verify:apache && pnpm run verify:cloudflare && pnpm run verify:cpanel-deploy && pnpm run verify:deploy-mode && pnpm run verify:deploy-inputs && pnpm run verify:backup",
    "verify:ad-split": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-ad-split.ts",
    "verify:apache": "node scripts/verify-apache.mjs",
    "verify:archive-buckets": "node scripts/verify-archive-buckets.mjs",
    "verify:astro-imports": "node scripts/verify-astro-imports.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:bengali-spacing": "node scripts/verify-bengali-spacing.mjs",
    "verify:bookmarks": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-bookmark-merge.mjs",
    "verify:build-output": "node scripts/verify-build-output.mjs",
    "verify:touch-targets": "node scripts/verify-touch-targets.mjs",
    "verify:cgpa": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-cgpa.mjs",
    "verify:client-ip": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-client-ip.mjs",
    "verify:cloudflare": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-cloudflare.mjs",
    "verify:cms-bundle": "node scripts/verify-cms-bundle-sanitize.mjs",
    "verify:cpanel-deploy": "node scripts/verify-cpanel-deploy.mjs",
    "verify:dark-tokens": "node scripts/verify-dark-tokens.mjs",
    "verify:deploy-inputs": "node scripts/verify-deploy-inputs.mjs",
    "verify:deploy-mode": "node scripts/verify-deploy-mode.mjs",
    "verify:endpoints": "pnpm --filter @shikkha24/cms verify:endpoints",
    "verify:gpa": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-gpa.mjs",
    "verify:host-extract": "node scripts/verify-host-extract.mjs",
    "verify:lighthouse": "bash scripts/verify-lighthouse.sh",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:origins": "pnpm --filter @shikkha24/cms verify:origins",
    "verify:payload-importmap": "bash scripts/verify-payload-importmap.sh",
    "verify:payload-migrations": "bash scripts/verify-payload-migrations.sh",
    "verify:payload-types": "bash scripts/verify-payload-types.sh",
    "verify:pnpm-fallback": "node scripts/verify-pnpm-fallback.mjs",
    "verify:prayer-times": "node scripts/verify-prayer-times.mjs",
    "verify:reporter": "pnpm --filter @shikkha24/cms verify:reporter",
    "verify:search-init": "node scripts/verify-search-init.mjs",
    "verify:site-name": "node scripts/verify-site-name.mjs",
    "verify:sqlite-wal": "node scripts/verify-sqlite-wal.mjs",
    "verify:sync": "node scripts/verify-cms-sync.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "linkedom": "0.18.13",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}
