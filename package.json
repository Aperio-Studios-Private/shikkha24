{
  "name": "shikkha24",
  "version": "0.0.0",
  "private": true,
  "description": "Shikkha24 (শিক্ষা২৪) — Bengali-first education news portal. Monorepo: Astro static frontend + Payload CMS 3.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "pnpm --filter @shikkha24/frontend dev",
    "dev:cms": "pnpm --filter @shikkha24/cms dev",
    "build": "pnpm run build:frontend && pnpm run build:cms",
    "build:frontend": "pnpm --filter @shikkha24/frontend build",
    "build:cms": "pnpm --filter @shikkha24/cms build",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:cms",
    "typecheck:frontend": "pnpm --filter @shikkha24/frontend typecheck",
    "typecheck:cms": "pnpm --filter @shikkha24/cms typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify:csp": "node scripts/verify-csp-routes.mjs",
    "verify:build-output": "node scripts/verify-build-output.mjs",
    "verify:sync": "node scripts/verify-cms-sync.mjs",
    "verify:endpoints": "pnpm --filter @shikkha24/cms verify:endpoints",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run verify:csp && pnpm run verify:build-output",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  }
}
