# ─────────────────────────────────────────────────────────────────────────────
# Shikkha24 CMS — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`
# (agent rule 11; `.gitignore` covers `.env` and `.env.*`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Payload ──────────────────────────────────────────────────────────────────
# Long random string used to sign auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ── Database (SQLite / libSQL) ───────────────────────────────────────────────
# The database file MUST live outside the web root (docs/security.md §2).
# `cms/data/` is git-ignored — it holds the entire editorial archive.
DATABASE_URI=file:./data/payload.db

# Optional: only for a hosted libSQL/Turso database (not used at launch)
# DATABASE_AUTH_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# ── Cloudflare R2 (media origin) ─────────────────────────────────────────────
# 10 GB free tier, zero egress. A payment method is on file, so overage is
# billable — an 80% usage alert is required (docs/hosting-and-deployment.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shikkha24-media
R2_PUBLIC_BASE_URL=

# ── Deploy (CI → DianaHost) ──────────────────────────────────────────────────
DIANAHOST_SSH_HOST=
DIANAHOST_SSH_USER=
DIANAHOST_SSH_KEY=
DIANAHOST_APP_PATH=

# ── Feature flags (docs/reliability.md §5) ───────────────────────────────────
# Runtime flags — a change needs a process restart, not a rebuild. Every flag is
# ON unless the value is exactly "false", so an unset variable never silently
# disables a feature. Flags gate rendering, never authorisation.
FLAG_COMMENTS=false
FLAG_LIVE_BLOG=false
FLAG_QUIZ=false
FLAG_NEWSLETTER=false
