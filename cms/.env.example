# ─────────────────────────────────────────────────────────────────────────────
# Shikkha24 CMS — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`
# (agent rule 11; `.gitignore` covers `.env` and `.env.*`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Payload ──────────────────────────────────────────────────────────────────
# Long random string used to sign auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also the salt for the poll-vote duplicate guard and the newsletter tokens.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ── Database (SQLite / libSQL) ───────────────────────────────────────────────
# The database file MUST live outside the web root (docs/security.md §2).
# `cms/data/` is git-ignored — it holds the entire editorial archive.
DATABASE_URI=file:./data/payload.db

# Optional: only for a hosted libSQL/Turso database (not used at launch)
# DATABASE_AUTH_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# ── Media storage — DianaHost disk, NOT R2 ───────────────────────────────────
# ⚠️ The owner moved media off Cloudflare R2 on 2026-09-12 (`.sps/plan.md`
# §"Scope amendment (2026-09-12)"). Uploads now live on the host disk, inside the
# 2 GB plan shared with the app, the database and the backups.
#
# The arithmetic that makes this the binding constraint: at 15–20 articles/day
# with 2–3 optimised images each, media grows 150–270 MB/month — 7–13 months to
# full on the 2 GB plan, 18–33 months on 5 GB.
#
# Two mitigations are therefore MANDATORY, not optional, and both are enforced in
# `src/collections/Media.ts` rather than left to discipline:
#   1. every upload is converted to WebP/AVIF and the original is discarded
#   2. a per-day upload cap, so one burst day cannot consume the month's headroom
MEDIA_UPLOAD_DIR=./data/media

# Maximum bytes of NEW media one day may accept. Default 250 MB — roughly one
# day of the approved velocity, so a single runaway day cannot take a week.
# Set to 0 to disable the cap (not recommended).
MEDIA_DAILY_UPLOAD_CAP_BYTES=262144000

# Public base URL for media, as a browser reaches it. Must match the frontend's
# `PUBLIC_MEDIA_BASE_URL`. Serve it through the Cloudflare proxy with a
# long-lived Cache-Control so cached views never touch the host's bandwidth.
MEDIA_PUBLIC_BASE_URL=https://cms.shikkha24.com

# ── Newsletter transport — cPanel SMTP (owner-accepted 2026-09-12) ───────────
# The low-volume cPanel SMTP fallback is the accepted transport; there is no ESP
# account. The module is transport-agnostic — the subscriber list, double opt-in
# and campaign composer know nothing about SMTP — so swapping in an ESP later is
# a configuration change, not a rewrite.
#
# ⚠️ Risks accepted, not eliminated (docs/security.md §7):
#   • cPanel enforces per-domain hourly send caps — an over-long campaign would
#     be silently truncated, so NEWSLETTER_MAX_SENDS_PER_HOUR is enforced in code
#   • bulk sending from a shared IP risks blacklisting the domain, which would
#     also break password resets and contact forms
#   • no delivery reporting, no bounce handling, no unsubscribe automation
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=শিক্ষা২৪
SMTP_FROM_EMAIL=

# Hard ceiling on campaign sends per rolling hour. Default 100 — deliberately far
# below a typical cPanel cap, because tripping the host's limit would truncate a
# campaign silently and damage the domain's sending reputation.
NEWSLETTER_MAX_SENDS_PER_HOUR=100

# Public site origin, used to build the confirmation and unsubscribe links.
NEWSLETTER_SITE_URL=https://shikkha24.com

# ── Web Push (S9) ────────────────────────────────────────────────────────────
# Self-generated VAPID key pair — free, no account, no card. Generate once with:
#   npx web-push generate-vapid-keys
# The public key must be mirrored into the frontend's PUBLIC_VAPID_PUBLIC_KEY.
# The private key is a secret and never leaves this file.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can use to reach the operator.
VAPID_SUBJECT=mailto:admin@shikkha24.com

# ── Social login (S9) — Meta + Google OAuth ──────────────────────────────────
# Free: app review is a process, not a cost, so the no-card rule does not exclude
# them. Until a provider is configured here the corresponding button is not
# rendered at all and the browser-local fallback stays (the S8 rule: no control
# is shown which cannot work).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=

# ── Deploy (CI → DianaHost) ──────────────────────────────────────────────────
DIANAHOST_SSH_HOST=
DIANAHOST_SSH_USER=
DIANAHOST_SSH_KEY=
DIANAHOST_APP_PATH=

# ── Feature flags (docs/reliability.md §5) ───────────────────────────────────
# Runtime flags — a change needs a process restart, not a rebuild. Every flag is
# ON unless the value is exactly "false", so an unset variable never silently
# disables a feature. Flags gate rendering, never authorisation.
FLAG_COMMENTS=true
FLAG_LIVE_BLOG=true
FLAG_QUIZ=true
FLAG_NEWSLETTER=true
FLAG_PUSH=true
FLAG_CITIZEN=true
