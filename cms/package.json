{
  "name": "@shikkha24/cms",
  "version": "0.0.0",
  "private": true,
  "description": "Shikkha24 CMS — Payload CMS 3 on Next.js. Runs on DianaHost (Node 20.18.2, EOL) from a CI-built standalone bundle.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/demo-run.ts",
    "seed:demo:purge": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/demo-purge.ts",
    "verify:media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/media.ts",
    "verify:endpoints": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/endpoints.ts",
    "verify:newsletter": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/newsletter.ts",
    "verify:engagement": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/engagement.ts",
    "verify:push": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/push.ts",
    "verify:oauth": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/oauth.ts",
    "verify:rebuild": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/rebuild-trigger.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/email-nodemailer": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.14.2",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  }
}
