{
  "name": "@shikkha24/cms",
  "version": "0.0.0",
  "private": true,
  "description": "Shikkha24 CMS — Payload CMS 3 on Next.js. Runs on DianaHost (Node 20.18.2, EOL) from a CI-built standalone bundle.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/demo-run.ts",
    "seed:demo:purge": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/demo-purge.ts",
    "seed:universities": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/universities-run.ts",
    "verify:media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/media.ts",
    "verify:result-links": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/result-links.ts",
    "verify:public-read": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/public-read-filters.ts",
    "verify:access": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/access.ts",
    "verify:endpoints": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/endpoints.ts",
    "verify:newsletter": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/newsletter.ts",
    "verify:engagement": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/engagement.ts",
    "verify:push": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/push.ts",
    "verify:oauth": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/oauth.ts",
    "verify:rebuild": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/rebuild-trigger.ts",
    "verify:reporter": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/reporter.ts",
    "verify:reporter-access": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/reporter-access.ts",
    "verify:id-card": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/id-card.ts",
    "verify:reactions": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/reactions.ts",
    "verify:social": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/social-url.ts",
    "verify:origins": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/origins.ts",
    "verify:rebuild-notice": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/rebuild-notice.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@swc/helpers": "0.5.23",
    "cross-env": "7.0.3",
    "dotenv": "18.0.7",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  }
}
