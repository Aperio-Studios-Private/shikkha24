# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# This project is pnpm-only (see pnpm-workspace.yaml). Two lockfiles would drift,
# and `pnpm-lock.yaml` is the one that is committed. Block npm artifacts so a
# stray `npm install` cannot reintroduce a second source of truth.
package-lock.json
yarn.lock
.pnpm-store/

# ─── Build output ────────────────────────────────────────────────────────────
# Astro (frontend)
dist/
.astro/
# Next.js / Payload (cms)
.next/
out/
build/
*.tsbuildinfo

# ─── Environment & secrets — never commit real keys (agent rule 11) ──────────
.env
.env.*
!.env.example

# ─── Database — the SQLite archive must never be committed ───────────────────
# (docs/backup-and-recovery.md — the whole editorial archive lives in this file)
*.db
*.db-journal
*.db-wal
*.db-shm
cms/data/
cms/media/

# ─── Stale tooling caches ────────────────────────────────────────────────────
# `.wrangler/` is left over from the Cloudflare era (all Cloudflare services were
# removed 2026-09-14). Nothing depends on it, but a stale cache can still exist in
# a working tree that predates the removal — and **Biome scans anything not
# ignored**, so an un-ignored `.wrangler/` fails the lint gate on a file nobody
# wrote. Keep this entry until the directory is confirmed gone from every clone.
.wrangler/

# ─── Test / coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Harness scratch files ───────────────────────────────────────────────────
# This environment's file broker writes zero-byte `_tmp_<pid>_<hash>` files into
# the repository root during long operations. They are never project data, but
# one was swept into a commit by `git add -A` (added in `01f84e1`, unnoticed for
# three days) — and a stray file in the root is exactly what a launch check
# mistakes for real content. Keep the pattern out of the index.
_tmp_*

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json



.claude

# ─── Lighthouse CI (F-16) ─────────────────────────────────────────────────────
# `lhci autorun` writes one ~1.2 MB JSON report per run (3 runs x 3 templates),
# plus the aggregated reports. They are measurement output, not source: committing
# them would add megabytes of churn to every build that moved a score by 0.1.
.lighthouseci/
.lighthouseci-report/
.lhci-tmp/


# AI cover working files (official copies go to CMS Media)
editorial/assets-batch-1/
.neon
