# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# This project is pnpm-only (see pnpm-workspace.yaml). Two lockfiles would drift,
# and `pnpm-lock.yaml` is the one that is committed. Block npm artifacts so a
# stray `npm install` cannot reintroduce a second source of truth.
package-lock.json
yarn.lock
.pnpm-store/

# ─── Build output ────────────────────────────────────────────────────────────
# Astro (frontend)
dist/
.astro/
# Next.js / Payload (cms)
.next/
out/
build/
*.tsbuildinfo

# ─── Environment & secrets — never commit real keys (agent rule 11) ──────────
.env
.env.*
!.env.example

# ─── Database — the SQLite archive must never be committed ───────────────────
# (docs/backup-and-recovery.md — the whole editorial archive lives in this file)
*.db
*.db-journal
*.db-wal
*.db-shm
cms/data/
cms/media/

# ─── Cloudflare / Wrangler ───────────────────────────────────────────────────
.wrangler/

# ─── Test / coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
