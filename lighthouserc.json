{
  "ci": {
    "collect": {
      "staticDistDir": "./frontend/dist",
      "url": [
        "http://localhost/",
        "http://localhost/latest/",
        "http://localhost/education-news/20/demo-madrasa-new-syllabus/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75
        },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 1258291
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
